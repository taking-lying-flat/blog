%22%2C%22x%22%3A1360%2C%22y%22%3A554%2C%22width%22%3A121%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%221------I%22%2C%22x%22%3A969%2C%22y%22%3A408%2C%22width%22%3A184%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22R%E4%B8%80%22%2C%22x%22%3A1280%2C%22y%22%3A358%2C%22width%22%3A60%2C%22height%22%3A33%7D%2C%7B%22text%22%3A%22DATASET%22%2C%22x%22%3A52%2C%22y%22%3A158%2C%22width%22%3A70%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22ACTOR%22%2C%22x%22%3A1041%2C%22y%22%3A490%2C%22width%22%3A70%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22RETRAINING%22%2C%22x%22%3A51%2C%22y%22%3A137%2C%22width%22%3A70%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22RUCTION%22%2C%22x%22%3A1278%2C%22y%22%3A44%2C%22width%22%3A46%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22%E4%B8%80%E4%B8%80%E4%B8%80%22%2C%22x%22%3A1171%2C%22y%22%3A253%2C%22width%22%3A92%2C%22height%22%3A12%7D%2C%7B%22text%22%3A%22OGITS%22%2C%22x%22%3A1259%2C%22y%22%3A89%2C%22width%22%3A47%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22AMPLING%22%2C%22x%22%3A1042%2C%22y%22%3A312%2C%22width%22%3A68%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22CRITIC%22%2C%22x%22%3A1280%2C%22y%22%3A301%2C%22width%22%3A58%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22RM%22%2C%22x%22%3A76%2C%22y%22%3A518%2C%22width%22%3A54%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22%E4%B8%80LVALUE%22%2C%22x%22%3A1417%2C%22y%22%3A369%2C%22width%22%3A124%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22STAGE1%3A%22%2C%22x%22%3A941%2C%22y%22%3A68%2C%22width%22%3A63%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22%E5%BF%83%22%2C%22x%22%3A382%2C%22y%22%3A160%2C%22width%22%3A207%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22%E5%A4%A9%22%2C%22x%22%3A1199%2C%22y%22%3A151%2C%22width%22%3A39%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22CE%22%2C%22x%22%3A691%2C%22y%22%3A88%2C%22width%22%3A46%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22STAGE3TRAININGFRAMWORK%22%2C%22x%22%3A1353%2C%22y%22%3A151%2C%22width%22%3A223%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22KL%22%2C%22x%22%3A484%2C%22y%22%3A514%2C%22width%22%3A57%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22R%22%2C%22x%22%3A951%2C%22y%22%3A372%2C%22width%22%3A37%2C%22height%22%3A32%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ececec%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22u85bd475c%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><p data-lake-id="ua1a8d67b" id="ua1a8d67b"><strong><span data-lake-id="u91e290dc" id="u91e290dc" style="color: #004347">PPO 和 TRPO 是强化学习中的两项关键技术，旨在不损害稳定性的前提下有效训练策略。这些方法背后的直觉是采用小而稳定的步长：以温和的方式推动策略优化，避免激进更新破坏整体学习过程的稳定性</span></strong></p><ul list="u083a0f7d"><li fid="u7bbbb2cf" data-lake-id="ue6c6008a" id="ue6c6008a"><span data-lake-id="u9142da60" id="u9142da60">在传统强化学习中，策略梯度的原理要求新旧策略在参数空间中保持接近。然而，参数空间中的接近并不必然意味着性能相近，参数的微小变化也可能显著影响策略的有效性。此外，如果采用较大且不受约束的更新步长，策略性能可能发生崩溃，这一固有风险限制原始策略梯度方法的样本效率。</span></li><li fid="u7bbbb2cf" data-lake-id="ue05b045c" id="ue05b045c"><span data-lake-id="u6ba73ff7" id="u6ba73ff7">TRPO 不再局限于参数之间的接近程度，而是对策略更新引入另一种约束。它通过确保 KL 散度处于可接受的范围内，控制策略的变化</span></li></ul><p data-lake-id="u70792e21" id="u70792e21" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cunderset%7B%5C%5Ctheta%7D%7B%5C%5Coperatorname%7Bmaximize%7D%7D%5C%5C%3B%5C%5Chat%7B%5C%5Cmathbb%7BE%7D%7D_t%5C%5Cleft%5B%5C%5Cfrac%7B%5C%5Cpi_%7B%5C%5Ctheta%7D(a_t%5C%5Cmid%20s_t)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(a_t%5C%5Cmid%20s_t)%7D%5C%5Chat%7BA%7D_t%5C%5Cright%5D%2C%5C%5Cquad%20%5C%5Ctext%7Bsubject%20to%7D%5C%5Cquad%20%5C%5Chat%7B%5C%5Cmathbb%7BE%7D%7D_t%5C%5Cleft%5B%5C%5Coperatorname%7BKL%7D%5C%5Cleft(%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(%5C%5Ccdot%5C%5Cmid%20s_t)%2C%5C%5Cpi_%7B%5C%5Ctheta%7D(%5C%5Ccdot%5C%5Cmid%20s_t)%5C%5Cright)%5C%5Cright%5D%5C%5Cleq%5C%5Cdelta.%20%5C%5Ctag%7B13%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F580f90d20989de31857aa9cd05c260e1.svg%22%2C%22id%22%3A%22KXZgQ%22%7D"></card></p><ul list="ud230d542"><li fid="u4f2bd54e" data-lake-id="uade732b6" id="uade732b6"><span data-lake-id="u017df4c3" id="u017df4c3">PPO 主要有两种变体：PPO-Penalty 和 PPO-Clip。TRPO 对 KL 散度施加硬约束，以防止有害更新；PPO-Penalty 则采用基于惩罚的方法替代约束，将其作为无约束优化问题处理：</span></li></ul><p data-lake-id="ue72607d1" id="ue72607d1" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Ctext%7Bppo-penalty%7D%7D(%5C%5Ctheta)%3D%5C%5Chat%7B%5C%5Cmathbb%7BE%7D%7D_t%5C%5Cleft%5B%5C%5Cfrac%7B%5C%5Cpi_%7B%5C%5Ctheta%7D(a_t%5C%5Cmid%20s_t)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(a_t%5C%5Cmid%20s_t)%7D%5C%5Chat%7BA%7D_t%5C%5Cright%5D-%5C%5Cbeta%5C%5Coperatorname%7BKL%7D%5C%5Cleft(%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(%5C%5Ccdot%5C%5Cmid%20s_t)%2C%5C%5Cpi_%7B%5C%5Ctheta%7D(%5C%5Ccdot%5C%5Cmid%20s_t)%5C%5Cright).%20%5C%5Ctag%7B14%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F3ed5cc3b5b4756828fb5ad23554ed1cc.svg%22%2C%22id%22%3A%22dKR5u%22%7D"></card></p><p data-lake-id="ua8a07d3f" id="ua8a07d3f"><strong><span data-lake-id="u6fbca927" id="u6fbca927">裁剪代理目标：PPO-Clip 尝试使新策略保持接近旧策略，但它不像 TRPO 那样对 KL 散度施加约束，而是在目标函数中使用经过裁剪的策略概率比。其目标函数表示为</span></strong></p><p data-lake-id="ubfa1f261" id="ubfa1f261" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Ctext%7Bppo-clip%7D%7D(%5C%5Ctheta)%3D%5C%5Chat%7B%5C%5Cmathbb%7BE%7D%7D_t%5C%5Cleft%5B%5C%5Cmin%5C%5Cleft(%5C%5Cfrac%7B%5C%5Cpi_%7B%5C%5Ctheta%7D(a_t%5C%5Cmid%20s_t)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(a_t%5C%5Cmid%20s_t)%7D%5C%5Chat%7BA%7D_t%2C%5C%5Coperatorname%7Bclip%7D%5C%5Cleft(%5C%5Cfrac%7B%5C%5Cpi_%7B%5C%5Ctheta%7D(a_t%5C%5Cmid%20s_t)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(a_t%5C%5Cmid%20s_t)%7D%2C1-%5C%5Cepsilon%2C1%2B%5C%5Cepsilon%5C%5Cright)%5C%5Chat%7BA%7D_t%5C%5Cright)%5C%5Cright%5D.%20%5C%5Ctag%7B15%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fa6e4c3bce80fcf553b0681079c507ec5.svg%22%2C%22id%22%3A%22m9aaO%22%7D"></card></p><ul list="uadcd82fc"><li fid="ue1f4e894" data-lake-id="u4dafc5f4" id="u4dafc5f4"><span data-lake-id="u271a8010" id="u271a8010">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cfrac%7B%5C%5Cpi_%7B%5C%5Ctheta%7D(a_t%5C%5Cmid%20s_t)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(a_t%5C%5Cmid%20s_t)%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F736a3595f567792daebab29e428898dc.svg%22%2C%22id%22%3A%22Z9Zne%22%7D"></card><span data-lake-id="ud1416a12" id="ud1416a12">为新策略概率与旧策略概率之比，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cepsilon%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F7c102e7a7d231bf935f9bc23417779a8.svg%22%2C%22id%22%3A%22AV4aG%22%7D"></card><span data-lake-id="udf78143c" id="udf78143c">是决定新策略能够偏离旧策略多大程度的超参数</span></li><li fid="ue1f4e894" data-lake-id="u6d4323c7" id="u6d4323c7"><span data-lake-id="u41b19d2f" id="u41b19d2f">clip 函数将</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(a_t%5C%5Cmid%20s_t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4fe7e6db28ac0d5c0025d23b0ed4d528.svg%22%2C%22id%22%3A%22YUSZq%22%7D"></card><span data-lake-id="u15cf24e9" id="u15cf24e9">的值限制在</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22(1-%5C%5Cepsilon%2C1%2B%5C%5Cepsilon)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F271714e0047b7e99194a7791dae27e5f.svg%22%2C%22id%22%3A%22zPCk9%22%7D"></card><span data-lake-id="uf570b75a" id="uf570b75a">之间。裁剪起到正则化作用，限制策略在相邻两次迭代之间发生剧烈变化的程度。避免过大的策略更新，可以确保学习过程的稳健性，同时保持比原始策略梯度方法更高的样本效率</span></li></ul><p data-lake-id="uf8562253" id="uf8562253"><strong><span data-lake-id="ufaf4438b" id="ufaf4438b">价值函数估计。在 PPO 算法中，评论家模型通常也称为价值函数，用于估计每个状态的期望回报。该模型的学习目标是最小化预测值与实际回报值之间的差异。评论家模型的损失函数通常采用均方误差</span></strong></p><p data-lake-id="u8901545a" id="u8901545a" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Cmathrm%7Bcritic%7D%7D(%5C%5Cphi)%3D%5C%5Chat%7B%5C%5Cmathbb%7BE%7D%7D_t%5C%5Cleft%5B%5C%5Cleft%5C%5C%7CV_%7B%5C%5Cphi%7D(s_t)-%5C%5Chat%7BR%7D_t%5C%5Cright%5C%5C%7C%5E2%5C%5Cright%5D.%20%5C%5Ctag%7B16%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe4e6a457e68f2eb6274c59b623067d92.svg%22%2C%22id%22%3A%22kyQal%22%7D"></card></p><ul list="u9e17bd4c"><li fid="ue121a228" data-lake-id="u15aff1b6" id="u15aff1b6"><span data-lake-id="ud001a652" id="ud001a652">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22V_%7B%5C%5Cphi%7D(s_t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fa278819a9e35c7bdda4b030beadbb2a3.svg%22%2C%22id%22%3A%22GDtyh%22%7D"></card><span data-lake-id="u3cc2c3f9" id="u3cc2c3f9">表示参数为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cphi%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff547e08b7db926659f19deee4b4363d1.svg%22%2C%22id%22%3A%22Dvd5X%22%7D"></card><span data-lake-id="u3f336c6a" id="u3f336c6a">的评论家模型对状态</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22s_t%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe24a254996c6d6d65ed16befdaac934d.svg%22%2C%22id%22%3A%22oqNNe%22%7D"></card><span data-lake-id="ub540d614" id="ub540d614">的价值预测，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7BR%7D_t%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe00767a131d4085ec6b2a73463f2d759.svg%22%2C%22id%22%3A%22M6I3m%22%7D"></card><span data-lake-id="u1cf540ee" id="u1cf540ee">表示状态</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22s_t%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe24a254996c6d6d65ed16befdaac934d.svg%22%2C%22id%22%3A%22M5POb%22%7D"></card><span data-lake-id="ucc4388e4" id="ucc4388e4">的实际回报值，可估计为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7BR%7D_t%3D%5C%5Csum_%7Bl%3D0%7D%5E%7B%5C%5Cinfty%7D%5C%5Cgamma%5El%20r_%7Bt%2Bl%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fba50b5f9f2844208574625f3bf8efb95.svg%22%2C%22id%22%3A%22lAQfq%22%7D"></card><span data-lake-id="u314eb9d7" id="u314eb9d7">​</span></li></ul><p data-lake-id="ufb3669c9" id="ufb3669c9"><strong><span data-lake-id="u14241f43" id="u14241f43">混合预训练梯度。为缓解 PPO 训练过程中模型语言能力和知识保持能力可能出现的退化，作者还探索在强化学习阶段引入预训练数据。采用这一方法的模型记为 PPO-ptx，其联合目标函数如下</span></strong></p><p data-lake-id="u46497cc7" id="u46497cc7" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Ctext%7Bppo-ptx%7D%7D(%5C%5Ctheta)%3D%5C%5Cmathcal%7BL%7D_%7B%5C%5Ctext%7Bppo-clip%7D%7D(%5C%5Ctheta)%2B%5C%5Clambda_%7B%5C%5Cmathrm%7Bptx%7D%7D%5C%5Cmathbb%7BE%7D_%7Bx%5C%5Csim%5C%5Cmathcal%7BD%7D_%7B%5C%5Cmathrm%7Bpretrain%7D%7D%7D%5C%5Cleft%5B%5C%5Clog%5C%5Cleft(%5C%5Cpi_%7B%5C%5Ctheta%7D%5E%7B%5C%5Cmathrm%7BRL%7D%7D(x)%5C%5Cright)%5C%5Cright%5D.%20%5C%5Ctag%7B17%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F189a00b8a343835c35007525627cdeb1.svg%22%2C%22id%22%3A%22y2ay3%22%7D"></card></p><ul list="uaf234271"><li fid="u41e561f5" data-lake-id="u090265ef" id="u090265ef"><span data-lake-id="u6c6e0ec9" id="u6c6e0ec9">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Clambda_%7B%5C%5Cmathrm%7Bptx%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F055b85c9ee233dba39c3f95aff9b3111.svg%22%2C%22id%22%3A%22FwXja%22%7D"></card><span data-lake-id="uc97c3370" id="uc97c3370">为预训练损失系数，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BD%7D_%7B%5C%5Cmathrm%7Bpretrain%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F51f78b2db4d51259d2361d4713bba869.svg%22%2C%22id%22%3A%22EaN6u%22%7D"></card><span data-lake-id="u82fb2514" id="u82fb2514">为预训练数据分布</span></li></ul><h2 data-lake-id="LJqMk" id="LJqMk" style="text-align: center"><span data-lake-id="u9f06c015" id="u9f06c015">🔮</span><span data-lake-id="u57b4797f" id="u57b4797f"> 𝐄𝐱𝐩𝐥𝐨𝐫𝐚𝐭𝐢𝐨𝐧 𝐨𝐟 𝐏𝐏𝐎</span></h2><p data-lake-id="u7a839701" id="u7a839701"><span data-lake-id="u468034ac" id="u468034ac">PPO 训练中的奖励上升与损失收敛并不必然意味着策略质量改善；过度优化可能使模型利用奖励模型的偏差获取高分，陷入固定生成模式，并产生分布外回答。因此，作者结合困惑度、策略模型与参考模型之间的 KL 散度及平均回答长度监测训练过程，将奖励分布长尾化、回答变长和固定生成模式的困惑度下降视为异常信号。这些指标主要用于判断训练稳定性和识别严重偏离，难以精确区分能力相近模型的优劣</span></p><p data-lake-id="u4c1c5394" id="u4c1c5394" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790657256727-208ed213-a2f4-4a31-b6f4-0ba7d9457484.png%22%2C%22taskId%22%3A%22u35ddc31b-ecb8-4f98-9df5-cf36fddffb1%22%2C%22clientId%22%3A%22uc63a9387-46c1-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A793.2000122070312%2C%22height%22%3A481%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A385585%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1279%2C%22originHeight%22%3A776%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%225REWARDNORMALIZATIONANDCLIPPING%22%2C%22x%22%3A786%2C%22y%22%3A302%2C%22width%22%3A387%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%2211CLIPPEDSURROGATEOBJECTIVE%22%2C%22x%22%3A788%2C%22y%22%3A640%2C%22width%22%3A312%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%226ADYANTAGESNORMALIZATIONANDCLIPPING%22%2C%22x%22%3A793%2C%22y%22%3A354%2C%22width%22%3A412%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%2277VALUEFUNCTIONLOSSCLIPPING%22%2C%22x%22%3A771%2C%22y%22%3A403%2C%22width%22%3A330%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%2210GENERALIZEDADVANTAGEESTIMATION%22%2C%22x%22%3A791%2C%22y%22%3A580%2C%22width%22%3A371%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%2212GLOBALGRADIENTCLIPPING%22%2C%22x%22%3A782%2C%22y%22%3A699%2C%22width%22%3A298%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%229POLICYMODELINITIALIZATION%22%2C%22x%22%3A795%2C%22y%22%3A518%2C%22width%22%3A272%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22LMPLEMENTATIONDETAILLIST%22%2C%22x%22%3A760%2C%22y%22%3A38%2C%22width%22%3A292%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%228CRITICMODELINITIALIZATION%22%2C%22x%22%3A786%2C%22y%22%3A468%2C%22width%22%3A282%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%223ENTROPYBONUS%22%2C%22x%22%3A792%2C%22y%22%3A193%2C%22width%22%3A175%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%222LMPORTANCESAMPLING%22%2C%22x%22%3A793%2C%22y%22%3A146%2C%22width%22%3A232%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22REWARDSCALING%22%2C%22x%22%3A798%2C%22y%22%3A254%2C%22width%22%3A174%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%221TOKENLEVELKL-PENALT%22%2C%22x%22%3A793%2C%22y%22%3A95%2C%22width%22%3A247%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22PRETRAININGDAT%3A%22%2C%22x%22%3A286%2C%22y%22%3A535%2C%22width%22%3A122%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22PPO-CLIPLOSS%22%2C%22x%22%3A535%2C%22y%22%3A738%2C%22width%22%3A102%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22REWARD%22%2C%22x%22%3A301%2C%22y%22%3A49%2C%22width%22%3A75%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22PPO-MAX%22%2C%22x%22%3A1141%2C%22y%22%3A49%2C%22width%22%3A91%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22MIODEL%22%2C%22x%22%3A305%2C%22y%22%3A76%2C%22width%22%3A67%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22%E8%89%BA%22%2C%22x%22%3A106%2C%22y%22%3A184%2C%22width%22%3A100%2C%22height%22%3A66%7D%2C%7B%22text%22%3A%22ADVANTAGEFUNCTI%22%2C%22x%22%3A513%2C%22y%22%3A138%2C%22width%22%3A114%2C%22height%22%3A12%7D%2C%7B%22text%22%3A%22NAOA(AELSE)%22%2C%22x%22%3A472%2C%22y%22%3A684%2C%22width%22%3A105%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A132%2C%22y%22%3A561%2C%22width%22%3A58%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22VO(ST)%22%2C%22x%22%3A128%2C%22y%22%3A586%2C%22width%22%3A65%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22USERQUERY%22%2C%22x%22%3A29%2C%22y%22%3A479%2C%22width%22%3A93%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22XPERIENC%22%2C%22x%22%3A541%2C%22y%22%3A371%2C%22width%22%3A66%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22NS(A%3ALSE)%22%2C%22x%22%3A480%2C%22y%22%3A662%2C%22width%22%3A97%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22A(ST%2CAT)%22%2C%22x%22%3A603%2C%22y%22%3A273%2C%22width%22%3A58%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22VALUE%22%2C%22x%22%3A135%2C%22y%22%3A538%2C%22width%22%3A53%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22(X%2CY)%22%2C%22x%22%3A390%2C%22y%22%3A97%2C%22width%22%3A50%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22TDERROI%22%2C%22x%22%3A511%2C%22y%22%3A163%2C%22width%22%3A60%2C%22height%22%3A12%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A311%2C%22y%22%3A217%2C%22width%22%3A54%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22V%E4%B8%AD(ST)%22%2C%22x%22%3A309%2C%22y%22%3A239%2C%22width%22%3A58%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A135%2C%22y%22%3A71%2C%22width%22%3A58%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22%E5%88%9BI%22%2C%22x%22%3A138%2C%22y%22%3A374%2C%22width%22%3A45%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22(X%2CY)%22%2C%22x%22%3A305%2C%22y%22%3A101%2C%22width%22%3A69%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22VALUE%22%2C%22x%22%3A315%2C%22y%22%3A194%2C%22width%22%3A45%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22POLICY%22%2C%22x%22%3A135%2C%22y%22%3A323%2C%22width%22%3A54%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22RETURN%22%2C%22x%22%3A508%2C%22y%22%3A187%2C%22width%22%3A50%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22%E5%85%83%22%2C%22x%22%3A555%2C%22y%22%3A549%2C%22width%22%3A40%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22GAE%22%2C%22x%22%3A533%2C%22y%22%3A86%2C%22width%22%3A73%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22POLICY%22%2C%22x%22%3A549%2C%22y%22%3A501%2C%22width%22%3A57%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%224%22%2C%22x%22%3A394%2C%22y%22%3A46%2C%22width%22%3A33%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%22BUFFER%22%2C%22x%22%3A546%2C%22y%22%3A383%2C%22width%22%3A65%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22SFT%22%2C%22x%22%3A140%2C%22y%22%3A44%2C%22width%22%3A56%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22MISELOSS%22%2C%22x%22%3A129%2C%22y%22%3A737%2C%22width%22%3A64%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22LM%22%2C%22x%22%3A558%2C%22y%22%3A528%2C%22width%22%3A36%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22TSFT%22%2C%22x%22%3A138%2C%22y%22%3A91%2C%22width%22%3A48%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22LM%22%2C%22x%22%3A143%2C%22y%22%3A351%2C%22width%22%3A41%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22MLOSS%22%2C%22x%22%3A404%2C%22y%22%3A740%2C%22width%22%3A48%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A429%2C%22y%22%3A73%2C%22width%22%3A41%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22%E5%8F%B0%22%2C%22x%22%3A513%2C%22y%22%3A647%2C%22width%22%3A70%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%2212%22%2C%22x%22%3A313%2C%22y%22%3A721%2C%22width%22%3A30%2C%22height%22%3A28%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ebe7e4%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ue10e8549%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><ul list="u17761a2e"><li fid="u929177a7" data-lake-id="u0604a37b" id="u0604a37b"><span data-lake-id="ud2fc478c" id="ud2fc478c">单纯奖励缩放不足以保证 PPO 的稳定优化，而奖励或优势的归一化与裁剪能够在一定训练阶段内抑制波动，但效果依赖裁剪阈值。优势归一化仅在小批次内进行，优势裁剪的参数选择也更敏感；增大裁剪阈值可能带来更大的策略变化和更高的奖励，却不保证人工评估表现更好。因此，作者建议优先在奖励层面进行归一化与裁剪，采用较宽松的裁剪阈值，并结合其他策略约束控制过度优化</span></li><li fid="u929177a7" data-lake-id="u7e98cf4d" id="u7e98cf4d"><span data-lake-id="ue4a128c9" id="ue4a128c9">实验表明，策略约束是抑制过度优化、维持 PPO 长期训练稳定性的关键，其中 token 级 KL 惩罚能够限制策略偏离原始分布，并支持更长的训练过程。文中采用的固定参考分布设置与 KL 惩罚结合后，可进一步稳定训练，但会降低策略模型的最终性能。熵奖励对参数选择和代码实现高度敏感，即使配置得当，也未表现出相对于 KL 惩罚的明显优势。因此，作者优先推荐使用 KL 惩罚约束策略优化</span></li></ul><p data-lake-id="ub5d11e45" id="ub5d11e45" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790662505854-eb3ff1ba-e2a5-4de1-8528-93532cc7f291.png%22%2C%22taskId%22%3A%22u63e52b63-15ca-43bc-bc5b-f34452c4f9e%22%2C%22clientId%22%3A%22u54b214e1-76e8-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A795%2C%22height%22%3A314%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A374176%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1566%2C%22originHeight%22%3A618%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22AST_REWARD%3DTORCH.ZEROS_LIKE(KL).SCATTER_(DIM%3DL%2CINDEX%3DEOS_INDICES%2CSRC%22%2C%22x%22%3A85%2C%22y%22%3A510%2C%22width%22%3A1049%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22DICES%3DACTION_MASK.SIZE(1)-1%22%2C%22x%22%3A148%2C%22y%22%3A470%2C%22width%22%3A459%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22R%3DR%2CCLAMP(MIN%3DREWARD_CLIP_RANGE%5B0%5D%2CMAX%3DREWARD_CLIP_RANGE%5B1%5D)%22%2C%22x%22%3A109%2C%22y%22%3A391%2C%22width%22%3A938%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22KL%3AUNION%5BTORCH.TENSOR%2C1IST%5BTORCH.TENSOR%5D%5D%2C%22%2C%22x%22%3A74%2C%22y%22%3A129%2C%22width%22%3A633%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22-%3EUNION%5BTORCH.TENSOR%2CLIST%5BTORCH.TENSOR%5D%5D%3A%22%2C%22x%22%3A40%2C%22y%22%3A244%2C%22width%22%3A643%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22CTION_MASK%3AOPTIONAL%5BTORCH.TENSOR%5D%3DNONE%2C%22%2C%22x%22%3A76%2C%22y%22%3A166%2C%22width%22%3A631%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22REWARD_CLIP_RANGE%3ATUPLE%5BFLOAT%2CFLOAT%5D%3DNONE%22%2C%22x%22%3A67%2C%22y%22%3A206%2C%22width%22%3A661%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22IFREWARD_C1IP_RANGE%3A%22%2C%22x%22%3A73%2C%22y%22%3A356%2C%22width%22%3A398%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22KL_REWARD%3D-KL_COEF*KL%22%2C%22x%22%3A72%2C%22y%22%3A431%2C%22width%22%3A684%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22L_COEF%3AFLOAT%2C%22%2C%22x%22%3A75%2C%22y%22%3A90%2C%22width%22%3A270%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22R%3AUNION%5BTORCH.TENSOR%2CFLOAT%5D%22%2C%22x%22%3A74%2C%22y%22%3A53%2C%22width%22%3A414%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22EWARD%3DLASTREWARD%2B%22%2C%22x%22%3A80%2C%22y%22%3A547%2C%22width%22%3A324%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22IFKLCOEF%3C%3D0.0%3A%22%2C%22x%22%3A69%2C%22y%22%3A281%2C%22width%22%3A268%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22K1_COEF%3D0.0%22%2C%22x%22%3A90%2C%22y%22%3A318%2C%22width%22%3A232%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22ETURNREWARD%22%2C%22x%22%3A80%2C%22y%22%3A588%2C%22width%22%3A178%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22COMPUTEREWARD%22%2C%22x%22%3A68%2C%22y%22%3A19%2C%22width%22%3A210%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22%2BK1REWARD%22%2C%22x%22%3A374%2C%22y%22%3A547%2C%22width%22%3A195%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%221-ACTION_MASK.LONG().FLIPLR()%2CARGMAX(DIM%3D1%2CKEEPDIM%3DTRUE)%22%2C%22x%22%3A584%2C%22y%22%3A472%2C%22width%22%3A869%2C%22height%22%3A23%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23fafaf4%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22u1d606d83%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><ul list="u17761a2e" start="3"><li fid="u929177a7" data-lake-id="ue6a64374" id="ue6a64374"><span data-lake-id="ud2d0be13" id="ud2d0be13">在作者的实验设置中，策略模型经过 SFT 是稳定开展 PPO 训练的重要前提：直接从预训练模型进行 PPO 训练会显著损害语言建模能力，且所得奖励低于 SFT 模型。相比之下，使用奖励模型或 SFT 模型初始化评论家模型，最终均能收敛至相近结果，差异主要体现在优化初期的数值稳定性。预先训练评论家模型能够改善优势估计并缓解早期波动，因此作者建议以评论家模型预训练替代学习率预热</span></li></ul><h1 data-lake-id="PCcbe" id="PCcbe" style="text-align: center"><span data-lake-id="u1836879f" id="u1836879f">🐉</span><span data-lake-id="u3cd13f6f" id="u3cd13f6f"> 𝐃𝐢𝐫𝐞𝐜𝐭 𝐏𝐫𝐞𝐟𝐞𝐫𝐞𝐧𝐜𝐞 𝐎𝐩𝐭𝐢𝐦𝐢𝐳𝐚𝐭𝐢𝐨𝐧: 𝐘𝐨𝐮𝐫 𝐋𝐚𝐧𝐠𝐮𝐚𝐠𝐞 𝐌𝐨𝐝𝐞𝐥 𝐢𝐬 𝐒𝐞𝐜𝐫𝐞𝐭𝐥𝐲 𝐚 𝐑𝐞𝐰𝐚𝐫𝐝 𝐌𝐨𝐝𝐞𝐥</span></h1><p data-lake-id="ua6c8d8db" id="ua6c8d8db"><strong><span data-lake-id="uaea2426c" id="uaea2426c">从模型广泛的知识与能力中选择期望的回答和行为，对于构建安全、高性能且可控的人工智能系统至关重要。现有方法通常使用强化学习引导语言模型与人类偏好保持一致，而作者将证明，这些方法采用的强化学习目标可以通过一个简单的二元交叉熵目标进行精确优化，从而大幅简化偏好学习流程</span></strong></p><ul list="u148a8fb7"><li fid="ufa34f010" data-lake-id="ubf1fdf73" id="ubf1fdf73"><span data-lake-id="ua145e8c9" id="ua145e8c9">总体而言，现有方法使用经过整理的人类偏好数据，将期望的行为融入语言模型。这些偏好数据反映人类认为安全且有用的行为类型。偏好学习阶段发生在模型基于大规模文本数据集完成初始的大规模无监督预训练之后</span></li><li fid="ufa34f010" data-lake-id="u332c37d5" id="u332c37d5"><span data-lake-id="ub27d4d26" id="ub27d4d26">虽然最直接的偏好学习方法，是使用人类提供的高质量回答示例进行监督微调，但最成功的一类方法是基于人类或人工智能反馈的强化学习。RLHF 方法首先在人类偏好数据集上拟合奖励模型，再使用强化学习优化语言模型策略，使其生成获得高奖励的回答，同时避免过度偏离原始模型</span></li><li fid="ufa34f010" data-lake-id="u31d3821e" id="u31d3821e"><span data-lake-id="ud0f59a36" id="ud0f59a36">尽管 RLHF 能够训练出具有出色对话与编程能力的模型，但其流程远比监督学习复杂：不仅需要训练多个语言模型，还需要在训练循环中从语言模型策略进行采样，由此产生显著的计算开销</span></li></ul><p data-lake-id="u317af17a" id="u317af17a"><strong><span data-lake-id="uc94fbf48" id="uc94fbf48">在本文中，作者展示如何直接优化语言模型，使其遵循人类偏好，而无需显式奖励建模或强化学习。作者提出直接偏好优化，该算法隐式优化与现有 RLHF 算法相同的目标，即在 KL 散度约束下最大化奖励，同时具有实现简单、训练直接的特点</span></strong></p><ul list="u4a305e79"><li fid="ua81f3af9" data-lake-id="ue605e094" id="ue605e094"><strong><span data-lake-id="u5e8ce3bd" id="u5e8ce3bd" style="color: #663000">直观而言，DPO 的更新会增大偏好回答与非偏好回答之间的对数概率差，同时引入针对每个样本动态调整的重要性权重，以防止作者在使用朴素概率比目标时观察到的模型退化</span></strong></li><li fid="ua81f3af9" data-lake-id="uc4f19e4e" id="uc4f19e4e"><span data-lake-id="ued45193a" id="ued45193a">与现有算法类似，DPO 依赖于理论偏好模型，例如 Bradley–Terry 模型，用于衡量给定奖励函数与经验偏好数据的一致程度。然而，现有方法使用偏好模型定义偏好损失，以训练奖励模型，再训练策略以最大化所学奖励模型给出的奖励</span></li><li fid="ua81f3af9" data-lake-id="u63b37740" id="u63b37740"><strong><span data-lake-id="u1829c17a" id="u1829c17a" style="color: #5C0036">DPO 则通过变量替换，直接将偏好损失定义为策略的函数。因此，给定一个包含人类对模型回答偏好的数据集，DPO 便可以使用简单的二元交叉熵目标优化策略，无需显式学习奖励函数，也无需在训练过程中从策略进行采样</span></strong></li></ul><p data-lake-id="uc85b40a3" id="uc85b40a3" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790662910324-37bb3dc9-812f-454f-abe8-a40698ca8189.png%22%2C%22taskId%22%3A%22u64197ad4-8e5c-48c5-a7d0-2b692f808ef%22%2C%22clientId%22%3A%22uaddee205-df9c-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A780.8%2C%22height%22%3A162%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A93347%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A976%2C%22originHeight%22%3A203%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E4%B8%89%22%2C%22x%22%3A610%2C%22y%22%3A76%2C%22width%22%3A136%2C%22height%22%3A48%7D%2C%7B%22text%22%3A%22%E4%B8%89%22%2C%22x%22%3A22%2C%22y%22%3A75%2C%22width%22%3A132%2C%22height%22%3A50%7D%2C%7B%22text%22%3A%22IRECTPREFERENCEOPTIMIZATION(DPO)%22%2C%22x%22%3A624%2C%22y%22%3A16%2C%22width%22%3A309%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22REINFORCEMENTLEARNINGFROMHUMANFEEDBAC%22%2C%22x%22%3A24%2C%22y%22%3A17%2C%22width%22%3A388%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22EINFORCEMENTLEARNING%22%2C%22x%22%3A319%2C%22y%22%3A165%2C%22width%22%3A192%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22SAMPLECOMPLETIONS%22%2C%22x%22%3A330%2C%22y%22%3A134%2C%22width%22%3A163%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22MANFEEDBACK(RLHF)%22%2C%22x%22%3A300%2C%22y%22%3A16%2C%22width%22%3A189%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22LABELREWARDS%22%2C%22x%22%3A356%2C%22y%22%3A48%2C%22width%22%3A116%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22PREFERENCEDATA%22%2C%22x%22%3A28%2C%22y%22%3A132%2C%22width%22%3A138%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22EWARDMODE%22%2C%22x%22%3A255%2C%22y%22%3A91%2C%22width%22%3A109%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22PREFERENCEDATA%22%2C%22x%22%3A615%2C%22y%22%3A131%2C%22width%22%3A132%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22LMPOLICY%22%2C%22x%22%3A470%2C%22y%22%3A90%2C%22width%22%3A91%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22MAXIMUM%22%2C%22x%22%3A165%2C%22y%22%3A134%2C%22width%22%3A87%2C%22height%22%3A12%7D%2C%7B%22text%22%3A%22LIKELIHOOD%22%2C%22x%22%3A170%2C%22y%22%3A156%2C%22width%22%3A82%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22THEHISTORYOFJAZZ%22%2C%22x%22%3A29%2C%22y%22%3A52%2C%22width%22%3A112%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22FINALLM%22%2C%22x%22%3A857%2C%22y%22%3A89%2C%22width%22%3A95%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22MAXIMUM%22%2C%22x%22%3A746%2C%22y%22%3A140%2C%22width%22%3A90%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22IKELIHOOD%22%2C%22x%22%3A756%2C%22y%22%3A163%2C%22width%22%3A80%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22THEHISTORYOFJAZZ%22%2C%22x%22%3A614%2C%22y%22%3A52%2C%22width%22%3A116%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22X%3A%5C%22WRITEMEAPOEMABOUT%22%2C%22x%22%3A26%2C%22y%22%3A37%2C%22width%22%3A127%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22X%3A%5C%22WRITEMEAPOEMABOUT%22%2C%22x%22%3A610%2C%22y%22%3A38%2C%22width%22%3A140%2C%22height%22%3A11%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23b3bbcb%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22u708e58f1%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><h2 data-lake-id="SmoCm" id="SmoCm" style="text-align: center"><span data-lake-id="u70069be2" id="u70069be2">🎬</span><span data-lake-id="u4e313258" id="u4e313258" style="color: #5C0036"> </span><span data-lake-id="u3a7f8fef" id="u3a7f8fef">𝐏𝐫𝐞𝐥𝐢𝐦𝐢𝐧𝐚𝐫𝐢𝐞𝐬</span></h2><p data-lake-id="u75589e1e" id="u75589e1e"><strong><span data-lake-id="ue73a5c13" id="ue73a5c13">监督微调（SFT） RLHF 通常首先使用目标下游任务（例如对话、摘要生成等）的高质量数据，对预训练语言模型进行监督微调，得到模型</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi%5E%7B%5C%5Cmathrm%7BSFT%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff8892020394e96d0c50028325e85d329.svg%22%2C%22id%22%3A%22w3rOy%22%7D"></card></p><p data-lake-id="u62943d93" id="u62943d93"><strong><span data-lake-id="ubf12e2ff" id="ubf12e2ff">奖励建模阶段。在第二阶段，使用提示</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22x%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F712ecf7894348e92d8779c3ee87eeeb0.svg%22%2C%22id%22%3A%22nTAyJ%22%7D"></card><strong><span data-lake-id="u45b5d71b" id="u45b5d71b">引导 SFT 模型生成成对回答</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22(y_1%2Cy_2)%5C%5Csim%5C%5Cpi%5E%7B%5C%5Cmathrm%7BSFT%7D%7D(y%5C%5Cmid%20x)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F0cdea0f501d5778353f161db1bdcda05.svg%22%2C%22id%22%3A%22m7HW1%22%7D"></card><strong><span data-lake-id="u8d835445" id="u8d835445">。随后，将这些回答呈现给人工标注者，由其表达对其中一个回答的偏好，记为</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22y_w%5C%5Csucc%20y_l%5C%5Cmid%20x%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6b7ebdee3f4e0a2c392902817781e26e.svg%22%2C%22id%22%3A%22SeMdK%22%7D"></card><strong><span data-lake-id="ubeb8b4ea" id="ubeb8b4ea">，其中</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22y_w%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F22d3748a1a6b1a91dda986e0b204471a.svg%22%2C%22id%22%3A%22xLLEG%22%7D"></card><strong><span data-lake-id="u8771c956" id="u8771c956">和</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22y_l%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F5940c70497dd7c00369aa6f50b3cc63b.svg%22%2C%22id%22%3A%22ArSMK%22%7D"></card><strong><span data-lake-id="u4152c18b" id="u4152c18b">分别表示</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22(y_1%2Cy_2)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F93f27b37c2c96d53877e780f2b45cbf1.svg%22%2C%22id%22%3A%22uLo1y%22%7D"></card><strong><span data-lake-id="u923808c2" id="u923808c2">中的偏好回答与非偏好回答</span></strong></p><ul list="u1e213cb6"><li fid="u26c27e9d" data-lake-id="ud4bc2faf" id="ud4bc2faf"><span data-lake-id="ufd0ea860" id="ufd0ea860">假设这些偏好由某个无法直接获取的潜在奖励模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r%5E*(y%2Cx)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ffb3a2d9cd43cc67a79712a396999347d.svg%22%2C%22id%22%3A%22jxVpq%22%7D"></card><span data-lake-id="u80e7155b" id="u80e7155b">生成。偏好可以通过多种方法建模，其中 Bradley–Terry（BT）模型是一种常见选择。如果能够获取多个已排序的回答，那么更一般的 Plackett–Luce 排序模型也与该框架兼容。BT 模型规定，人类偏好分布</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22p%5E*%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Feac8e216557ed1bd6d624a95f0f03e24.svg%22%2C%22id%22%3A%22AkVs9%22%7D"></card><span data-lake-id="u39c36755" id="u39c36755">可表示为</span></li></ul><p data-lake-id="ufafe2ea7" id="ufafe2ea7" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22p%5E*(y_1%5C%5Csucc%20y_2%5C%5Cmid%20x)%3D%5C%5Cfrac%7B%5C%5Cexp%5C%5Cleft(r%5E*(x%2Cy_1)%5C%5Cright)%7D%7B%5C%5Cexp%5C%5Cleft(r%5E*(x%2Cy_1)%5C%5Cright)%2B%5C%5Cexp%5C%5Cleft(r%5E*(x%2Cy_2)%5C%5Cright)%7D.%20%5C%5Ctag%7B1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Febefd04e42ab66eb98b30be9707c99bd.svg%22%2C%22id%22%3A%22PcirB%22%7D"></card></p><ul list="u4dc2ae9c"><li fid="u753a8151" data-lake-id="u1cfca58a" id="u1cfca58a"><span data-lake-id="ue8b582fc" id="ue8b582fc">假设可以获得从</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22p%5E*%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Feac8e216557ed1bd6d624a95f0f03e24.svg%22%2C%22id%22%3A%22nu7gT%22%7D"></card><span data-lake-id="uedea1ffe" id="uedea1ffe">中采样得到的静态比较数据集</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BD%7D%3D%5C%5C%7Bx%5E%7B(i)%7D%2Cy_w%5E%7B(i)%7D%2Cy_l%5E%7B(i)%7D%5C%5C%7D_%7Bi%3D1%7D%5E%7BN%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F97aa8eb187b0236a6338bfc55a38efcc.svg%22%2C%22id%22%3A%22qzSkP%22%7D"></card><span data-lake-id="ub2c1dc51" id="ub2c1dc51">，便可以构建参数化奖励模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r_%5C%5Cphi(x%2Cy)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fea65f0ae467c40d284943c3b59e59689.svg%22%2C%22id%22%3A%22jcGZw%22%7D"></card><span data-lake-id="u249ddf48" id="u249ddf48">，并通过最大似然估计其参数。将该问题表述为二分类问题，可以得到以下负对数似然损失：</span></li></ul><p data-lake-id="u3b93cdb0" id="u3b93cdb0" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7BR%7D(r_%5C%5Cphi%2C%5C%5Cmathcal%7BD%7D)%3D-%5C%5Cmathbb%7BE%7D_%7B(x%2Cy_w%2Cy_l)%5C%5Csim%5C%5Cmathcal%7BD%7D%7D%5C%5Cleft%5B%5C%5Clog%5C%5Csigma%5C%5Cleft(r_%5C%5Cphi(x%2Cy_w)-r_%5C%5Cphi(x%2Cy_l)%5C%5Cright)%5C%5Cright%5D.%20%5C%5Ctag%7B2%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ffb85d230b0dd4aba152cdefb52548f20.svg%22%2C%22id%22%3A%22Ns2Xb%22%7D"></card></p><ul list="u10bb0468"><li fid="u32af5c9f" data-lake-id="ub1db2276" id="ub1db2276"><span data-lake-id="u7d0bf35d" id="u7d0bf35d">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22MqxBT%22%7D"></card><span data-lake-id="u8cc0b486" id="u8cc0b486">为 logistic 函数。在语言模型场景中，网络</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r_%5C%5Cphi(x%2Cy)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fea65f0ae467c40d284943c3b59e59689.svg%22%2C%22id%22%3A%22PPM1W%22%7D"></card><span data-lake-id="uf5fae047" id="uf5fae047">通常由 SFT 模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi%5E%7B%5C%5Cmathrm%7BSFT%7D%7D(y%5C%5Cmid%20x)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc0736d619da6a7c6c99b6c26018069d3.svg%22%2C%22id%22%3A%22yapBh%22%7D"></card><span data-lake-id="u534da3f3" id="u534da3f3">初始化，并在最后一个 Transformer 层之上添加一个线性层，用于输出奖励值的标量预测。为获得方差更低的奖励函数，已有研究会对奖励进行归一化，使得对所有</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22x%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F712ecf7894348e92d8779c3ee87eeeb0.svg%22%2C%22id%22%3A%22bhTVw%22%7D"></card><span data-lake-id="ufdf095c9" id="ufdf095c9">均有</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathbb%7BE%7D_%7Bx%2Cy%5C%5Csim%5C%5Cmathcal%7BD%7D%7D%5Br_%5C%5Cphi(x%2Cy)%5D%3D0%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F1ff49c2f538cfa891a13177ebfd40335.svg%22%2C%22id%22%3A%22vZ130%22%7D"></card><span data-lake-id="u4aa901e8" id="u4aa901e8">​</span></li></ul><p data-lake-id="u753721ad" id="u753721ad"><strong><span data-lake-id="u5891034b" id="u5891034b">强化学习微调阶段。在强化学习阶段，使用学习得到的奖励函数为语言模型提供反馈。具体而言，构建以下优化问题</span></strong></p><p data-lake-id="uadf3280d" id="uadf3280d" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmax_%7B%5C%5Cpi_%5C%5Ctheta%7D%5C%5Cmathbb%7BE%7D_%7Bx%5C%5Csim%5C%5Cmathcal%7BD%7D%2C%5C%5C%2Cy%5C%5Csim%5C%5Cpi_%5C%5Ctheta(y%5C%5Cmid%20x)%7D%5C%5Cleft%5Br_%5C%5Cphi(x%2Cy)%5C%5Cright%5D-%5C%5Cbeta%5C%5Cmathbb%7BD%7D_%7B%5C%5Cmathrm%7BKL%7D%7D%5C%5Cleft%5B%5C%5Cpi_%5C%5Ctheta(y%5C%5Cmid%20x)%5C%5C%2C%5C%5C%7C%5C%5C%2C%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y%5C%5Cmid%20x)%5C%5Cright%5D.%20%5C%5Ctag%7B3%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F7a77a8b26f5992ec40406fd14434a71e.svg%22%2C%22id%22%3A%22GEwfm%22%7D"></card></p><ul list="u3dc9b663"><li fid="u435a5579" data-lake-id="u4e5e931b" id="u4e5e931b"><span data-lake-id="ucd0d7648" id="ucd0d7648">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6100158802e722a88c15efc101fc275b.svg%22%2C%22id%22%3A%22tJZTn%22%7D"></card><span data-lake-id="uc3d96590" id="uc3d96590">是控制策略相对于基础参考策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff73154893f2557c1227ee196e79412a6.svg%22%2C%22id%22%3A%22jpTh9%22%7D"></card><span data-lake-id="u934c8e2e" id="u934c8e2e">偏离程度的参数，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff73154893f2557c1227ee196e79412a6.svg%22%2C%22id%22%3A%22bBaoX%22%7D"></card><span data-lake-id="u3fb261c6" id="u3fb261c6">即初始 SFT 模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi%5E%7B%5C%5Cmathrm%7BSFT%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff8892020394e96d0c50028325e85d329.svg%22%2C%22id%22%3A%22yYKy8%22%7D"></card></li><li fid="u435a5579" data-lake-id="u26bba14a" id="u26bba14a"><span data-lake-id="u8af4ee1e" id="u8af4ee1e">在实际应用中，语言模型策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F7fbcd62054bd83770c4508841ae9c9a4.svg%22%2C%22id%22%3A%22OWERa%22%7D"></card><span data-lake-id="u41e2a268" id="u41e2a268">也初始化为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi%5E%7B%5C%5Cmathrm%7BSFT%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff8892020394e96d0c50028325e85d329.svg%22%2C%22id%22%3A%22S1gn2%22%7D"></card><span data-lake-id="udf55b501" id="udf55b501">。这一附加约束十分重要：它能够防止模型过度偏离奖励模型能够准确评估的分布，同时维持生成多样性，避免模式坍缩至单一的高奖励回答。由于语言生成具有离散性，该目标不可微，通常使用强化学习进行优化</span></li><li fid="u435a5579" data-lake-id="u6f6e0d5d" id="u6f6e0d5d"><span data-lake-id="u45b4993d" id="u45b4993d">标准做法是构造奖励函数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r(x%2Cy)%3Dr_%5C%5Cphi(x%2Cy)-%5C%5Cbeta%5C%5Cleft(%5C%5Clog%5C%5Cpi_%5C%5Ctheta(y%5C%5Cmid%20x)-%5C%5Clog%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y%5C%5Cmid%20x)%5C%5Cright)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fd2a5149fd221833b14842abc49c7ed7f.svg%22%2C%22id%22%3A%22QMzzb%22%7D"></card><span data-lake-id="u4bd9e2c9" id="u4bd9e2c9">，并使用 PPO 最大化该奖励</span></li></ul><h2 data-lake-id="kRTZ2" id="kRTZ2" style="text-align: center"><span data-lake-id="uc912351c" id="uc912351c">🍎</span><span data-lake-id="ue9e5eba8" id="ue9e5eba8"> 𝐃𝐢𝐫𝐞𝐜𝐭 𝐏𝐫𝐞𝐟𝐞𝐫𝐞𝐧𝐜𝐞 𝐎𝐩𝐭𝐢𝐦𝐢𝐳𝐚𝐭𝐢𝐨𝐧</span></h2><p data-lake-id="u0b8f8961" id="u0b8f8961"><strong><span data-lake-id="ub5c0c570" id="ub5c0c570">鉴于将强化学习算法应用于语言模型微调等大规模问题所面临的挑战，作者旨在推导一种直接利用偏好进行策略优化的简单方法。以往的 RLHF 方法先学习奖励，再通过强化学习对其进行优化；本文方法则绕过奖励建模步骤，直接使用偏好数据优化语言模型</span></strong></p><ul list="u8f2d25f4"><li fid="u204398fc" data-lake-id="u1a8ee972" id="u1a8ee972"><strong><span data-lake-id="u8e0f23a7" id="u8e0f23a7" style="color: rgb(42, 188, 191),rgb(56, 54, 221)">其核心思想是利用奖励函数到最优策略之间的解析映射，将定义在奖励函数上的损失转化为定义在策略上的损失。通过这种变量替换，可以跳过显式奖励建模步骤，同时仍基于现有的人类偏好模型，例如 Bradley–Terry 模型，进行优化。从本质上看，策略网络同时表示语言模型和奖励</span></strong></li></ul><p data-lake-id="uc72da1d1" id="uc72da1d1"><strong><span data-lake-id="u96995f56" id="u96995f56">推导 DPO 目标：</span></strong><span data-lake-id="u9e8931af" id="u9e8931af">作者从与已有研究相同的强化学习目标出发，考虑一般奖励函数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F72cb3a229067770aeb6caa625a65a1a1.svg%22%2C%22id%22%3A%22bed1f%22%7D"></card><span data-lake-id="uf989e242" id="uf989e242">。遵循已有研究，可以直接证明，式中带有 KL 约束的奖励最大化目标，其最优解具有以下形式</span></p><p data-lake-id="uc2126303" id="uc2126303" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_r(y%5C%5Cmid%20x)%3D%5C%5Cfrac%7B1%7D%7BZ(x)%7D%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y%5C%5Cmid%20x)%5C%5Cexp%5C%5Cleft(%5C%5Cfrac%7B1%7D%7B%5C%5Cbeta%7Dr(x%2Cy)%5C%5Cright).%20%5C%5Ctag%7B4%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff13db3c3e245c2f2f96cbb47eb64ee3f.svg%22%2C%22id%22%3A%22hnKzn%22%7D"></card></p><ul list="u5706a300"><li fid="u133ebd82" data-lake-id="u018ac54b" id="u018ac54b"><span data-lake-id="u8ed877aa" id="u8ed877aa">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22Z(x)%3D%5C%5Csum_y%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y%5C%5Cmid%20x)%5C%5Cexp%5C%5Cleft(%5C%5Cfrac%7B1%7D%7B%5C%5Cbeta%7Dr(x%2Cy)%5C%5Cright)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F110b8e7c1301e599318ee9f4e29ea8e1.svg%22%2C%22id%22%3A%22VUxRY%22%7D"></card><span data-lake-id="u79fe7ea8" id="u79fe7ea8">为配分函数。即使采用真实奖励函数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r%5E*%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F414ffa3b6e46749d8cc021379e95bd6f.svg%22%2C%22id%22%3A%22jixoq%22%7D"></card><span data-lake-id="u04ebb409" id="u04ebb409">的最大似然估计</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r_%5C%5Cphi%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fde5ae40f6d0f4a576ba0cc936b2499a6.svg%22%2C%22id%22%3A%22iblJe%22%7D"></card><span data-lake-id="u0e2caa5b" id="u0e2caa5b">，估计配分函数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22Z(x)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F1e77bac46833188a4177545f386f8565.svg%22%2C%22id%22%3A%22aWZvO%22%7D"></card><span data-lake-id="u9dc410ef" id="u9dc410ef">的成本仍然很高，使得这种表示难以在实践中使用</span></li><li fid="u133ebd82" data-lake-id="ubb38f8a2" id="ubb38f8a2"><span data-lake-id="u7a0bf8f5" id="u7a0bf8f5">可以对公式（4）进行变换，将奖励函数表示为其对应的最优策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_r%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F04abbce0f57b6f46ffe1c01da0ffb46b.svg%22%2C%22id%22%3A%22KsOkD%22%7D"></card><span data-lake-id="u852f8fdb" id="u852f8fdb">、参考策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff73154893f2557c1227ee196e79412a6.svg%22%2C%22id%22%3A%22khSx0%22%7D"></card><span data-lake-id="u86278a98" id="u86278a98">和未知配分函数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22Z(%5C%5Ccdot)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6a0583c17bf35c9ef88504489d910e8e.svg%22%2C%22id%22%3A%22ClPug%22%7D"></card><span data-lake-id="u55c925ad" id="u55c925ad">的函数。具体而言，先对公式两侧取对数，再进行代数变换，可得</span></li></ul><p data-lake-id="ud5e8005d" id="ud5e8005d" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22r(x%2Cy)%3D%5C%5Cbeta%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi_r(y%5C%5Cmid%20x)%7D%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y%5C%5Cmid%20x)%7D%2B%5C%5Cbeta%5C%5Clog%20Z(x).%20%5C%5Ctag%7B5%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F2792aa87b0417375619234ce3e2a234f.svg%22%2C%22id%22%3A%22igM6Y%22%7D"></card></p><ul list="u2408eeb7"><li fid="ua17789e2" data-lake-id="u04915d9d" id="u04915d9d"><span data-lake-id="u4af70b29" id="u4af70b29">Bradley–Terry 模型仅依赖于两个回答之间的奖励差，即</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22p%5E*(y_1%5C%5Csucc%20y_2%5C%5Cmid%20x)%3D%5C%5Csigma%5C%5Cleft(r%5E*(x%2Cy_1)-r%5E*(x%2Cy_2)%5C%5Cright)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9f89f9b1c7ba3d2ad149e3da1b2733c9.svg%22%2C%22id%22%3A%22z3faA%22%7D"></card><span data-lake-id="u38bfba2d" id="u38bfba2d">。将公式（5）中关于</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r%5E*(x%2Cy)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc208dcf624cfe25a0f0ba03d1509b8f9.svg%22%2C%22id%22%3A%22Cutwj%22%7D"></card><span data-lake-id="u17e08abb" id="u17e08abb">的重参数化代入公式（1）的偏好模型后，配分函数会相互抵消，从而可以仅使用最优策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi%5E*%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F76085f1a30a3664f6e4046f9c0e4a501.svg%22%2C%22id%22%3A%22YJMwa%22%7D"></card><span data-lake-id="u8a29198a" id="u8a29198a">和参考策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff73154893f2557c1227ee196e79412a6.svg%22%2C%22id%22%3A%22uWuFr%22%7D"></card><span data-lake-id="ufa5c79d5" id="ufa5c79d5">表示人类偏好概率。因此，Bradley–Terry 模型下的最优 RLHF 策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi%5E*%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F76085f1a30a3664f6e4046f9c0e4a501.svg%22%2C%22id%22%3A%22ftcsf%22%7D"></card><span data-lake-id="ub51dac02" id="ub51dac02">满足以下偏好模型：</span></li></ul><p data-lake-id="ue90b86e6" id="ue90b86e6" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22p%5E*(y_1%5C%5Csucc%20y_2%5C%5Cmid%20x)%3D%5C%5Cfrac%7B1%7D%7B1%2B%5C%5Cexp%5C%5Cleft(%5C%5Cbeta%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi%5E*(y_2%5C%5Cmid%20x)%7D%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y_2%5C%5Cmid%20x)%7D-%5C%5Cbeta%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi%5E*(y_1%5C%5Cmid%20x)%7D%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y_1%5C%5Cmid%20x)%7D%5C%5Cright)%7D.%20%5C%5Ctag%7B6%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F60cbebce3e266ee2e34cb7f32cd08131.svg%22%2C%22id%22%3A%22NtkJF%22%7D"></card></p><ul list="u609fb388"><li fid="ua427d805" data-lake-id="u8323a491" id="u8323a491"><span data-lake-id="u449603b3" id="u449603b3">现在，人类偏好数据的概率已经由最优策略而非奖励模型表示，因此可以为参数化策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F7fbcd62054bd83770c4508841ae9c9a4.svg%22%2C%22id%22%3A%22zc0fW%22%7D"></card><span data-lake-id="u3d1abe73" id="u3d1abe73">构建最大似然目标</span></li></ul><p data-lake-id="ue985d701" id="ue985d701" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Cmathrm%7BDPO%7D%7D(%5C%5Cpi_%5C%5Ctheta%3B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D)%3D-%5C%5Cmathbb%7BE%7D_%7B(x%2Cy_w%2Cy_l)%5C%5Csim%5C%5Cmathcal%7BD%7D%7D%5C%5Cleft%5B%5C%5Clog%5C%5Csigma%5C%5Cleft(%5C%5Cbeta%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(y_w%5C%5Cmid%20x)%7D%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y_w%5C%5Cmid%20x)%7D-%5C%5Cbeta%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(y_l%5C%5Cmid%20x)%7D%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y_l%5C%5Cmid%20x)%7D%5C%5Cright)%5C%5Cright%5D.%20%5C%5Ctag%7B7%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4cbc70a326a9aee8be520c95d35e794b.svg%22%2C%22id%22%3A%22vlPVi%22%7D"></card></p><ul list="u349367fa"><li fid="u2348b923" data-lake-id="u79efbda4" id="u79efbda4"><span data-lake-id="ue3803704" id="ue3803704">通过这种方式，既绕过显式奖励建模步骤，也避免强化学习优化。此外，由于该过程等价于拟合一个经过重参数化的 Bradley–Terry 模型，因此具有一定的理论性质，例如在偏好数据分布满足适当假设时的一致性</span></li></ul><p data-lake-id="u334c1a55" id="u334c1a55" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790663461101-ce6b8ff7-7172-4e4a-aee7-967da1cecff6.png%22%2C%22taskId%22%3A%22uddc32a7a-707c-41ed-bd88-3e3155c2a13%22%2C%22clientId%22%3A%22uaddee205-df9c-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A771%2C%22height%22%3A234%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A241428%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1481%2C%22originHeight%22%3A450%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22PROMPT%2BCHOSEN%22%2C%22x%22%3A40%2C%22y%22%3A182%2C%22width%22%3A214%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22%E8%8D%B7%22%2C%22x%22%3A380%2C%22y%22%3A330%2C%22width%22%3A138%2C%22height%22%3A81%7D%2C%7B%22text%22%3A%22UPDATEWEIGHTS%22%2C%22x%22%3A825%2C%22y%22%3A48%2C%22width%22%3A209%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22EIECTEDSCORE%22%2C%22x%22%3A1073%2C%22y%22%3A401%2C%22width%22%3A181%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22EJIECTEDSCORE%22%2C%22x%22%3A597%2C%22y%22%3A403%2C%22width%22%3A196%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22CHOSENSCORE%22%2C%22x%22%3A599%2C%22y%22%3A356%2C%22width%22%3A174%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22CHOSENSCORE%22%2C%22x%22%3A593%2C%22y%22%3A88%2C%22width%22%3A180%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22PROMPT%2BREJECTED%22%2C%22x%22%3A30%2C%22y%22%3A291%2C%22width%22%3A237%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22HREFERENCE%22%2C%22x%22%3A902%2C%22y%22%3A385%2C%22width%22%3A154%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22REECFEDSCORE%22%2C%22x%22%3A578%2C%22y%22%3A139%2C%22width%22%3A211%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22TRAINEDLM%22%2C%22x%22%3A392%2C%22y%22%3A24%2C%22width%22%3A163%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22REJECTEDSCORE%22%2C%22x%22%3A1043%2C%22y%22%3A137%2C%22width%22%3A198%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22CHOSEMSCORE%22%2C%22x%22%3A1078%2C%22y%22%3A360%2C%22width%22%3A166%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22FROZENLM%22%2C%22x%22%3A390%2C%22y%22%3A291%2C%22width%22%3A161%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%22CHOSEMSCORE%22%2C%22x%22%3A1059%2C%22y%22%3A94%2C%22width%22%3A171%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22IPOLICY%22%2C%22x%22%3A1213%2C%22y%22%3A232%2C%22width%22%3A87%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22KPOLICY%22%2C%22x%22%3A928%2C%22y%22%3A120%2C%22width%22%3A92%2C%22height%22%3A28%7D%2C%7B%22text%22%3A%22REFEREMC%22%2C%22x%22%3A1207%2C%22y%22%3A280%2C%22width%22%3A98%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22%E5%93%81%22%2C%22x%22%3A445%2C%22y%22%3A97%2C%22width%22%3A55%2C%22height%22%3A80%7D%2C%7B%22text%22%3A%22%3D-10G%22%2C%22x%22%3A952%2C%22y%22%3A248%2C%22width%22%3A95%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22L0SS-%22%2C%22x%22%3A890%2C%22y%22%3A250%2C%22width%22%3A76%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22.10G%22%2C%22x%22%3A1113%2C%22y%22%3A249%2C%22width%22%3A63%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22O%E4%B8%89%22%2C%22x%22%3A1019%2C%22y%22%3A383%2C%22width%22%3A62%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22RE%22%2C%22x%22%3A1188%2C%22y%22%3A270%2C%22width%22%3A48%2C%22height%22%3A22%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f4f2f0%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22u40d5db45%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><p data-lake-id="u28f70a3c" id="u28f70a3c"><strong><span data-lake-id="uf5845d12" id="uf5845d12" style="color: #E4495B">DPO 更新的作用：为理解 DPO 的作用机制，可以分析损失函数</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Cmathrm%7BDPO%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff4541b86be9f708b13448a05c02313b3.svg%22%2C%22id%22%3A%22XKBXP%22%7D" style="color: #E4495B"></card><strong><span data-lake-id="uc0f0180d" id="uc0f0180d" style="color: #E4495B">的梯度。其关于参数</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fed5a4aa5e092e303a69c608582c70db9.svg%22%2C%22id%22%3A%22bzmYf%22%7D" style="color: #E4495B"></card><strong><span data-lake-id="u4d85dd98" id="u4d85dd98" style="color: #E4495B">的梯度可写为</span></strong></p><p data-lake-id="u9d9ed6d9" id="u9d9ed6d9" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cnabla_%5C%5Ctheta%5C%5Cmathcal%7BL%7D_%7B%5C%5Cmathrm%7BDPO%7D%7D(%5C%5Cpi_%5C%5Ctheta%3B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D)%3D-%5C%5Cbeta%5C%5Cmathbb%7BE%7D_%7B(x%2Cy_w%2Cy_l)%5C%5Csim%5C%5Cmathcal%7BD%7D%7D%5C%5Cleft%5B%5C%5Cunderbrace%7B%5C%5Csigma%5C%5Cleft(%5C%5Chat%7Br%7D_%5C%5Ctheta(x%2Cy_l)-%5C%5Chat%7Br%7D_%5C%5Ctheta(x%2Cy_w)%5C%5Cright)%7D_%7B%5C%5Ctext%7B%E5%A5%96%E5%8A%B1%E4%BC%B0%E8%AE%A1%E9%94%99%E8%AF%AF%E6%97%B6%E6%9D%83%E9%87%8D%E6%9B%B4%E9%AB%98%7D%7D%5C%5Cleft%5B%5C%5Cunderbrace%7B%5C%5Cnabla_%5C%5Ctheta%5C%5Clog%5C%5Cpi(y_w%5C%5Cmid%20x)%7D_%7B%5C%5Ctext%7B%E6%8F%90%E9%AB%98%20%7Dy_w%5C%5Ctext%7B%20%E7%9A%84%E4%BC%BC%E7%84%B6%7D%7D-%5C%5Cunderbrace%7B%5C%5Cnabla_%5C%5Ctheta%5C%5Clog%5C%5Cpi(y_l%5C%5Cmid%20x)%7D_%7B%5C%5Ctext%7B%E9%99%8D%E4%BD%8E%20%7Dy_l%5C%5Ctext%7B%20%E7%9A%84%E4%BC%BC%E7%84%B6%7D%7D%5C%5Cright%5D%5C%5Cright%5D.%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F74a0e7aa9174f9e3488db75996743f42.svg%22%2C%22id%22%3A%22p5I1S%22%7D"></card></p><ul list="ub5d18546"><li fid="u2bf05bf9" data-lake-id="u9ac61e8f" id="u9ac61e8f"><span data-lake-id="uee95130d" id="uee95130d">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7Br%7D_%5C%5Ctheta(x%2Cy)%3D%5C%5Cbeta%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(y%5C%5Cmid%20x)%7D%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(y%5C%5Cmid%20x)%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fd77d1ff79f06c10c6925a3b0bf45520c.svg%22%2C%22id%22%3A%22wgDgc%22%7D"></card><span data-lake-id="ucae2408b" id="ucae2408b">是由语言模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F7fbcd62054bd83770c4508841ae9c9a4.svg%22%2C%22id%22%3A%22wc53d%22%7D"></card><span data-lake-id="ub11fbf18" id="ub11fbf18">和参考模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff73154893f2557c1227ee196e79412a6.svg%22%2C%22id%22%3A%22SVR15%22%7D"></card><span data-lake-id="uad4f4838" id="uad4f4838">隐式定义的奖励。直观而言，损失函数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Cmathrm%7BDPO%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff4541b86be9f708b13448a05c02313b3.svg%22%2C%22id%22%3A%22IOK3N%22%7D"></card><span data-lake-id="uc2b32b1a" id="uc2b32b1a">的梯度会提高偏好回答</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22y_w%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F22d3748a1a6b1a91dda986e0b204471a.svg%22%2C%22id%22%3A%22kzlCP%22%7D"></card><span data-lake-id="u6e3c3dd3" id="u6e3c3dd3">的似然，并降低非偏好回答</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22y_l%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F5940c70497dd7c00369aa6f50b3cc63b.svg%22%2C%22id%22%3A%22KHX1B%22%7D"></card><span data-lake-id="u33d227a0" id="u33d227a0">的似然</span></li><li fid="u2bf05bf9" data-lake-id="uf5d5e226" id="uf5d5e226"><span data-lake-id="u4f482142" id="u4f482142">重要的是，样本根据隐式奖励模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7Br%7D_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4ed4f97a88a7bda3cfb510323524300b.svg%22%2C%22id%22%3A%22cegCd%22%7D"></card><span data-lake-id="u9fbbd208" id="u9fbbd208">对非偏好回答的评分高出多少进行加权，并由</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6100158802e722a88c15efc101fc275b.svg%22%2C%22id%22%3A%22cpsrv%22%7D"></card><span data-lake-id="u563072cc" id="u563072cc">进行缩放；这一加权在考虑 KL 约束强度的同时，反映隐式奖励模型对回答排序的错误程度</span></li></ul><p data-lake-id="u187d6121" id="u187d6121" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790664128277-7de9bf19-2524-47fe-9106-328b3eea749d.png%22%2C%22taskId%22%3A%22uac8b5368-e137-4fa4-add0-3f7c0541e26%22%2C%22clientId%22%3A%22ud039a571-db31-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A698.6000366210938%2C%22height%22%3A385%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A466644%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1237%2C%22originHeight%22%3A682%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22CHOSEN_KL%3D(POLICY_CHOSEN_LOGPS-REFERENCE_CHOSEN_LOGPS).MEAN().CLAMP(MIN%3D0)%22%2C%22x%22%3A97%2C%22y%22%3A239%2C%22width%22%3A946%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22EIECTEDKL%3D(POLICY_REJECTEDLOGPS-REFERENCE_REJECTED_LOGPS).MEAN().CLAMP(MIN%3D0)%22%2C%22x%22%3A98%2C%22y%22%3A270%2C%22width%22%3A1020%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22N_REWARDS%3DSELF.BETA*(POLICY_CHOSEN_LOGPS-REFERENCE_C%22%2C%22x%22%3A153%2C%22y%22%3A590%2C%22width%22%3A704%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22EJECTEDREWARDS%3DSELF.BETA*(POLICY_REJECTEDLOGPS-REFERENCE_REJECTED_LOGPS)%2CDETACH()%22%2C%22x%22%3A96%2C%22y%22%3A623%2C%22width%22%3A1094%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22-%3ETUPLE%5BTORCH.FLOATTENSOR%2CTORCH.FLOATTENSOR%2CTORCH.FLOATTENSOR%5D%3B%22%2C%22x%22%3A65%2C%22y%22%3A208%2C%22width%22%3A808%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22CHOSENLOGRATIOS%3DPOLICYCHOSEN_LOGPS-REFERENCE_CHOSEN_LOGPS%22%2C%22x%22%3A98%2C%22y%22%3A302%2C%22width%22%3A771%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%221-F.SIGMOID(SELF.BETA*(CHOSEN_LOGRATIOS-REJECTED_KL))%2C%22%2C%22x%22%3A190%2C%22y%22%3A431%2C%22width%22%3A736%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%221-F.SIGMOID(SELF.BETA*(CHOSEN_KL-REJECTEDLOGRATIOS))%2C%22%2C%22x%22%3A189%2C%22y%22%3A464%2C%22width%22%3A733%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22EJECTEDLOGRATIOS%3DPOLICY_REJECTED_LOGPS-REFERENCE_REJECTED_LOGPS%22%2C%22x%22%3A97%2C%22y%22%3A335%2C%22width%22%3A837%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22RETURNLOSSES%2CCHOSENREWARDS%2CREJECTED_REWARDS%22%2C%22x%22%3A98%2C%22y%22%3A654%2C%22width%22%3A576%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22REFERENCE_CHOSEN_1OGPS%3ATORCH.FLOATTENSOR%2C%22%2C%22x%22%3A96%2C%22y%22%3A146%2C%22width%22%3A513%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22REFERENCE_REJECTED_LOGPS%3ATORCHFLOATTENSOR%2C%22%2C%22x%22%3A94%2C%22y%22%3A177%2C%22width%22%3A537%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22POLICY_REJECTED_LOGPS%3ATORCH.FLOATTENSOR%2C%22%2C%22x%22%3A98%2C%22y%22%3A115%2C%22width%22%3A497%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22OLICY_CHOSEN_1OGPS%3ATORCH.F1OATTENSOR%2C%22%2C%22x%22%3A100%2C%22y%22%3A84%2C%22width%22%3A472%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22OSSES%3DTORCH.CAT(%22%2C%22x%22%3A100%2C%22y%22%3A368%2C%22width%22%3A259%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22).MEAN)%22%2C%22x%22%3A96%2C%22y%22%3A558%2C%22width%22%3A109%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22FORWARD(%22%2C%22x%22%3A48%2C%22y%22%3A18%2C%22width%22%3A107%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22SELF%22%2C%22x%22%3A92%2C%22y%22%3A51%2C%22width%22%3A65%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%220%22%2C%22x%22%3A140%2C%22y%22%3A525%2C%22width%22%3A31%2C%22height%22%3A22%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f8f7f1%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22u797d6151%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><h1 data-lake-id="JwmO7" id="JwmO7" style="text-align: center"><span data-lake-id="u2dd0ea52" id="u2dd0ea52">☕</span><span data-lake-id="ubf09cf6d" id="ubf09cf6d"> 𝐃𝐞𝐞𝐩𝐒𝐞𝐞𝐤𝐌𝐚𝐭𝐡: 𝐏𝐮𝐬𝐡𝐢𝐧𝐠 𝐭𝐡𝐞 𝐋𝐢𝐦𝐢𝐭𝐬 𝐨𝐟 𝐌𝐚𝐭𝐡𝐞𝐦𝐚𝐭𝐢𝐜𝐚𝐥 𝐑𝐞𝐚𝐬𝐨𝐧𝐢𝐧𝐠 𝐢𝐧 𝐎𝐩𝐞𝐧 𝐋𝐚𝐧𝐠𝐮𝐚𝐠𝐞 𝐌𝐨𝐝𝐞𝐥𝐬</span></h1><p data-lake-id="u648721ac" id="u648721ac"><strong><span data-lake-id="u2af57522" id="u2af57522">本研究提出 DeepSeekMath，这是一种面向特定领域的语言模型，其数学能力显著优于开源模型，并在学术基准上接近 GPT-4 的性能水平</span></strong></p><ul list="ud3d9bbfc"><li fid="uf652f137" data-lake-id="uf4bb49da" id="uf4bb49da"><span data-lake-id="ud341fa6f" id="ud341fa6f">为实现这一目标，作者构建 DeepSeekMath Corpus，这是一个包含 120B 个数学 token 的大规模高质量预训练语料库。该数据集通过基于 fastText 的分类器从 Common Crawl中提取</span></li><li fid="uf652f137" data-lake-id="uce2076f4" id="uce2076f4"><span data-lake-id="u0b1fcf35" id="u0b1fcf35">在初始迭代中，分类器使用 OpenWebMath 中的样本作为正例，并选取多种其他网页作为负例进行训练。随后，作者使用分类器从 CC 中挖掘更多正例，并通过人工标注进一步完善这些样本，再利用改进后的数据集更新分类器，以提升其性能</span></li><li fid="uf652f137" data-lake-id="ud8c45e83" id="ud8c45e83"><span data-lake-id="u51c8363e" id="u51c8363e">评估结果表明，这一大规模语料库具有较高质量：基础模型 DeepSeekMath-Base 7B 在 GSM8K 上达到 64.2%，在竞赛级 MATH 数据集上达到 36.2%，超过 Minerva 540B</span></li></ul><p data-lake-id="u07f5b9d7" id="u07f5b9d7" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790664773703-10908ebb-a943-44b7-90e3-1c0abeeabb5f.png%22%2C%22taskId%22%3A%22u6664e7db-f8f3-4cda-aeea-5ecc836fb67%22%2C%22clientId%22%3A%22ud039a571-db31-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A659.4000244140625%2C%22height%22%3A268%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A208397%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1098%2C%22originHeight%22%3A447%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%2CDISCOYERMATH-RELATEDDOMAINS%22%2C%22x%22%3A593%2C%22y%22%3A385%2C%22width%22%3A297%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22.RECALLMATH-RELATEDWEBPAGES%22%2C%22x%22%3A593%2C%22y%22%3A42%2C%22width%22%3A283%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22DEDUPLICATEDCOMMONCRAWL%22%2C%22x%22%3A403%2C%22y%22%3A308%2C%22width%22%3A232%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%224.ANNOTATEMATH-RELATED%22%2C%22x%22%3A192%2C%22y%22%3A375%2C%22width%22%3A222%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22URLPATHFROMLABELERS%22%2C%22x%22%3A193%2C%22y%22%3A397%2C%22width%22%3A224%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22.TRAINAFASTTEXTMODEL%22%2C%22x%22%3A186%2C%22y%22%3A53%2C%22width%22%3A219%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22FROMCOMMONCRAWL%22%2C%22x%22%3A608%2C%22y%22%3A65%2C%22width%22%3A245%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%2240BHTMLLPAGES%22%2C%22x%22%3A427%2C%22y%22%3A328%2C%22width%22%3A173%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22MLATHCORPUS%22%2C%22x%22%3A966%2C%22y%22%3A309%2C%22width%22%3A88%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22MATHSEED%22%2C%22x%22%3A6%2C%22y%22%3A281%2C%22width%22%3A80%2C%22height%22%3A14%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f4f3f3%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ue3184920%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><p data-lake-id="u009ffd3d" id="u009ffd3d"><strong><span data-lake-id="u7070d9a4" id="u7070d9a4">DeepSeekMath-Base 使用 DeepSeek-Coder-Base-v1.5 7B 进行初始化，因为作者发现，与通用大语言模型相比，采用经过代码训练的模型作为起点更为合适。此外，作者观察到，数学训练也提升模型在 MMLU 和 BBH 基准上的能力，表明这种训练不仅增强模型的数学能力，也提升通用推理能力</span></strong></p><ul list="u976b1428"><li fid="u79c3c71d" data-lake-id="u5ce65c81" id="u5ce65c81"><span data-lake-id="u6889c67c" id="u6889c67c">预训练完成后，作者使用思维链、程序思维和工具集成推理数据，对 DeepSeekMath-Base 进行数学指令微调。所得模型 DeepSeekMath-Instruct 7B 超过所有同类 7B 模型，并可与 70B 规模的开源指令微调模型相媲美</span></li><li fid="u79c3c71d" data-lake-id="u042f40e5" id="u042f40e5"><span data-lake-id="u7fa6a009" id="u7fa6a009">在数学训练之前进行代码训练，能够提升模型在使用工具和不使用工具两种情况下解决数学问题的能力</span></li></ul><p data-lake-id="uf27cecb5" id="uf27cecb5"><strong><span data-lake-id="uaed97915" id="uaed97915">作者提出组相对策略优化（GRPO），这是一种高效且有效的强化学习算法。GRPO 不使用评论家模型，而是根据组内得分估计基线，与近端策略优化相比，显著降低训练资源需求</span></strong></p><ul list="ue0e33fc3"><li fid="u85e26b48" data-lake-id="uaf1e63d8" id="uaf1e63d8"><span data-lake-id="ucb5c750e" id="ucb5c750e">作者证明，仅使用指令微调数据，GRPO 即可显著提升指令微调模型 DeepSeekMath-Instruct 的性能。此外，作者还观察到，模型的域外性能在强化学习过程中有所提升</span></li><li fid="u85e26b48" data-lake-id="u27fc9f94" id="u27fc9f94"><span data-lake-id="uced4c4a2" id="uced4c4a2">作者提供一个统一范式，用于理解 RFT、DPO、PPO 和 GRPO 等不同方法。同时，作者开展广泛的实验，包括在线与离线训练、结果监督与过程监督、单轮与迭代强化学习等，以深入研究这一范式的关键要素</span></li><li fid="u85e26b48" data-lake-id="ub5e9ede7" id="ub5e9ede7"><span data-lake-id="u784ae673" id="u784ae673">基于这一统一范式，作者探索强化学习有效的原因，并总结若干潜在方向，以实现更有效的大语言模型强化学习</span></li></ul><h2 data-lake-id="lzrLP" id="lzrLP" style="text-align: center"><span data-lake-id="u7a42e5da" id="u7a42e5da">🎭</span><span data-lake-id="u9fb96ef0" id="u9fb96ef0"> 𝐆𝐫𝐨𝐮𝐩 𝐑𝐞𝐥𝐚𝐭𝐢𝐯𝐞 𝐏𝐨𝐥𝐢𝐜𝐲 𝐎𝐩𝐭𝐢𝐦𝐢𝐳𝐚𝐭𝐢𝐨𝐧</span></h2><p data-lake-id="u8cbd82e8" id="u8cbd82e8"><strong><span data-lake-id="u2b97545f" id="u2b97545f">近端策略优化是一种行动者—评论家强化学习算法，广泛应用于大语言模型的强化学习微调阶段。该算法通过最大化以下替代目标来优化大语言模型</span></strong></p><p data-lake-id="u3c435576" id="u3c435576" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BJ%7D_%7B%5C%5Cmathrm%7BPPO%7D%7D(%5C%5Ctheta)%3D%5C%5Cmathbb%7BE%7D%5C%5Cleft%5Bq%5C%5Csim%20P(Q)%2Co%5C%5Csim%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(O%7Cq)%5C%5Cright%5D%5C%5Cfrac%7B1%7D%7B%7Co%7C%7D%5C%5Csum_%7Bt%3D1%7D%5E%7B%7Co%7C%7D%5C%5Cmin%5C%5Cleft%5B%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(o_t%7Cq%2Co_%7B%3Ct%7D)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(o_t%7Cq%2Co_%7B%3Ct%7D)%7DA_t%2C%5C%5Coperatorname%7Bclip%7D%5C%5Cleft(%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(o_t%7Cq%2Co_%7B%3Ct%7D)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(o_t%7Cq%2Co_%7B%3Ct%7D)%7D%2C1-%5C%5Cvarepsilon%2C1%2B%5C%5Cvarepsilon%5C%5Cright)A_t%5C%5Cright%5D.%5C%5Ctag%7B1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F57b72c2e13a7d9ce40b9f684488196e1.svg%22%2C%22id%22%3A%22Rd9O4%22%7D"></card></p><ul list="u4f2b269c"><li fid="ueca345f3" data-lake-id="u5a76f388" id="u5a76f388"><span data-lake-id="ufbc71ddd" id="ufbc71ddd">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F7fbcd62054bd83770c4508841ae9c9a4.svg%22%2C%22id%22%3A%22CXOR0%22%7D"></card><span data-lake-id="ua9d5332c" id="ua9d5332c">和</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F619756aa1fc9995330d2f111c852dc8f.svg%22%2C%22id%22%3A%22tVyYR%22%7D"></card><span data-lake-id="ucae4f1fc" id="ucae4f1fc">分别为当前策略模型和旧策略模型，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22q%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F34c7b563b30bde3c748139530686798e.svg%22%2C%22id%22%3A%22f6iSo%22%7D"></card><span data-lake-id="u80a3dbe2" id="u80a3dbe2">和</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22o%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9de45c8b7ecba9ca54563fd290ba1ba4.svg%22%2C%22id%22%3A%22n1Cce%22%7D"></card><span data-lake-id="ud3365a01" id="ud3365a01">分别是从问题数据集和旧策略</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F619756aa1fc9995330d2f111c852dc8f.svg%22%2C%22id%22%3A%22tya5s%22%7D"></card><span data-lake-id="ueb8f6e71" id="ueb8f6e71">中采样得到的问题与输出。</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cvarepsilon%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc57c5f0e31d8960d9406bb149fced9e0.svg%22%2C%22id%22%3A%22XEv2q%22%7D"></card><span data-lake-id="ud474846f" id="ud474846f">是 PPO 中为稳定训练而引入的裁剪相关超参数。</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22A_t%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F5a6f6c8d04e460853d32c4a58b737185.svg%22%2C%22id%22%3A%22SYLHI%22%7D"></card><span data-lake-id="uac0dfbf9" id="uac0dfbf9">为优势，通过广义优势估计，基于奖励</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7Br_%7B%5C%5Cge%20t%7D%5C%5C%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9b65ea227957bedeab3af0081c2ed946.svg%22%2C%22id%22%3A%22Hv7dE%22%7D"></card><span data-lake-id="u96ead34b" id="u96ead34b">和学习得到的价值函数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22V_%5C%5Cpsi%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6b06d3157180f53875c495fd40bc9d17.svg%22%2C%22id%22%3A%22dKTcA%22%7D"></card><span data-lake-id="u5de4b888" id="u5de4b888">计算</span></li><li fid="ueca345f3" data-lake-id="ue610803b" id="ue610803b"><span data-lake-id="u702536b6" id="u702536b6">因此，在 PPO 中，需要在训练策略模型的同时训练价值函数。为缓解对奖励模型的过度优化，标准做法是在每个 token 的奖励中加入相对于参考模型的 token 级 KL 惩罚，即：</span></li></ul><p data-lake-id="u023bd5fc" id="u023bd5fc" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22r_t%3Dr_%5C%5Cvarphi(q%2Co_%7B%3Ct%7D)-%5C%5Cbeta%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(o_t%7Cq%2Co_%7B%3Ct%7D)%7D%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(o_t%7Cq%2Co_%7B%3Ct%7D)%7D.%5C%5Ctag%7B2%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F8edbb3eda7062579740ed47cc1c37853.svg%22%2C%22id%22%3A%22xaUMp%22%7D"></card></p><ul list="u0904eb86"><li fid="u8b1e6af7" data-lake-id="u8b22d5e1" id="u8b22d5e1"><span data-lake-id="uc470b10e" id="uc470b10e">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22r_%5C%5Cvarphi%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F07ca128652d4c1b9101bfacd04d58aee.svg%22%2C%22id%22%3A%22qC2jC%22%7D"></card><span data-lake-id="u7046239c" id="u7046239c">为奖励模型，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff73154893f2557c1227ee196e79412a6.svg%22%2C%22id%22%3A%22BweyY%22%7D"></card><span data-lake-id="u8bb88775" id="u8bb88775">为参考模型，通常是初始 SFT 模型，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6100158802e722a88c15efc101fc275b.svg%22%2C%22id%22%3A%22qjpSF%22%7D"></card><span data-lake-id="ue74cdc62" id="ue74cdc62">为 KL 惩罚系数</span></li></ul><p data-lake-id="ue7238f99" id="ue7238f99"><strong><span data-lake-id="u309180e4" id="u309180e4" style="color: #663000">由于 PPO 中使用的价值函数通常由另一个与策略模型规模相当的模型表示，因此会带来较大的显存和计算负担。此外，在强化学习训练中，价值函数作为优势计算中的基线，用于降低方差。然而，在大语言模型场景下，奖励模型通常仅为最后一个 token 分配奖励分数，这可能增加训练一个能够在每个 token 上进行准确估计的价值函数的难度</span></strong></p><p data-lake-id="ubd5f1bca" id="ubd5f1bca"><strong><span data-lake-id="u0beade5b" id="u0beade5b">作者提出组相对策略优化。该方法不再需要像 PPO 那样额外学习价值函数近似，而是使用针对同一问题采样得到的多个输出的平均奖励作为基线。具体而言，对于每个问题</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22q%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F34c7b563b30bde3c748139530686798e.svg%22%2C%22id%22%3A%22fcgu9%22%7D"></card><strong><span data-lake-id="ufa320618" id="ufa320618">，GRPO 从旧策略</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F619756aa1fc9995330d2f111c852dc8f.svg%22%2C%22id%22%3A%22hWc8e%22%7D"></card><strong><span data-lake-id="u5020d5f3" id="u5020d5f3">中采样一组输出</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7Bo_1%2Co_2%2C%5C%5Cldots%2Co_G%5C%5C%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9b666f4c22de9ec61dcea1ae141177c4.svg%22%2C%22id%22%3A%22OfwMC%22%7D"></card><strong><span data-lake-id="u7b479b4c" id="u7b479b4c">，随后通过最大化以下目标优化策略模型</span></strong></p><p data-lake-id="u6f04de4d" id="u6f04de4d" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BJ%7D_%7B%5C%5Cmathrm%7BGRPO%7D%7D(%5C%5Ctheta)%3D%5C%5Cmathbb%7BE%7D%5C%5Cleft%5Bq%5C%5Csim%20P(Q)%2C%5C%5C%7Bo_i%5C%5C%7D_%7Bi%3D1%7D%5E%7BG%7D%5C%5Csim%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(O%7Cq)%5C%5Cright%5D%5C%5Cfrac%7B1%7D%7BG%7D%5C%5Csum_%7Bi%3D1%7D%5E%7BG%7D%5C%5Cfrac%7B1%7D%7B%7Co_i%7C%7D%5C%5Csum_%7Bt%3D1%7D%5E%7B%7Co_i%7C%7D%5C%5Cleft%5C%5C%7B%5C%5Cmin%5C%5Cleft%5B%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D%5C%5Chat%7BA%7D_%7Bi%2Ct%7D%2C%5C%5Coperatorname%7Bclip%7D%5C%5Cleft(%5C%5Cfrac%7B%5C%5Cpi_%5C%5Ctheta(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D%7B%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D%2C1-%5C%5Cvarepsilon%2C1%2B%5C%5Cvarepsilon%5C%5Cright)%5C%5Chat%7BA%7D_%7Bi%2Ct%7D%5C%5Cright%5D-%5C%5Cbeta%5C%5Cmathbb%7BD%7D_%7B%5C%5Cmathrm%7BKL%7D%7D%5C%5Cleft%5B%5C%5Cpi_%5C%5Ctheta%5C%5C%7C%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%5C%5Cright%5D%5C%5Cright%5C%5C%7D.%5C%5Ctag%7B3%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6383761ae5262ff37d0680a4b08bd916.svg%22%2C%22id%22%3A%22JNe8n%22%7D"></card></p><ul list="u3e765b88"><li fid="u01921a98" data-lake-id="u8db6d7b9" id="u8db6d7b9"><span data-lake-id="uc2b003a1" id="uc2b003a1">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cvarepsilon%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc57c5f0e31d8960d9406bb149fced9e0.svg%22%2C%22id%22%3A%22QWwEs%22%7D"></card><span data-lake-id="u1d82c017" id="u1d82c017">和</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6100158802e722a88c15efc101fc275b.svg%22%2C%22id%22%3A%22QsdMM%22%7D"></card><span data-lake-id="u2c730c52" id="u2c730c52">为超参数，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7BA%7D_%7Bi%2Ct%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ffdce45ca5677173b00cc357bb6a508cd.svg%22%2C%22id%22%3A%22rYsK5%22%7D"></card><span data-lake-id="u9d470c2e" id="u9d470c2e">是仅根据各组内部输出的相对奖励计算得到的优势。GRPO 采用组内相对关系计算优势，这与奖励模型的比较性质相契合，因为奖励模型通常使用同一问题下不同输出之间的比较数据进行训练。</span><strong><span data-lake-id="u1050a372" id="u1050a372" style="color: #AE146E">此外，GRPO 并不在奖励中加入 KL 惩罚，而是直接在损失中加入训练策略与参考策略之间的 KL 散度进行正则化，从而避免使</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7BA%7D_%7Bi%2Ct%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ffdce45ca5677173b00cc357bb6a508cd.svg%22%2C%22id%22%3A%22XCymY%22%7D" style="color: #AE146E"></card><strong><span data-lake-id="uf0632ecb" id="uf0632ecb" style="color: #AE146E">的计算复杂化。</span></strong><span data-lake-id="u17c48066" id="u17c48066">作者采用以下无偏估计量估计 KL 散度</span></li></ul><p data-lake-id="u26601f8b" id="u26601f8b" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathbb%7BD%7D_%7B%5C%5Cmathrm%7BKL%7D%7D%5C%5Cleft%5B%5C%5Cpi_%5C%5Ctheta%5C%5C%7C%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D%5C%5Cright%5D%3D%5C%5Cfrac%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D%7B%5C%5Cpi_%5C%5Ctheta(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D-%5C%5Clog%5C%5Cfrac%7B%5C%5Cpi_%7B%5C%5Cmathrm%7Bref%7D%7D(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D%7B%5C%5Cpi_%5C%5Ctheta(o_%7Bi%2Ct%7D%7Cq%2Co_%7Bi%2C%3Ct%7D)%7D-1.%5C%5Ctag%7B4%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6216b518095f2aa845f72652865a402c.svg%22%2C%22id%22%3A%22mMiJb%22%7D"></card></p><p data-lake-id="u2d16f17c" id="u2d16f17c" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790666104268-e48b8a1e-4e79-4115-802f-ca298cc043f3.png%22%2C%22taskId%22%3A%22u094f094f-6de7-4cbe-986e-cb09ee9dca5%22%2C%22clientId%22%3A%22uc818d4cb-ad1a-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A748%2C%22height%22%3A323%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A104193%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1000%2C%22originHeight%22%3A432%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22REFERENCE%22%2C%22x%22%3A394%2C%22y%22%3A32%2C%22width%22%3A87%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22REFERENCE%22%2C%22x%22%3A391%2C%22y%22%3A263%2C%22width%22%3A86%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22REWARD%22%2C%22x%22%3A402%2C%22y%22%3A88%2C%22width%22%3A67%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22REWARD%22%2C%22x%22%3A399%2C%22y%22%3A320%2C%22width%22%3A64%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22MODELS%22%2C%22x%22%3A893%2C%22y%22%3A259%2C%22width%22%3A65%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22OMPUTATION%22%2C%22x%22%3A636%2C%22y%22%3A339%2C%22width%22%3A81%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22PPO%22%2C%22x%22%3A41%2C%22y%22%3A59%2C%22width%22%3A60%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A405%2C%22y%22%3A169%2C%22width%22%3A59%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A152%2C%22y%22%3A134%2C%22width%22%3A56%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22TRAINED%22%2C%22x%22%3A893%2C%22y%22%3A156%2C%22width%22%3A65%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22GRPO%22%2C%22x%22%3A33%2C%22y%22%3A239%2C%22width%22%3A86%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22MODELS%22%2C%22x%22%3A894%2C%22y%22%3A180%2C%22width%22%3A63%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A404%2C%22y%22%3A342%2C%22width%22%3A60%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22VALUE%22%2C%22x%22%3A410%2C%22y%22%3A145%2C%22width%22%3A52%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22POLICY%22%2C%22x%22%3A155%2C%22y%22%3A319%2C%22width%22%3A49%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22FROZEN%22%2C%22x%22%3A893%2C%22y%22%3A237%2C%22width%22%3A61%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A398%2C%22y%22%3A54%2C%22width%22%3A75%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A396%2C%22y%22%3A287%2C%22width%22%3A65%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22GROUP%22%2C%22x%22%3A648%2C%22y%22%3A319%2C%22width%22%3A56%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22MODEL%22%2C%22x%22%3A403%2C%22y%22%3A111%2C%22width%22%3A61%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22MODLEL%22%2C%22x%22%3A154%2C%22y%22%3A342%2C%22width%22%3A51%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22KL%22%2C%22x%22%3A391%2C%22y%22%3A234%2C%22width%22%3A38%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22POLICY%22%2C%22x%22%3A151%2C%22y%22%3A110%2C%22width%22%3A56%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22GAE%22%2C%22x%22%3A658%2C%22y%22%3A111%2C%22width%22%3A46%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22A1%22%2C%22x%22%3A761%2C%22y%22%3A272%2C%22width%22%3A35%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%2271%22%2C%22x%22%3A558%2C%22y%22%3A277%2C%22width%22%3A27%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A510%2C%22y%22%3A64%2C%22width%22%3A43%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%220C%22%2C%22x%22%3A294%2C%22y%22%3A382%2C%22width%22%3A30%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22KL%22%2C%22x%22%3A485%2C%22y%22%3A33%2C%22width%22%3A45%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22T2%22%2C%22x%22%3A557%2C%22y%22%3A322%2C%22width%22%3A34%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%2201%22%2C%22x%22%3A295%2C%22y%22%3A277%2C%22width%22%3A29%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%2266%22%2C%22x%22%3A556%2C%22y%22%3A358%2C%22width%22%3A26%2C%22height%22%3A9%7D%2C%7B%22text%22%3A%2202%22%2C%22x%22%3A293%2C%22y%22%3A323%2C%22width%22%3A32%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22TG%22%2C%22x%22%3A552%2C%22y%22%3A384%2C%22width%22%3A40%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22AG%22%2C%22x%22%3A764%2C%22y%22%3A386%2C%22width%22%3A31%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22A2%22%2C%22x%22%3A764%2C%22y%22%3A322%2C%22width%22%3A29%2C%22height%22%3A21%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f7f6f4%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22u901cc727%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p><p data-lake-id="u29f7cf85" id="u29f7cf85"><strong><span data-lake-id="u4685723f" id="u4685723f">对于每个问题</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22q%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F34c7b563b30bde3c748139530686798e.svg%22%2C%22id%22%3A%22QItsL%22%7D"></card><strong><span data-lake-id="ub082f84a" id="ub082f84a">，从旧策略模型</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cpi_%7B%5C%5Ctheta_%7B%5C%5Cmathrm%7Bold%7D%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F619756aa1fc9995330d2f111c852dc8f.svg%22%2C%22id%22%3A%22veTz2%22%7D"></card><strong><span data-lake-id="ufb553c1c" id="ufb553c1c">中采样一组输出</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7Bo_1%2Co_2%2C%5C%5Cldots%2Co_G%5C%5C%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9b666f4c22de9ec61dcea1ae141177c4.svg%22%2C%22id%22%3A%22iBL5y%22%7D"></card><strong><span data-lake-id="u6945b6c4" id="u6945b6c4">。使用奖励模型对这些输出评分，得到</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22G%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff8df64a4bfdeb9bdcbc357668b6fb123.svg%22%2C%22id%22%3A%22rlbF9%22%7D"></card><strong><span data-lake-id="u8d015347" id="u8d015347">个奖励 </span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathbf%7Br%7D%3D%5C%5C%7Br_1%2Cr_2%2C%5C%5Cldots%2Cr_G%5C%5C%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fadf5248902ab46d5da06691a271aa662.svg%22%2C%22id%22%3A%22PIOJb%22%7D"></card></p><ul list="uc83f4c28"><li fid="u104b8fca" data-lake-id="ua25cd491" id="ua25cd491"><span data-lake-id="u6112f742" id="u6112f742">接着，通过减去组内均值并除以组内标准差，对这些奖励进行归一化。结果监督在每个输出</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22o_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fa83a759aaa1325691ed08b7a45368d91.svg%22%2C%22id%22%3A%22NtyNE%22%7D"></card><span data-lake-id="ubb3be3f2" id="ubb3be3f2">的末尾提供归一化奖励，并将该输出中所有 token 的优势</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7BA%7D_%7Bi%2Ct%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ffdce45ca5677173b00cc357bb6a508cd.svg%22%2C%22id%22%3A%22XC4dl%22%7D"></card><span data-lake-id="uddb803b7" id="uddb803b7">均设为这一归一化奖励，即</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7BA%7D_%7Bi%2Ct%7D%3D%5C%5Ctilde%7Br%7D_i%3D%5C%5Cfrac%7Br_i-%5C%5Coperatorname%7Bmean%7D(%5C%5Cmathbf%7Br%7D)%7D%7B%5C%5Coperatorname%7Bstd%7D(%5C%5Cmathbf%7Br%7D)%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F263b50359973c203f9ceb96b9128d191.svg%22%2C%22id%22%3A%22C5G6p%22%7D"></card><span data-lake-id="ub91d4ec8" id="ub91d4ec8">，随后通过最大化公式（3）定义的目标优化策略</span></li></ul><p data-lake-id="uee39ed06" id="uee39ed06"><strong><span data-lake-id="u6485c308" id="u6485c308">使用过程奖励模型对输出中的每个步骤评分，得到相应奖励</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathbf%7BR%7D%3D%5C%5C%7B%5C%5C%7Br_1%5E%7B%5C%5Coperatorname%7Bindex%7D(1)%7D%2C%5C%5Cldots%2Cr_1%5E%7B%5C%5Coperatorname%7Bindex%7D(K_1)%7D%5C%5C%7D%2C%5C%5Cldots%2C%5C%5C%7Br_G%5E%7B%5C%5Coperatorname%7Bindex%7D(1)%7D%2C%5C%5Cldots%2Cr_G%5E%7B%5C%5Coperatorname%7Bindex%7D(K_G)%7D%5C%5C%7D%5C%5C%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff5648f451055898b69e28bfe296fcec0.svg%22%2C%22id%22%3A%22Yocf3%22%7D"></card></p><ul list="u4f0102e9"><li fid="u63b3fdca" data-lake-id="u8bea2bdc" id="u8bea2bdc"><span data-lake-id="u815caec9" id="u815caec9">其中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Coperatorname%7Bindex%7D(j)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb5fe3fa28ce936f50cc8161ca0617ff0.svg%22%2C%22id%22%3A%22mKllk%22%7D"></card><span data-lake-id="u413219a8" id="u413219a8">为第</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22j%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F036441a335dd85c838f76d63a3db2363.svg%22%2C%22id%22%3A%22bArna%22%7D"></card><span data-lake-id="uf9007cb6" id="uf9007cb6">个步骤末尾 token 的索引，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22K_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F19e140f0b2867cc1eb652eb0dada41ff.svg%22%2C%22id%22%3A%22orMJS%22%7D"></card><span data-lake-id="u767e59c3" id="u767e59c3">为第</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F2443fbcfeb7e85e1d62b6f5e4f27207e.svg%22%2C%22id%22%3A%22sH3CJ%22%7D"></card><span data-lake-id="ud95af890" id="ud95af890">个输出中的步骤总数</span></li><li fid="u63b3fdca" data-lake-id="u79677fa3" id="u79677fa3"><span data-lake-id="u666ff606" id="u666ff606">作者同样使用均值和标准差对这些奖励进行归一化，即</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Ctilde%7Br%7D_i%5E%7B%5C%5Coperatorname%7Bindex%7D(j)%7D%3D%5C%5Cfrac%7Br_i%5E%7B%5C%5Coperatorname%7Bindex%7D(j)%7D-%5C%5Coperatorname%7Bmean%7D(%5C%5Cmathbf%7BR%7D)%7D%7B%5C%5Coperatorname%7Bstd%7D(%5C%5Cmathbf%7BR%7D)%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F8e51fc4829e6bbd0f4a4c9a2a1340623.svg%22%2C%22id%22%3A%22FJh0x%22%7D"></card><span data-lake-id="u23130e22" id="u23130e22">。随后，过程监督将每个 token 的优势计算为后续步骤归一化奖励之和，即</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7BA%7D_%7Bi%2Ct%7D%3D%5C%5Csum_%7B%5C%5Coperatorname%7Bindex%7D(j)%5C%5Cge%20t%7D%5C%5Ctilde%7Br%7D_i%5E%7B%5C%5Coperatorname%7Bindex%7D(j)%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff0e65a6fec1810e8a57ae530876844aa.svg%22%2C%22id%22%3A%22Py3qX%22%7D"></card><span data-lake-id="ue1b83ca0" id="ue1b83ca0">，再通过最大化公式（3）定义的目标优化策略</span></li></ul><p data-lake-id="uf68cc5c6" id="uf68cc5c6"><strong><span data-lake-id="u6e693959" id="u6e693959" style="color: #663000">随着强化学习训练的推进，旧奖励模型可能不足以监督当前策略模型。因此，作者还探索使用 GRPO 进行迭代强化学习。如算法 1 所示，在迭代 GRPO 中，作者根据策略模型的采样结果，为奖励模型生成新的训练集，并采用包含 10% 历史数据的回放机制，继续训练旧奖励模型。随后，以策略模型作为参考模型，并使用新的奖励模型继续训练策略模型</span></strong></p><p data-lake-id="uef20e406" id="uef20e406" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1790666137022-cce45dfc-5036-4514-856a-78d51a3f76af.png%22%2C%22taskId%22%3A%22u7ddcdd0d-e308-48b7-9130-2a853cad05f%22%2C%22clientId%22%3A%22uc818d4cb-ad1a-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A756.7999877929688%2C%22height%22%3A330%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A224288%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1056%2C%22originHeight%22%3A460%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22NPUTINITIALPOLICYMODELTE.%2CREWARDMODELSR%3BTASKPROMPTSDHYPERPARAMETERSE%2CB%2CP%22%2C%22x%22%3A25%2C%22y%22%3A47%2C%22width%22%3A912%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22COMPUTEREWARDSR%2CFOREACHSAMPLEDOUTPUTOBYRUNNNGRO%22%2C%22x%22%3A125%2C%22y%22%3A271%2C%22width%22%3A672%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22COMPUTEAFORTHET-THTOKENOFOTHROUGHGROUPRELATIVEADVANTAGEESIMATION.%22%2C%22x%22%3A128%2C%22y%22%3A302%2C%22width%22%3A810%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22UPDATETHEPOLICYMODELTEBYMAXIMIZINGTHEGRPOOBJECTIVE(EQUATION21)%22%2C%22x%22%3A160%2C%22y%22%3A354%2C%22width%22%3A777%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22UPDATERTHROUGHCONTINUOUSTRAININGUSINGAREPLAYMECHANISM.%22%2C%22x%22%3A91%2C%22y%22%3A388%2C%22width%22%3A668%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22LGORITHM1ITERATIVEGROUPRELATIVEPOLICYOPTIMIZATION%22%2C%22x%22%3A33%2C%22y%22%3A14%2C%22width%22%3A626%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22SAMPLEGOUTPUTSO%2C~E(.G)FOREACHQUESTIONG%22%2C%22x%22%3A128%2C%22y%22%3A243%2C%22width%22%3A558%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A32%2C%22y%22%3A160%2C%22width%22%3A26%2C%22height%22%3A219%7D%2C%7B%22text%22%3A%22UPDATETHEOLDPOLICYMODELE%2CE%22%2C%22x%22%3A129%2C%22y%22%3A216%2C%22width%22%3A410%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22ORGRPOITERATION%3D1%2C..%2C%2CDO%22%2C%22x%22%3A131%2C%22y%22%3A327%2C%22width%22%3A612%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22%3APOLICYMODELEE%22%2C%22x%22%3A38%2C%22y%22%3A83%2C%22width%22%3A271%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22SAMPLEABATCHDFROMD%22%2C%22x%22%3A119%2C%22y%22%3A189%2C%22width%22%3A284%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22REFERENCEMODELRER%22%2C%22x%22%3A86%2C%22y%22%3A138%2C%22width%22%3A264%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22FORITERATION%3D1%2C...%2CLDO%22%2C%22x%22%3A46%2C%22y%22%3A108%2C%22width%22%3A263%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22FORSTEP%3DL...MDO%22%2C%22x%22%3A96%2C%22y%22%3A162%2C%22width%22%3A253%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22OUTPUTE%22%2C%22x%22%3A25%2C%22y%22%3A426%2C%22width%22%3A114%2C%22height%22%3A19%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f7f5f3%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22uc238bb48%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card></p>