https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe1f9575d854d5fa5337d5976bf75c0eb.svg%22%2C%22id%22%3A%22vExkj%22%7D"></card><span data-lake-id="uc0fde509" id="uc0fde509">个时间步</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7Bt_i%5C%5C%7D_%7Bi%3D0%7D%5EM%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4124070c1c6f31c0122f875402add15d.svg%22%2C%22id%22%3A%22zEGRY%22%7D"></card><span data-lake-id="u0833a361" id="u0833a361">。从</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Ctilde%7Bx%7D_%7Bt_0%7D%3Dx_T%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4c8de2c99f03f56ed17154c550b2ca4b.svg%22%2C%22id%22%3A%22P5MdC%22%7D"></card><span data-lake-id="uf79afd59" id="uf79afd59">开始，序列</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7B%5C%5Ctilde%7Bx%7D_%7Bt_i%7D%5C%5C%7D_%7Bi%3D1%7D%5EM%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdd627626a73f10fdadbec529d3ce4114.svg%22%2C%22id%22%3A%22abU0J%22%7D"></card><span data-lake-id="u4986f6ef" id="u4986f6ef">按如下方式迭代计算：</span></p><p data-lake-id="ua537be4c" id="ua537be4c" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cboxed%7B%20%5C%5Ctilde%7B%5C%5Cboldsymbol%7Bx%7D%7D_%7Bt_i%7D%20%3D%20%5C%5Cfrac%7B%5C%5Calpha_%7Bt_i%7D%7D%7B%5C%5Calpha_%7Bt_%7Bi-1%7D%7D%7D%20%5C%5Ctilde%7B%5C%5Cboldsymbol%7Bx%7D%7D_%7Bt_%7Bi-1%7D%7D%20-%20%5C%5Csigma_%7Bt_i%7D(e%5E%7Bh_i%7D%20-%201)%5C%5Cboldsymbol%7B%5C%5Cepsilon%7D_%5C%5Ctheta(%5C%5Ctilde%7B%5C%5Cboldsymbol%7Bx%7D%7D_%7Bt_%7Bi-1%7D%7D%2C%20t_%7Bi-1%7D)%2C%20%5C%5Cquad%20%5C%5Ctext%7Bwhere%20%7D%20h_i%20%3D%20%5C%5Clambda_%7Bt_i%7D%20-%20%5C%5Clambda_%7Bt_%7Bi-1%7D%7D.%20%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F40301af89107fb73cecc58d44366cbdb.svg%22%2C%22id%22%3A%22DtPAL%22%7D"></card></p><p data-lake-id="u512ed79c" id="u512ed79c"><span data-lake-id="ue296f448" id="ue296f448">对于</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20k%5C%5Cge%202%20%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F78fbdf9bda514e71c5797618d604c0cf.svg%22%2C%22id%22%3A%22iAVUm%22%7D"></card><span data-lake-id="u7edb10c9" id="u7edb10c9">的情形，为近似泰勒展开中的前</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22k%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdf976ff7fcf17d60490267d18a1e3996.svg%22%2C%22id%22%3A%22MC7Iq%22%7D"></card><span data-lake-id="u482a1350" id="u482a1350">项，通常需要在</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fcead1760d9d5723460c4b8d4028f113a.svg%22%2C%22id%22%3A%22t0zQd%22%7D"></card><span data-lake-id="ufb9fe21b" id="ufb9fe21b">与</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20s%20%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff9261195b80f1b9af50374a127ee672e.svg%22%2C%22id%22%3A%22k2r4w%22%7D"></card><span data-lake-id="u48a94a9d" id="u48a94a9d">之间引入额外的中间点</span></p><p data-lake-id="u5b58ce20" id="u5b58ce20" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1776694046016-bde6006a-fe07-4cd8-823e-00a7966b3f01.png%22%2C%22taskId%22%3A%22u8abc59a1-0d34-465d-bc14-63d3bdbeb2c%22%2C%22clientId%22%3A%22u206786fc-2339-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A691.3636474609375%2C%22height%22%3A296%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A111663%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1194%2C%22originHeight%22%3A512%2C%22ratio%22%3A1.375%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%22%2C%22x%22%3A1%2C%22y%22%3A281%2C%22width%22%3A1116%2C%22height%22%3A132%7D%2C%7B%22text%22%3A%22REQUIRE%3AINITIALVALUEWR%2CTIMESTEPST%7DO%2CMODELEE%22%2C%22x%22%3A10%2C%22y%22%3A65%2C%22width%22%3A671%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22%E8%A5%BF-%3A-0T%3A(EH-L)EO(%E8%A5%BFTI-R%2CT-I)-.(EL-LD2%22%2C%22x%22%3A245%2C%22y%22%3A379%2C%22width%22%3A790%2C%22height%22%3A43%7D%2C%7B%22text%22%3A%22ALGORITHM2DPM-SOLVER-3.%22%2C%22x%22%3A11%2C%22y%22%3A13%2C%22width%22%3A342%2C%22height%22%3A29%7D%2C%7B%22text%22%3A%22T-%2C-0S%2C(ER2HS-1)E0(0T-%2CTI-1)-A(EI-L-1D2I-%22%2C%22x%22%3A169%2C%22y%22%3A291%2C%22width%22%3A927%2C%22height%22%3A35%7D%2C%7B%22text%22%3A%22L%3A0%E4%B8%800%E5%B0%94%2CR1%E4%B8%80%E4%BA%AC%2CR2%E4%BB%81%22%2C%22x%22%3A22%2C%22y%22%3A100%2C%22width%22%3A383%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22I-1-T%E5%85%A5(%E5%85%A5T%3A_%2C%E5%8D%81R1H)%2CS2I6-T%E5%85%A5()%22%2C%22x%22%3A120%2C%22y%22%3A164%2C%22width%22%3A492%2C%22height%22%3A28%7D%2C%7B%22text%22%3A%228S2I-1)-E0(0T-1%2CTI-1)%22%2C%22x%22%3A350%2C%22y%22%3A253%2C%22width%22%3A304%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22D2I(-EE(U2I%2CS2I%22%2C%22x%22%3A101%2C%22y%22%3A344%2C%22width%22%3A233%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22A%E4%B8%80DT-1-0S2-1(EII-1)E0(0T-1%2CTI-1)%22%2C%22x%22%3A197%2C%22y%22%3A204%2C%22width%22%3A617%2C%22height%22%3A37%7D%2C%7B%22text%22%3A%222%3AFORI-1TOMD%22%2C%22x%22%3A24%2C%22y%22%3A130%2C%22width%22%3A253%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%221O%3ARETURNWT%22%2C%22x%22%3A11%2C%22y%22%3A465%2C%22width%22%3A187%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%229%3AENDFOR%22%2C%22x%22%3A20%2C%22y%22%3A433%2C%22width%22%3A137%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22U2I%E4%B8%80%E4%B8%9D0T%3A_1-0S2%22%2C%22x%22%3A94%2C%22y%22%3A297%2C%22width%22%3A312%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%22LT%2CFAUTI-%22%2C%22x%22%3A90%2C%22y%22%3A387%2C%22width%22%3A232%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%222%E5%B7%A5%E5%AE%9A%2C%22%2C%22x%22%3A186%2C%22y%22%3A200%2C%22width%22%3A193%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22E0(02I-1%2CS2I-1%22%2C%22x%22%3A218%2C%22y%22%3A255%2C%22width%22%3A210%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22D2I-1%E4%B8%80E%22%2C%22x%22%3A100%2C%22y%22%3A250%2C%22width%22%3A143%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%2202I-1%E4%B8%80%22%2C%22x%22%3A103%2C%22y%22%3A211%2C%22width%22%3A114%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%220T-1-0T%2C(EI-1)EG(%E5%85%83R%2C..T.%22%2C%22x%22%3A240%2C%22y%22%3A393%2C%22width%22%3A410%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22E0(0T%3A_1%2CTI-1%22%2C%22x%22%3A357%2C%22y%22%3A345%2C%22width%22%3A192%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%2282I-1%E4%B8%80T%E5%85%A5(%22%2C%22x%22%3A67%2C%22y%22%3A166%2C%22width%22%3A206%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22S2I-T%E5%85%A5(%E5%85%A5TI-%E5%8D%81R2HI)%22%2C%22x%22%3A470%2C%22y%22%3A167%2C%22width%22%3A302%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22T%2C_TI%22%2C%22x%22%3A225%2C%22y%22%3A222%2C%22width%22%3A114%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%228%3A%22%2C%22x%22%3A19%2C%22y%22%3A388%2C%22width%22%3A58%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22TI_1LT-1%22%2C%22x%22%3A146%2C%22y%22%3A406%2C%22width%22%3A220%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%223%3A%22%2C%22x%22%3A23%2C%22y%22%3A160%2C%22width%22%3A31%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%226%3A%22%2C%22x%22%3A20%2C%22y%22%3A297%2C%22width%22%3A42%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%225%3A%22%2C%22x%22%3A20%2C%22y%22%3A248%2C%22width%22%3A34%2C%22height%22%3A28%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f4f4f4%22%2C%22id%22%3A%22uf6e4eb2e%22%7D"></card></p><p data-lake-id="u8ced311d" id="u8ced311d"><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_%5C%5Clambda(%5C%5Ccdot)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fa3446564b4df08a82d4a65e767ebf1c6.svg%22%2C%22id%22%3A%22HzpWt%22%7D"></card><span data-lake-id="u74a94006" id="u74a94006">表示</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20%5C%5Clambda(t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F605e70c73348740385c9c6a502292318.svg%22%2C%22id%22%3A%22V75G3%22%7D"></card><span data-lake-id="uf339725c" id="uf339725c">的反函数。对于实际噪声调度，该反函数具有解析形式。在所提出的算法中，DPM-Solver-2 选取的中间点为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22(s_i%2Cu_i)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F35de5b36b25a0d547d314341cdf3ffed.svg%22%2C%22id%22%3A%22a57v2%22%7D"></card><span data-lake-id="u3978a3a0" id="u3978a3a0">，而 DPM-Solver-3 选取的中间点为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22(s_%7B2i-1%7D%2Cu_%7B2i-1%7D)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fd8b9102a198208aa14592dd51ad14b19.svg%22%2C%22id%22%3A%22Vb8IR%22%7D"></card><span data-lake-id="u32ed16f3" id="u32ed16f3">和</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22(s_%7B2i%7D%2Cu_%7B2i%7D)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F88eb7d5aafabccf8605500fdfd48c526.svg%22%2C%22id%22%3A%22BnNF4%22%7D"></card><span data-lake-id="ud8f98ddb" id="ud8f98ddb">。当</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22k%3D1%2C2%2C3%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F292c858220e042686cbe5934da388e1c.svg%22%2C%22id%22%3A%22OezsK%22%7D"></card><span data-lake-id="uba814fdc" id="uba814fdc">时，DPM-Solver-k 在每一步中分别需要进行</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22k%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdf976ff7fcf17d60490267d18a1e3996.svg%22%2C%22id%22%3A%22T23ZM%22%7D"></card><span data-lake-id="u0c736a40" id="u0c736a40">次函数评估。尽管高阶求解器的单步计算代价更高，但由于其具有更高的收敛阶，通常只需更少的步数即可收敛，因此整体上往往更加高效</span></p><p data-lake-id="u06b322f8" id="u06b322f8"><strong><span data-lake-id="ucfab4464" id="ucfab4464" style="color: rgb(34, 73, 254),rgb(199, 74, 168)">定理 3.2（DPM-Solver-k 是一个 k 阶求解器）：</span></strong><span data-lake-id="ud1711b77" id="ud1711b77">设噪声预测模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cepsilon_%5C%5Ctheta(x%2Ct)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe7327f2ecff8ee281f55602575a153ce.svg%22%2C%22id%22%3A%22wR674%22%7D"></card><span data-lake-id="u2da7ccc6" id="u2da7ccc6">具有足够的正则性，即其关于状态与时间的变化足够平滑，使得所涉及的泰勒展开与高阶导数近似成立；同时</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cepsilon_%5C%5Ctheta(x%2Ct)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe7327f2ecff8ee281f55602575a153ce.svg%22%2C%22id%22%3A%22glDGX%22%7D"></card><span data-lake-id="u5f3f6f52" id="u5f3f6f52">对状态变量</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20x%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F70a0f663ea24f20341612f0479fb18c1.svg%22%2C%22id%22%3A%22exa8G%22%7D"></card><span data-lake-id="u4a89ecf1" id="u4a89ecf1">满足 Lipschitz 连续条件。进一步离散求解时所采用的时间步长足够小，则对于</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20k%3D1%2C2%2C3%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F548b5c2990af5e5c24560e589ddeb775.svg%22%2C%22id%22%3A%22Pu6tf%22%7D"></card><span data-lake-id="u1c088707" id="u1c088707">，</span><strong><span data-lake-id="u318583d5" id="u318583d5">DPM-Solver-k 分别构成扩散 ODE 的一个 k 阶数值求解方法</span></strong></p><p data-lake-id="u3a4aa6f5" id="u3a4aa6f5" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cboxed%7B%20%5C%5Ctilde%7B%5C%5Cboldsymbol%7Bx%7D%7D_%7Bt_M%7D%20-%20%5C%5Cboldsymbol%7Bx%7D_0%20%3D%20%5C%5Cmathcal%7BO%7D(h_%7B%5C%5Cmax%7D%5Ek)%2C%20%5C%5Ctext%7B%20where%20%7D%20h_%7Bmax%7D%20%3D%20%5C%5Cmax_%7B1%20%5C%5Cle%20i%20%5C%5Cle%20M%7D(%5C%5Clambda_%7Bt_i%7D%20-%20%5C%5Clambda_%7Bt_%7Bi-1%7D%7D).%20%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc182a6f0a8dd627b0d4e2ca4b5ccb4c7.svg%22%2C%22id%22%3A%22RAD1J%22%7D"></card></p><p data-lake-id="ucc5ce81f" id="ucc5ce81f"><span data-lake-id="ub8d99c35" id="ub8d99c35">🌟</span><span data-lake-id="u41a3bb72" id="u41a3bb72"> 求解器需要预先指定时间步序列</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7Bt_i%5C%5C%7D_%7Bi%3D0%7D%5EM%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4124070c1c6f31c0122f875402add15d.svg%22%2C%22id%22%3A%22aSmQi%22%7D"></card><span data-lake-id="u8f146d4d" id="u8f146d4d">。作者提出两种时间步长调度方式</span></p><ul list="u3d5d76a9"><li fid="u1e52bfd2" data-lake-id="u308e2d4a" id="u308e2d4a"><span data-lake-id="ubfffcf80" id="ubfffcf80">其中一种是</span><strong><span data-lake-id="u43b33ad8" id="u43b33ad8">手工设定的步长方案</span></strong><span data-lake-id="uc5099c7a" id="uc5099c7a">，即在区间</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5B%5C%5Clambda_T%2C%5C%5Clambda_0%5D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fcd6bec470f0ccc865de20de81e42743f.svg%22%2C%22id%22%3A%22quXbC%22%7D"></card><span data-lake-id="uda290597" id="uda290597">上进行均匀划分，也就是说：</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Clambda_%7Bt_i%7D%3D%5C%5Clambda_T%2B%5C%5Cfrac%7Bi%7D%7BM%7D(%5C%5Clambda_0-%5C%5Clambda_T)%2C%5C%5Cquad%20i%3D0%2C%5C%5Cdots%2CM.%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fcee0e8ab9c12612cda9ce2ea95de0a62.svg%22%2C%22id%22%3A%22eV1Wy%22%7D"></card><span data-lake-id="u649612cf" id="u649612cf">经验结果表明，当采用</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Clambda_%7Bt_i%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F7bb180137a1686118ca35ce943fb5cfd.svg%22%2C%22id%22%3A%22aDy40%22%7D"></card><span data-lake-id="u9da24571" id="u9da24571">的均匀时间步时，DPM-Solver 在少步采样场景下已经能够生成质量相当不错的样本</span></li><li fid="u1e52bfd2" data-lake-id="u34f20d0a" id="u34f20d0a"><span data-lake-id="u3cf940ec" id="u3cf940ec">另一种方案是</span><strong><span data-lake-id="u039116a5" id="u039116a5">自适应步长算法</span></strong><span data-lake-id="u7aa09a7a" id="u7aa09a7a">。该方法通过组合不同阶数的 DPM-Solver，动态调节步长大小</span></li></ul><p data-lake-id="u535ed590" id="u535ed590"><span data-lake-id="u4329d49d" id="u4329d49d">对于少步采样而言，需要充分利用全部可用函数评估次数。当 NFE 不能被 3 整除时，作者的策略是：优先尽可能多地使用 DPM-Solver-3，随后根据 NFE 除以 3 的余数，再额外补充一步 DPM-Solver-1 或 DPM-Solver-2</span></p><p data-lake-id="udf5e87d2" id="udf5e87d2"><strong><span data-lake-id="u7a5b7127" id="u7a5b7127">从离散时间 DPM 中进行采样：</span></strong><span data-lake-id="ubec92db1" id="ubec92db1">离散时间 DPM 在</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22N%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F459f3c80a50b7be28751b0869ef5386a.svg%22%2C%22id%22%3A%22kfMBE%22%7D"></card><span data-lake-id="u84ac48cc" id="u84ac48cc">个固定时间步</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7Bt_n%5C%5C%7D_%7Bn%3D1%7D%5EN%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F68d8ba2597e452752d9de5e76349cb75.svg%22%2C%22id%22%3A%22GnkpV%22%7D"></card><span data-lake-id="ue546ac6d" id="ue546ac6d">上训练噪声预测模型，其模型通常参数化为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Ctilde%7B%5C%5Cepsilon%7D_%5C%5Ctheta(x_n%2Cn)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F1dc0552d17862db3b95be2da3015da83.svg%22%2C%22id%22%3A%22Jnviv%22%7D"></card><span data-lake-id="u88e6e1b8" id="u88e6e1b8">，其中</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22n%3D0%2C%5C%5Cdots%2CN-1%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4f7a7f8f10bee1b682377fbf31bb58e7.svg%22%2C%22id%22%3A%22lbgB4%22%7D"></card><span data-lake-id="u008c6f58" id="u008c6f58">，并且每一个</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22x_n%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F45a5e6b13469d6b45de146cd727e525d.svg%22%2C%22id%22%3A%22Q1YNQ%22%7D"></card><span data-lake-id="ufd4662ea" id="ufd4662ea">对应于时刻</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20t_%7Bn%2B1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F18ed870bd4b6ed7f471e12441451f98e.svg%22%2C%22id%22%3A%22nhWoA%22%7D"></card><span data-lake-id="u813e19c6" id="u813e19c6">处的变量取值。可以将这种离散时间噪声预测模型转换为连续时间形式</span></p><p data-lake-id="udf53d6d2" id="udf53d6d2" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cboxed%7B%20%5C%5Cepsilon_%5C%5Ctheta(x%2C%20t)%20%3A%3D%20%5C%5Ctilde%7B%5C%5Cepsilon%7D_%5C%5Ctheta%5C%5Cleft(x%2C%20%5C%5Cfrac%7B(N-1)t%7D%7BT%7D%5C%5Cright)%2C%20%5C%5Cquad%20%5C%5Cforall%20x%20%5C%5Cin%20%5C%5Cmathbb%7BR%7D%5Ed%2C%20t%20%5C%5Cin%20%5B0%2C%20T%5D.%20%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F82294f66133eceb7785387e5f379685d.svg%22%2C%22id%22%3A%22OdNny%22%7D"></card></p><h2 data-lake-id="sFmIy" id="sFmIy" style="text-align: center"><span data-lake-id="u2e7603b6" id="u2e7603b6">🦄</span><span data-lake-id="u6bfd5b15" id="u6bfd5b15"> 𝑪𝒐𝒎𝒑𝒂𝒓𝒊𝒔𝒐𝒏 𝒘𝒊𝒕𝒉 𝑬𝒙𝒊𝒔𝒕𝒊𝒏𝒈 𝑭𝒂𝒔𝒕 𝑺𝒂𝒎𝒑𝒍𝒊𝒏𝒈 𝑴𝒆𝒕𝒉𝒐𝒅𝒔</span></h2><p data-lake-id="ub29a8a3c" id="ub29a8a3c"><strong><span data-lake-id="u85181e22" id="u85181e22">DDIM 作为 DPM-Solver-1 的特例：</span></strong><span data-lake-id="ub7d828f5" id="ub7d828f5">去噪扩散隐式模型提出一种从 DPM 中快速采样的确定性方法。对于相邻的两个时间步</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_%7Bi-1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F56be2748549262f2c6fe1b3dc84b9a6f.svg%22%2C%22id%22%3A%22tQcd1%22%7D"></card><span data-lake-id="u6d5ece61" id="u6d5ece61">和</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F26e255f82b8cc1651e50a820c5a16dc8.svg%22%2C%22id%22%3A%22pcdyn%22%7D"></card><span data-lake-id="u73e9ee4d" id="u73e9ee4d">，假设在时刻</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_%7Bi-1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F56be2748549262f2c6fe1b3dc84b9a6f.svg%22%2C%22id%22%3A%22oJpza%22%7D"></card><span data-lake-id="u438d18d0" id="u438d18d0">已有一个解</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Ctilde%7Bx%7D_%7Bt_%7Bi-1%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4c10e80b68bf70486e0808ad66d6f34c.svg%22%2C%22id%22%3A%22GLQdy%22%7D"></card><span data-lake-id="u5419807c" id="u5419807c">，则 DDIM 从</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20t_%7Bi-1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F328247ee7ce140599dd2f3fb88d28a6f.svg%22%2C%22id%22%3A%22b5izC%22%7D"></card><span data-lake-id="ua963958b" id="ua963958b">到</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20t_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4b5c10c04780ac51d2b8590471e3de17.svg%22%2C%22id%22%3A%22TcNKf%22%7D"></card><span data-lake-id="uc6ce65d8" id="uc6ce65d8">的单步更新可写为</span></p><p data-lake-id="ubb94f173" id="ubb94f173" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Ctilde%7Bx%7D_%7Bt_i%7D%20%3D%20%5C%5Cfrac%7B%5C%5Calpha_%7Bt_i%7D%7D%7B%5C%5Calpha_%7Bt_%7Bi-1%7D%7D%7D%5C%5Ctilde%7Bx%7D_%7Bt_%7Bi-1%7D%7D%20-%20%5C%5Calpha_%7Bt_i%7D%20%5C%5Cleft(%20%5C%5Cfrac%7B%5C%5Csigma_%7Bt_%7Bi-1%7D%7D%7D%7B%5C%5Calpha_%7Bt_%7Bi-1%7D%7D%7D%20-%20%5C%5Cfrac%7B%5C%5Csigma_%7Bt_i%7D%7D%7B%5C%5Calpha_%7Bt_i%7D%7D%20%5C%5Cright)%20%5C%5Cepsilon_%5C%5Ctheta(%5C%5Ctilde%7Bx%7D_%7Bt_%7Bi-1%7D%7D%2Ct_%7Bi-1%7D).%20%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6c0cc39f5ca7152e1726a614a7cb9f55.svg%22%2C%22id%22%3A%22IYOUQ%22%7D"></card></p><p data-lake-id="ub3c06bc5" id="ub3c06bc5"><span data-lake-id="u228871e3" id="u228871e3">尽管 DDIM 与 DPM-Solver-1 的出发视角完全不同，作者指出，二者的更新公式实际上是完全一致的。根据</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Clambda%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe520c061a407db472027709bf3f73290.svg%22%2C%22id%22%3A%22evTxr%22%7D"></card><span data-lake-id="ub3452184" id="ub3452184">的定义，有</span></p><p data-lake-id="ub7efb722" id="ub7efb722" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cfrac%7B%5C%5Csigma_%7Bt_%7Bi-1%7D%7D%7D%7B%5C%5Calpha_%7Bt_%7Bi-1%7D%7D%7D%3De%5E%7B-%5C%5Clambda_%7Bt_%7Bi-1%7D%7D%7D%2C%5C%5Cqquad%20%5C%5Cfrac%7B%5C%5Csigma_%7Bt_i%7D%7D%7B%5C%5Calpha_%7Bt_i%7D%7D%3De%5E%7B-%5C%5Clambda_%7Bt_i%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F55562ea63fa8356f3d71fe8e19be6106.svg%22%2C%22id%22%3A%22j1bgF%22%7D"></card></p><p data-lake-id="u14578e4b" id="u14578e4b"><span data-lake-id="ucc3f82c7" id="ucc3f82c7">将这些关系以及</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22h_i%3D%5C%5Clambda_%7Bt_i%7D-%5C%5Clambda_%7Bt_%7Bi-1%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb79ad47fdb1466a19c4bbcf3a718305c.svg%22%2C%22id%22%3A%22VdmHh%22%7D"></card><span data-lake-id="u8d374bd1" id="u8d374bd1">代入，便可精确得到 DPM-Solver-1 单步更新公式。因此，DDIM 实际上就是 DPM-Solver-1 的一个特例。不过，DPM-Solver 的优势在于，其基于扩散 ODE 的半线性结构进行建模，因此能够以一种更具原理性的方式推广到高阶求解器，并开展相应的收敛阶分析</span></p><p data-lake-id="u2f8a7cad" id="u2f8a7cad"><strong><span data-lake-id="ud778ce3a" id="ud778ce3a">与传统 Runge–Kutta 方法的比较：</span></strong><span data-lake-id="u2843ec0b" id="u2843ec0b">一种获得高阶求解器的直接思路，是将传统的显式 Runge–Kutta（RK）方法直接应用于扩散 ODE。具体而言，RK 方法通常将解写为如下积分形式</span></p><p data-lake-id="uf6094d32" id="uf6094d32" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22x_t%3Dx_s%2B%5C%5Cint_s%5Et%20h_%5C%5Ctheta(x_%5C%5Ctau%2C%5C%5Ctau)%5C%5C%2Cd%5C%5Ctau%20%3D%20x_s%2B%5C%5Cint_s%5Et%20%5C%5Cleft%5B%20f(%5C%5Ctau)x_%5C%5Ctau%2B%5C%5Cfrac%7Bg%5E2(%5C%5Ctau)%7D%7B2%5C%5Csigma_%5C%5Ctau%7D%5C%5Cepsilon_%5C%5Ctheta(x_%5C%5Ctau%2C%5C%5Ctau)%20%5C%5Cright%5Dd%5C%5Ctau%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6339c97e37442f6f771aac4576459b15.svg%22%2C%22id%22%3A%22c12Nn%22%7D"></card></p><p data-lake-id="u6fd5d9d6" id="u6fd5d9d6"><span data-lake-id="u3e1b159f" id="u3e1b159f">并在区间</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5Bt%2Cs%5D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fed05ee0ce178dcbdf44f3c31c3d0d590.svg%22%2C%22id%22%3A%22lF9J0%22%7D"></card><span data-lake-id="u27a57318" id="u27a57318">内选取若干中间时间点，通过组合这些时间点上对</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22h_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdd89ad155c8aad1a73a9199a624a4a5a.svg%22%2C%22id%22%3A%22ZGl45%22%7D"></card><span data-lake-id="ua2f6b783" id="ua2f6b783">的函数评估来近似整个积分。然而，显式 RK 方法的近似误差取决于 </span><card type="inline" name="math" value="data:%7B%22code%22%3A%22h_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdd89ad155c8aad1a73a9199a624a4a5a.svg%22%2C%22id%22%3A%22Dn8lq%22%7D"></card><span data-lake-id="u430ceb32" id="u430ceb32">本身，而</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22h_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdd89ad155c8aad1a73a9199a624a4a5a.svg%22%2C%22id%22%3A%22vlZR8%22%7D"></card><span data-lake-id="uc98549a6" id="uc98549a6">同时包含线性项</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20f(%5C%5Ctau)x_%5C%5Ctau%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff1d8491dd667a601a191d469dcae75a9.svg%22%2C%22id%22%3A%22Too92%22%7D"></card><span data-lake-id="ud65f5277" id="ud65f5277">与非线性的噪声预测模型</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cepsilon_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F0e49f6f0f8deead694119ae9022b3641.svg%22%2C%22id%22%3A%22Nxw1c%22%7D"></card><span data-lake-id="u17745b27" id="u17745b27">所带来的误差。问题在于，线性项的误差可能会被显著放大，因为线性项精确解中本身包含指数系数。已有大量经验研究表明，对于半线性 ODE，若直接采用显式 RK 方法并使用较大步长，往往会遭遇数值不稳定问题</span></p><p data-lake-id="ue28b5340" id="ue28b5340"><strong><span data-lake-id="uccbc92d0" id="uccbc92d0">面向 DPM 的训练型快速采样方法</span></strong><span data-lake-id="ud3c9577f" id="ud3c9577f">：需要额外训练或优化的快速采样方法主要包括：知识蒸馏、学习噪声水平或方差，以及学习噪声调度或样本轨迹。尽管渐进式蒸馏方法可以将快速采样压缩到 4 步以内，但它需要额外的训练成本，并且会损失原始 DPM 中的部分信息。例如，在蒸馏之后，噪声预测模型将不再能够在区间</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%20%5B0%2CT%5D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9bdf1fa343822167b606a82f6fb9f874.svg%22%2C%22id%22%3A%22wwi6U%22%7D"></card><span data-lake-id="u8866ea15" id="u8866ea15">上的任意时间步都对噪声（即 score function）进行预测。</span><strong><span data-lake-id="ub5b950e7" id="ub5b950e7">免训练采样器</span></strong><span data-lake-id="u6b6c173b" id="u6b6c173b">能够完整保留原始模型中的全部信息，因此也更容易直接扩展到条件采样场景，例如通过结合原始模型和外部分类器来实现带有 classifier guidance 的条件采样</span></p>