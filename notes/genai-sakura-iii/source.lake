%22%3A129%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22.%E8%A1%8C%3A()%22%2C%22x%22%3A692%2C%22y%22%3A207%2C%22width%22%3A200%2C%22height%22%3A40%7D%2C%7B%22text%22%3A%22O(TI)S(T)%22%2C%22x%22%3A553%2C%22y%22%3A228%2C%22width%22%3A245%2C%22height%22%3A29%7D%2C%7B%22text%22%3A%22(TI%2B1)%22%2C%22x%22%3A308%2C%22y%22%3A392%2C%22width%22%3A95%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22()%22%2C%22x%22%3A257%2C%22y%22%3A186%2C%22width%22%3A72%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A30%2C%22y%22%3A99%2C%22width%22%3A25%2C%22height%22%3A147%7D%2C%7B%22text%22%3A%22FORIE0%2C.%22%2C%22x%22%3A116%2C%22y%22%3A151%2C%22width%22%3A149%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22O(TI%2B1)%22%2C%22x%22%3A296%2C%22y%22%3A357%2C%22width%22%3A109%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22ST)%22%2C%22x%22%3A372%2C%22y%22%3A189%2C%22width%22%3A66%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%22(T2%2B1)%22%2C%22x%22%3A441%2C%22y%22%3A396%2C%22width%22%3A79%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%22(%2B1)%22%2C%22x%22%3A437%2C%22y%22%3A358%2C%22width%22%3A81%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%220(T)%22%2C%22x%22%3A254%2C%22y%22%3A225%2C%22width%22%3A94%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%22%E4%B8%801-D0%22%2C%22x%22%3A346%2C%22y%22%3A150%2C%22width%22%3A103%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A27%2C%22y%22%3A321%2C%22width%22%3A30%2C%22height%22%3A138%7D%2C%7B%22text%22%3A%22S(T)%22%2C%22x%22%3A369%2C%22y%22%3A223%2C%22width%22%3A78%2C%22height%22%3A33%7D%2C%7B%22text%22%3A%222%22%2C%22x%22%3A27%2C%22y%22%3A238%2C%22width%22%3A30%2C%22height%22%3A108%7D%2C%7B%22text%22%3A%22%E4%BA%BA%22%2C%22x%22%3A203%2C%22y%22%3A366%2C%22width%22%3A70%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22%E4%B8%89%22%2C%22x%22%3A27%2C%22y%22%3A392%2C%22width%22%3A29%2C%22height%22%3A102%7D%2C%7B%22text%22%3A%22DI%22%2C%22x%22%3A158%2C%22y%22%3A207%2C%22width%22%3A41%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22..%2CV-%22%2C%22x%22%3A262%2C%22y%22%3A150%2C%22width%22%3A92%2C%22height%22%3A25%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ededed%22%2C%22id%22%3A%22ufaa3c253%22%7D"></card></p><p data-lake-id="u41879e58" id="u41879e58"><span data-lake-id="ucc3be7b7" id="ucc3be7b7">时间步</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7Bt_i%5C%5C%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F38afa4d9e1116ec3a6a883b5a594b334.svg%22%2C%22id%22%3A%22fyQ8T%22%7D"></card><span data-lake-id="u8aad60b9" id="u8aad60b9">决定不同噪声水平下步长及截断误差的分布方式：</span><strong><span data-lake-id="ud8508a89" id="ud8508a89">随着</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22ZRVIh%22%7D"></card><strong><span data-lake-id="u9104765c" id="u9104765c">的减小，步长应当单调减小</span></strong><span data-lake-id="u16af8d90" id="u16af8d90">，且步长无需针对每个样本单独调整。基于此，作者采用一种参数化方案，通过噪声水平序列</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5C%7B%5C%5Csigma_i%5C%5C%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fde7d25b02acaefb21985c524412cd136.svg%22%2C%22id%22%3A%22vIZAX%22%7D"></card><span data-lake-id="ub90334b4" id="ub90334b4">定义时间步，即</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_i%3D%5C%5Csigma%5E%7B-1%7D(%5C%5Csigma_i)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F93f0bc9cb36db2b5bd73eeb1df4fde45.svg%22%2C%22id%22%3A%22N2khI%22%7D"></card><span data-lake-id="uaa3b9798" id="uaa3b9798">​</span></p><p data-lake-id="uc0e17feb" id="uc0e17feb" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma_%7Bi%3CN%7D%3D(Ai%2BB)%5E%5C%5Crho%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F3ca58b1adfa6fccfe852e8a34a33acac.svg%22%2C%22id%22%3A%22VBRjS%22%7D"></card></p><p data-lake-id="u9f2818b8" id="u9f2818b8"><span data-lake-id="u537c8d2c" id="u537c8d2c">并选择常数 A 和 B，使得</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma_0%3D%5C%5Csigma_%7B%5C%5Cmax%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9c95df3aff7ee2bcb133bc8d153ca801.svg%22%2C%22id%22%3A%22k2vis%22%7D"></card><span data-lake-id="u8a77f698" id="u8a77f698">，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma_%7BN-1%7D%3D%5C%5Csigma_%7B%5C%5Cmin%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F8b6ab2e6a8cbc27c21ac5cb608e3138f.svg%22%2C%22id%22%3A%22Yp38U%22%7D"></card><span data-lake-id="u056a3d25" id="u056a3d25">，从而得到</span></p><p data-lake-id="uf0d4100e" id="uf0d4100e" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma_%7Bi%3CN%7D%20%3D%20%5C%5Cleft(%20%5C%5Csigma_%7B%5C%5Cmax%7D%5E%7B%5C%5Cfrac%7B1%7D%7B%5C%5Crho%7D%7D%20%2B%20%5C%5Cfrac%7Bi%7D%7BN-1%7D%20%5C%5Cleft(%20%5C%5Csigma_%7B%5C%5Cmin%7D%5E%7B%5C%5Cfrac%7B1%7D%7B%5C%5Crho%7D%7D%20-%20%5C%5Csigma_%7B%5C%5Cmax%7D%5E%7B%5C%5Cfrac%7B1%7D%7B%5C%5Crho%7D%7D%20%5C%5Cright)%20%5C%5Cright)%5E%5C%5Crho%20%5C%5Cquad%20%5C%5Ctext%7Band%7D%20%5C%5Cquad%20%5C%5Csigma_N%20%3D%200%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F0d3420f6cd5bcdb4266ce5b416601599.svg%22%2C%22id%22%3A%22K1mIq%22%7D"></card></p><p data-lake-id="ud2bfdf78" id="ud2bfdf78"><span data-lake-id="ue1bf5965" id="ue1bf5965">其中</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Crho%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fd7dccfe80f15d1d2e2f37d8d47a9378b.svg%22%2C%22id%22%3A%22Rr12T%22%7D"></card><span data-lake-id="uce8e8b97" id="uce8e8b97">控制靠近</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma_%7B%5C%5Cmin%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F2374b157989b9074e682fd558e2686a9.svg%22%2C%22id%22%3A%22jDF0O%22%7D"></card><span data-lake-id="ua48fec02" id="ua48fec02">处的步长压缩程度，即在缩短低噪声区域步长的同时，允许高噪声区域使用更长步长。</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Crho%3D3%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fa705d63238a003a3ef5c34d99aaa3a2f.svg%22%2C%22id%22%3A%22dC1yP%22%7D"></card><span data-lake-id="u36a152ea" id="u36a152ea">几乎可以使每一步的截断误差相对均衡，但在图像采样任务中，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Crho%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fd7dccfe80f15d1d2e2f37d8d47a9378b.svg%22%2C%22id%22%3A%22WULTo%22%7D"></card><span data-lake-id="u039f0263" id="u039f0263">取 5 至 10 的范围效果更佳，这说明低噪声区域的误差对最终结果影响更大。基于实验，论文其余部分统一采用</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Crho%3D7%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F01a6badbc79c74179754d32f962c3233.svg%22%2C%22id%22%3A%22TXtsx%22%7D"></card></p><p data-lake-id="u7d6d45d9" id="u7d6d45d9"><strong><span data-lake-id="u177332c7" id="u177332c7">轨迹曲率与噪声调度：</span></strong><span data-lake-id="u8e7a3fba" id="u8e7a3fba">ODE 解轨迹的形状由</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma(t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe322edd65022b6dfe2836422aed20f47.svg%22%2C%22id%22%3A%22ppQtb%22%7D"></card><span data-lake-id="u975cb878" id="u975cb878">和</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22s(t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F22ec3101c5f2e618da3b0616216d3107.svg%22%2C%22id%22%3A%22j2KEg%22%7D"></card><span data-lake-id="uaae65035" id="uaae65035">两个函数共同决定。对这两个函数的选择，实际上也提供一条降低上述截断误差的途径，因为误差大小通常与</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22dx%2Fdt%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc89e11c85f06fd62c01b05692a1c0f36.svg%22%2C%22id%22%3A%22Cfkhe%22%7D"></card><span data-lake-id="u71b35b21" id="u71b35b21">的曲率成正比。作者认为最优选择应为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma(t)%3Dt%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fcbe65030e6591b68b458f8ccffb62c5f.svg%22%2C%22id%22%3A%22nKOsL%22%7D"></card><span data-lake-id="u79f9fd7e" id="u79f9fd7e">与</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22s(t)%3D1%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F3ed8c83d2257d9a4263649485e75769c.svg%22%2C%22id%22%3A%22Ny2lm%22%7D"></card><span data-lake-id="ub7062955" id="ub7062955">，这也是 DDIM 所采用的设置</span></p><p data-lake-id="u6d488de5" id="u6d488de5" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22dx%2Fdt%20%3D%20%5C%5Cfrac%7Bx-D(x%3Bt)%7D%7Bt%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe7649dcb95aec671033eaa3e446dca74.svg%22%2C%22id%22%3A%22iSMRT%22%7D"></card></p><ul list="u511a0a88"><li fid="u7050d8d6" data-lake-id="uc226ce9d" id="uc226ce9d"><span data-lake-id="u577cd272" id="u577cd272">对于任意给定的</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22x%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F712ecf7894348e92d8779c3ee87eeeb0.svg%22%2C%22id%22%3A%22QTIlJ%22%7D"></card><span data-lake-id="uf680f31a" id="uf680f31a">和</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fcead1760d9d5723460c4b8d4028f113a.svg%22%2C%22id%22%3A%22xDrsk%22%7D"></card><span data-lake-id="u32c180ff" id="u32c180ff">，只需执行一次到</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t%3D0%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fcf76c4580adc6af67436e1cd68eed17d.svg%22%2C%22id%22%3A%22XXv59%22%7D"></card><span data-lake-id="ufb81b8cb" id="ufb81b8cb">的 Euler 步，就可得到去噪图像</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta(x%3Bt)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe7ae6d23dab6d3f4be909519c73a7c7c.svg%22%2C%22id%22%3A%22CPANK%22%7D"></card><span data-lake-id="u743b472c" id="u743b472c">。因此，解轨迹的切向方向始终指向去噪器输出。这意味着该方向通常只会随噪声水平缓慢变化，也即解轨迹整体上接近线性</span></li><li fid="u7050d8d6" data-lake-id="uf4e5e2db" id="uf4e5e2db"><span data-lake-id="ua156f54b" id="ua156f54b">1 维 ODE 示意图支持这一直觉：在高噪声和低噪声两端，解轨迹均趋近于线性，而显著曲率仅集中在中间较窄的一段区域。不同去噪目标之间的变化主要集中在一个较窄的</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22fjWCU%22%7D"></card><span data-lake-id="u5bfcf483" id="u5bfcf483">区间内。在作者主张的调度下，这也意味着 ODE 的高曲率被限制在相同的狭窄区域内</span></li></ul><p data-lake-id="ua69e186f" id="ua69e186f" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1775971757304-4b36ad8b-17ec-46d1-ac31-703b3c920094.png%22%2C%22taskId%22%3A%22u29fadc98-a385-4d2d-aa54-7b9dd4feca9%22%2C%22clientId%22%3A%22ua25158a8-7e06-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A736%2C%22height%22%3A196%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A219771%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1331%2C%22originHeight%22%3A354%2C%22ratio%22%3A1.375%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22)VARIANCEPRESERVINGODE48%5D(B)VARIANCEEXPLODINGODE48%5D(C)DDLM46%5D%2FOURODE%22%2C%22x%22%3A34%2C%22y%22%3A312%2C%22width%22%3A1242%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%22400600051015202%22%2C%22x%22%3A654%2C%22y%22%3A268%2C%22width%22%3A648%2C%22height%22%3A35%7D%2C%7B%22text%22%3A%22.20.40.60.8T%3D0%22%2C%22x%22%3A134%2C%22y%22%3A277%2C%22width%22%3A391%2C%22height%22%3A25%7D%2C%7B%22text%22%3A%22-0.00.%22%2C%22x%22%3A13%2C%22y%22%3A281%2C%22width%22%3A139%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22%E4%B8%8040%22%2C%22x%22%3A441%2C%22y%22%3A261%2C%22width%22%3A54%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A458%2C%22y%22%3A106%2C%22width%22%3A25%2C%22height%22%3A111%7D%2C%7B%22text%22%3A%22400%22%2C%22x%22%3A631%2C%22y%22%3A278%2C%22width%22%3A151%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%2220%22%2C%22x%22%3A454%2C%22y%22%3A86%2C%22width%22%3A32%2C%22height%22%3A36%7D%2C%7B%22text%22%3A%2240%22%2C%22x%22%3A901%2C%22y%22%3A42%2C%22width%22%3A24%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%2240%22%2C%22x%22%3A458%2C%22y%22%3A41%2C%22width%22%3A28%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%2220%22%2C%22x%22%3A894%2C%22y%22%3A201%2C%22width%22%3A34%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%220-%22%2C%22x%22%3A23%2C%22y%22%3A151%2C%22width%22%3A28%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%2220%22%2C%22x%22%3A456%2C%22y%22%3A190%2C%22width%22%3A29%2C%22height%22%3A42%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23edc8ad%22%2C%22id%22%3A%22u4d21d8b6%22%7D"></card></p><h2 data-lake-id="DyRWC" id="DyRWC" style="text-align: center"><span data-lake-id="u8f790756" id="u8f790756"> </span><span data-lake-id="ub6204564" id="ub6204564">🐶</span><span data-lake-id="ucdee8ffa" id="ucdee8ffa"> 𝑺𝒕𝒐𝒄𝒉𝒂𝒔𝒕𝒊𝒄 𝒔𝒂𝒎𝒑𝒍𝒊𝒏𝒈</span></h2><p data-lake-id="uf900f153" id="uf900f153"><span data-lake-id="uca4d5491" id="uca4d5491">确定性采样具有诸多优势，例如可以通过对 ODE 进行逆向求解，将真实图像映射为其对应的潜在表示。然而，与在每一步中向图像注入新噪声的随机采样相比，确定性采样往往会导致较差的生成质量。鉴于从理论上看，ODE 与 SDE 均可恢复相同的目标分布，那么</span><strong><span data-lake-id="u228fc53b" id="u228fc53b">随机性究竟发挥什么作用</span></strong><span data-lake-id="u15fd3fec" id="u15fd3fec">，便成为一个值得深入探讨的问题</span></p><p data-lake-id="u09bee356" id="u09bee356"><strong><span data-lake-id="u61e96120" id="u61e96120">Song 等提出的 SDE 可进一步推广为：由概率流 ODE 与一个时变的 Langevin diffusion SDE 共同构成的形式</span></strong><span data-lake-id="u6585d84a" id="u6585d84a">。具体而言</span></p><p data-lake-id="ua302d4d6" id="ua302d4d6" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cboxed%7B%20%5C%5Cmathrm%7Bd%7D%5C%5Cboldsymbol%7Bx%7D_%7B%5C%5Cpm%7D%20%3D%20%5C%5Cunderbrace%7B-%20%5C%5Cfrac%7B%5C%5Cmathrm%7Bd%7D%5C%5Csigma(t)%7D%7B%5C%5Cmathrm%7Bd%7Dt%7D%20%5C%5Csigma(t)%5C%5Cnabla_%7B%5C%5Cboldsymbol%7Bx%7D%7D%20%5C%5Clog%20p(%5C%5Cboldsymbol%7Bx%7D%3B%20%5C%5Csigma(t))%20%5C%5C%2C%20%5C%5Cmathrm%7Bd%7Dt%7D_%7B%5C%5Ctext%7Bprobability%20flow%20ODE%7D%7D%20%5C%5Cpm%20%5C%5Cunderbrace%7B%20%5C%5Cunderbrace%7B%5C%5Cbeta(t)%5C%5Csigma(t)%5E2%20%5C%5Cnabla_%7B%5C%5Cboldsymbol%7Bx%7D%7D%20%5C%5Clog%20p(%5C%5Cboldsymbol%7Bx%7D%3B%20%5C%5Csigma(t))%20%5C%5C%2C%20%5C%5Cmathrm%7Bd%7Dt%7D_%7B%5C%5Ctext%7Bdeterministic%20noise%20decay%7D%7D%20%2B%20%5C%5Cunderbrace%7B%5C%5Csqrt%7B2%5C%5Cbeta(t)%7D%5C%5Csigma(t)%20%5C%5C%2C%20%5C%5Cmathrm%7Bd%7D%5C%5Comega_t%7D_%7B%5C%5Ctext%7Bnoise%20injection%7D%7D%20%7D_%7B%5C%5Ctext%7BLangevin%20diffusion%20SDE%7D%7D%20%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6f6df9eb55d6355a8bdf1ffc465e21bb.svg%22%2C%22id%22%3A%22E59iI%22%7D"></card></p><ul list="uc3c6598e"><li fid="uf00157a5" data-lake-id="uecee40de" id="uecee40de"><span data-lake-id="ua7a31158" id="ua7a31158">其中</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Comega_t%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb69361c36c2ff5e1988b31d22379eb6c.svg%22%2C%22id%22%3A%22u4nWv%22%7D"></card><span data-lake-id="ubcfb3cba" id="ubcfb3cba">表示标准 Wiener 过程。此时，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22dx%5E%2B%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fff8ad4092c9bae79549cb96679f03b62.svg%22%2C%22id%22%3A%22unBc0%22%7D"></card><span data-lake-id="u6c3fe2de" id="u6c3fe2de">与</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22dx%5E-%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F1f25845841f2342adf0018afa0aa96a4.svg%22%2C%22id%22%3A%22TamIL%22%7D"></card><span data-lake-id="ua9c4f323" id="ua9c4f323">分别对应时间正向与反向演化的两个 SDE，它们之间通过 Anderson 的时间反演公式联系起来。进一步地，Langevin 项还可被理解为由一个</span><strong><span data-lake-id="u5a849c9a" id="u5a849c9a">基于 score 的确定性去噪项</span></strong><span data-lake-id="ue2b27706" id="ue2b27706">与一个</span><strong><span data-lake-id="u5901af0c" id="u5901af0c">随机噪声注入项</span></strong><span data-lake-id="ud3a69e66" id="ud3a69e66">所共同组成，而二者在净噪声水平上的贡献彼此抵消。因此，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta(t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb97f1ce3deb020e5c64f6db7cb24cc70.svg%22%2C%22id%22%3A%22RzhwP%22%7D"></card><span data-lake-id="ub9a5d6f1" id="ub9a5d6f1">实际上表征</span><strong><span data-lake-id="u170f8295" id="u170f8295">旧噪声被新噪声替换的相对速率</span></strong><span data-lake-id="ued43e5b4" id="ued43e5b4">。当取</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta(t)%20%3D%20%5C%5Cfrac%7B%5C%5Cmathrm%7Bd%7D%5C%5Csigma(t)%7D%7B%5C%5Cmathrm%7Bd%7Dt%7D%20%2F%20%5C%5Csigma(t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc1320b286176b8e52a2e75d10dd1d095.svg%22%2C%22id%22%3A%22lHYLZ%22%7D"></card><span data-lake-id="u31d98054" id="u31d98054">时，便可恢复 Song 等人的原始 SDE；在该特例下，score 项在前向 SDE 中消失</span></li><li fid="uf00157a5" data-lake-id="u32ce3032" id="u32ce3032"><span data-lake-id="ufcc359f8" id="ufcc359f8">揭示随机性在实践中为何有助于提升性能：隐式的 Langevin diffusion 会在给定时刻主动推动样本向目标边缘分布靠近，从而不断纠正前面采样步骤中累积的误差。另一方面，以离散 SDE 求解器来近似 Langevin 项本身也会引入新的误差。已有研究表明，取非零的</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta(t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb97f1ce3deb020e5c64f6db7cb24cc70.svg%22%2C%22id%22%3A%22kdDnW%22%7D"></card><span data-lake-id="u90ed2880" id="u90ed2880">通常是有益的，但就作者所见，Song 等人对</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cbeta(t)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb97f1ce3deb020e5c64f6db7cb24cc70.svg%22%2C%22id%22%3A%22eAI2G%22%7D"></card><span data-lake-id="ud1ac4716" id="ud1ac4716">的隐式设定并不具有某种特殊的最优性质。因此，</span><strong><span data-lake-id="ue2c42d69" id="ue2c42d69">最优的随机性强度应通过经验实验加以确定</span></strong></li></ul><p data-lake-id="u8c025324" id="u8c025324"><strong><span data-lake-id="u49650506" id="u49650506">作者提出一种随机采样器，将前文的二阶确定性 ODE 积分器与显式的、类似 Langevin 的 churn 操作结合起来，即在每一步中交替执行加噪与去噪</span></strong><span data-lake-id="u3e9854be" id="u3e9854be">。具体而言，在第</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F2443fbcfeb7e85e1d62b6f5e4f27207e.svg%22%2C%22id%22%3A%22EnYnj%22%7D"></card><span data-lake-id="u654955a5" id="u654955a5">步，已知噪声水平</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_i(%3D%5C%5Csigma(t_i))%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe56864fae1a29e79462a58b56e7617d7.svg%22%2C%22id%22%3A%22HmJBr%22%7D"></card><span data-lake-id="u4aac1c54" id="u4aac1c54">下的样本</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22x_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F5b13ed0ae41bee9defcf75f2efc5f060.svg%22%2C%22id%22%3A%22KZSKJ%22%7D"></card><span data-lake-id="uefdf3e42" id="uefdf3e42">后，作者执行两个子步骤：</span></p><ul list="u99441a2b"><li fid="u4ff9c869" data-lake-id="ufdbdcb8a" id="ufdbdcb8a"><span data-lake-id="ue68ce594" id="ue68ce594">第一步，根据一个非负系数</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cgamma_i%20%5C%5Cge%200%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F8a7a85e76ca5cc38f17a71424faff78c.svg%22%2C%22id%22%3A%22IrPkG%22%7D"></card><span data-lake-id="u7cd3ed85" id="u7cd3ed85">，向样本中添加噪声，使其到达更高的噪声水平</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7Bt%7D_i%20%3D%20t_i%20%2B%20%5C%5Cgamma_i%20t_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F355ed2769916d71b700a329d65784d53.svg%22%2C%22id%22%3A%22o2yST%22%7D"></card></li></ul><ul list="u97820020"><li fid="u3e58a45a" data-lake-id="uc2de9b9a" id="uc2de9b9a"><span data-lake-id="ued5f554e" id="ued5f554e">第二步，从加噪后的样本</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7Bx%7D_i%20%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F537d77f8fc0ba4a144bdcc52903eac26.svg%22%2C%22id%22%3A%22oDvwK%22%7D"></card><span data-lake-id="u351c17c4" id="u351c17c4">出发，通过一次单步 ODE 反向求解，将其从</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Chat%7Bt%7D_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F95b6b99f53fb30564675c9b7c733b0b4.svg%22%2C%22id%22%3A%22tqe8u%22%7D"></card><span data-lake-id="u32777682" id="u32777682">推进到</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_%7Bi%2B1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdd391a6754b899fc8e4f2de1da075e97.svg%22%2C%22id%22%3A%22OnuzN%22%7D"></card><span data-lake-id="u0df5f26c" id="u0df5f26c">。由此得到噪声水平为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_%7Bi%2B1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdd391a6754b899fc8e4f2de1da075e97.svg%22%2C%22id%22%3A%22frKHg%22%7D"></card><span data-lake-id="uc2189602" id="uc2189602">的样本</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22x_%7Bi%2B1%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb4b73b0516981c320931c07951bba1ec.svg%22%2C%22id%22%3A%22LVDah%22%7D"></card><span data-lake-id="u374b5c03" id="u374b5c03">，并继续下一轮迭代</span></li><li fid="u3e58a45a" data-lake-id="uc0dfef33" id="uc0dfef33"><span data-lake-id="u1f4c6525" id="u1f4c6525">作者特别强调，这并不是一个通用型 SDE 求解器，而是</span><strong><span data-lake-id="u6875bf72" id="u6875bf72">针对当前采样问题专门设计的采样程序</span></strong><span data-lake-id="ue7dfbedf" id="ue7dfbedf">。其正确性来源于两个子步骤的交替执行：二者各自都能保持正确的目标分布（ODE 步除截断误差外）</span></li><li fid="u3e58a45a" data-lake-id="u6cbe674d" id="u6cbe674d"><span data-lake-id="u9c86c032" id="u9c86c032">Euler–Maruyama 可以被理解为：首先添加噪声，然后执行一个 ODE 步；但这一 ODE 步并非从加噪后的中间状态出发，而是仍假定</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22x%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F712ecf7894348e92d8779c3ee87eeeb0.svg%22%2C%22id%22%3A%22rBtCX%22%7D"></card><span data-lake-id="u65bd2d2d" id="u65bd2d2d">与</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22j8fSK%22%7D"></card><span data-lake-id="u142c9284" id="u142c9284">保持在该迭代开始时的初始状态。相比之下，在作者的方法中，算法 2 第 7 行用于评估</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F3dd6d3deb6c2d585ea87ea1840df81c3.svg%22%2C%22id%22%3A%22Vw7Vf%22%7D"></card><span data-lake-id="u78e1625a" id="u78e1625a">的参数对应的是</span><strong><span data-lake-id="u83335302" id="u83335302">噪声注入之后的状态</span></strong><span data-lake-id="ucf854d67" id="ucf854d67">，而类 Euler–Maruyama 的方法则会使用原始的</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22(x_i%2Ct_i)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fbb2992416b477d1536c28aa3c7f3c3a9.svg%22%2C%22id%22%3A%22ETyJz%22%7D"></card><span data-lake-id="u7c903e48" id="u7c903e48">，而不是</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22(%5C%5Chat%7Bx%7D_i%2C%5C%5Chat%7Bt%7D_i)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff6edcf0e5198384d83a8ec155c2e01cf.svg%22%2C%22id%22%3A%22PjGWE%22%7D"></card></li></ul><p data-lake-id="u0f8ef346" id="u0f8ef346" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1775993926637-3feeda7e-fcac-4516-b293-0ea1b9197cc1.png%22%2C%22taskId%22%3A%22u38723c17-13bd-470c-ab8d-cdd92b55b0f%22%2C%22clientId%22%3A%22u48f8c45c-2258-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A705.6364135742188%2C%22height%22%3A273%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A156617%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1411%2C%22originHeight%22%3A546%2C%22ratio%22%3A1.375%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22RI%2B1%E5%AE%9A%E5%8D%81(TI%2B1-TI)(DI%E5%8D%81%E4%BA%8FD)%22%2C%22x%22%3A190%2C%22y%22%3A455%2C%22width%22%3A514%2C%22height%22%3A35%7D%2C%7B%22text%22%3A%22D%E4%B8%80(0I%2B1-D0(0I%2B1%3BTI%E8%AE%A11))%2FT%2B1%22%2C%22x%22%3A190%2C%22y%22%3A421%2C%22width%22%3A507%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%22TOCHASTICSAMPLER(DE(%3BO)%2CTIE0..%2CN%7D%2CEO.%2CN-1%22%2C%22x%22%3A228%2C%22y%22%3A85%2C%22width%22%3A761%2C%22height%22%3A26%7D%2C%7B%22text%22%3A%22DI-(%E5%85%83I-DO(%E5%85%83I%3BT))TI%22%2C%22x%22%3A158%2C%22y%22%3A305%2C%22width%22%3A364%2C%22height%22%3A32%7D%2C%7B%22text%22%3A%220I%2B1(-%E9%BE%99I%E5%8D%81(TI%2B1%E4%B8%80TID%22%2C%22x%22%3A150%2C%22y%22%3A344%2C%22width%22%3A369%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22TAKEEULERSTEPFROMTITOTI%2B1%22%2C%22x%22%3A977%2C%22y%22%3A344%2C%22width%22%3A413%2C%22height%22%3A28%7D%2C%7B%22text%22%3A%22URSTOCHASTICSAMPLERWITH(T)%3DTANDS(T)%3DL.%22%2C%22x%22%3A233%2C%22y%22%3A28%2C%22width%22%3A694%2C%22height%22%3A28%7D%2C%7B%22text%22%3A%22SAMPLEEI~W(0%2CSIOISI%22%2C%22x%22%3A154%2C%22y%22%3A194%2C%22width%22%3A353%2C%22height%22%3A29%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A27%2C%22y%22%3A102%2C%22width%22%3A28%2C%22height%22%3A280%7D%2C%7B%22text%22%3A%22EVALUATEDC%2FDTATTI%22%2C%22x%22%3A955%2C%22y%22%3A309%2C%22width%22%3A434%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22%E9%87%91I%3A-0%E5%8D%81V%E5%9D%9B-%E5%9C%BAEI%22%2C%22x%22%3A156%2C%22y%22%3A266%2C%22width%22%3A319%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22SELECTTEMPORARILYINCREASEDNOISELEVELT%22%2C%22x%22%3A837%2C%22y%22%3A235%2C%22width%22%3A548%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22ADDNEWNOISETOMOVEFROMT%2CTOT%22%2C%22x%22%3A874%2C%22y%22%3A273%2C%22width%22%3A518%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22APPLY2DORDERCORRECTION%22%2C%22x%22%3A1019%2C%22y%22%3A419%2C%22width%22%3A370%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22IFTIE%5BSUMIN%2CSUMAX%5D%22%2C%22x%22%3A1177%2C%22y%22%3A132%2C%22width%22%3A212%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22IFTI%2B1%E5%8E%BB0THEN%22%2C%22x%22%3A151%2C%22y%22%3A381%2C%22width%22%3A371%2C%22height%22%3A29%7D%2C%7B%22text%22%3A%22ALGORITHM2%22%2C%22x%22%3A17%2C%22y%22%3A26%2C%22width%22%3A189%2C%22height%22%3A30%7D%2C%7B%22text%22%3A%22SAMPLEOW(O%2CT1%22%2C%22x%22%3A107%2C%22y%22%3A120%2C%22width%22%3A328%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22ORIE0%2C...%2CV%E4%B8%801%22%2C%22x%22%3A128%2C%22y%22%3A155%2C%22width%22%3A276%2C%22height%22%3A29%7D%2C%7B%22text%22%3A%221%3APROCEDURESTOC%22%2C%22x%22%3A26%2C%22y%22%3A84%2C%22width%22%3A259%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22TI(%E4%B8%80TI%E5%8D%81TI%22%2C%22x%22%3A156%2C%22y%22%3A234%2C%22width%22%3A217%2C%22height%22%3A27%7D%2C%7B%22text%22%3A%22RETURNCY%22%2C%22x%22%3A108%2C%22y%22%3A499%2C%22width%22%3A166%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22.NMIN%E6%9E%B6U%2CV2-1%22%2C%22x%22%3A540%2C%22y%22%3A133%2C%22width%22%3A610%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22THERWISE%22%2C%22x%22%3A1186%2C%22y%22%3A187%2C%22width%22%3A126%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%2212%3A%22%2C%22x%22%3A14%2C%22y%22%3A490%2C%22width%22%3A45%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22M1N%22%2C%22x%22%3A922%2C%22y%22%3A141%2C%22width%22%3A79%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A22%2C%22y%22%3A311%2C%22width%22%3A33%2C%22height%22%3A109%7D%2C%7B%22text%22%3A%22DYI%22%2C%22x%22%3A810%2C%22y%22%3A160%2C%22width%22%3A70%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%2211%3A%22%2C%22x%22%3A14%2C%22y%22%3A448%2C%22width%22%3A43%2C%22height%22%3A39%7D%2C%7B%22text%22%3A%2210%3A%22%2C%22x%22%3A18%2C%22y%22%3A390%2C%22width%22%3A39%2C%22height%22%3A61%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f0f0f0%22%2C%22id%22%3A%22u2ed42cee%22%7D"></card></p><p data-lake-id="ufcad9b3d" id="ufcad9b3d"><strong><span data-lake-id="ud62b00d2" id="ud62b00d2">尽管增强随机性有助于修正早期采样步骤中的误差，但它也会带来新的问题。若采用过强的、类似 Langevin 的反复加噪与去噪操作，在所有数据集和去噪网络上都会导致生成图像细节逐渐丢失。此外，在极低和极高噪声水平下，还会出现颜色过饱和的漂移现象</span></strong></p><ul list="u346901bb"><li fid="u0ee7edec" data-lake-id="u1e704b33" id="u1e704b33"><span data-lake-id="u8200e032" id="u8200e032">作者推测，实际去噪器所诱导的向量场可能并非严格保守场，这破坏 Langevin diffusion 成立所依赖的前提，并由此引发上述不利效应。值得注意的是，在解析型去噪器上，作者并未观察到类似退化现象</span></li></ul><p data-lake-id="u73b7ba59" id="u73b7ba59"><strong><span data-lake-id="u6c4aff67" id="u6c4aff67">如果这些退化现象确实源于</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta(x%3B%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F902692a2e69f415041382046efacabb5.svg%22%2C%22id%22%3A%22Z4kzr%22%7D"></card><strong><span data-lake-id="ub269d7b5" id="ub269d7b5">本身的缺陷，那么它们只能在采样阶段通过启发式方式予以缓解</span></strong></p><ul list="ua5911263"><li fid="u9896d520" data-lake-id="ueeb3b838" id="ueeb3b838"><span data-lake-id="uc5f70c1d" id="uc5f70c1d">首先，为抑制颜色过饱和漂移，仅在特定噪声范围</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22t_i%20%5C%5Cin%20%5BS_%7Bt%5C%5Cmin%7D%2C%20S_%7Bt%5C%5Cmax%7D%5D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F098efc9d4003cabea6e9898e51563ed8.svg%22%2C%22id%22%3A%22J4eGq%22%7D"></card><span data-lake-id="u5943cf9a" id="u5943cf9a">内启用随机性；在该范围内，定义</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cgamma_i%20%3D%20%5C%5Cfrac%7BS_%7B%5C%5Ctext%7Bchurn%7D%7D%7D%7BN%7D.%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fc68edae293a344b7d5e58e9f0a499fb2.svg%22%2C%22id%22%3A%22b9hNA%22%7D"></card><span data-lake-id="u77275b08" id="u77275b08">其中</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22S_%7B%5C%5Ctext%7Bchurn%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F35492c6883e0b42035af7fbc487f62a8.svg%22%2C%22id%22%3A%22pTpkA%22%7D"></card><span data-lake-id="ue8259d0f" id="ue8259d0f">控制整体随机性强度</span></li><li fid="u9896d520" data-lake-id="u908608dd" id="u908608dd"><span data-lake-id="uf7e1f40a" id="uf7e1f40a">其次，作者对</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cgamma_i%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fb018fb831eba264933209ea7a442526f.svg%22%2C%22id%22%3A%22KeVNb%22%7D"></card><span data-lake-id="ufe66aa4f" id="ufe66aa4f">进行截断，确保新注入的噪声不会超过图像中已有噪声的水平</span></li><li fid="u9896d520" data-lake-id="ucce9736e" id="ucce9736e"><span data-lake-id="uf192974e" id="uf192974e">作者发现通过将</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22S_%7B%5C%5Ctext%7Bnoise%7D%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Faab1221c3b7ba139faf35205cfe58659.svg%22%2C%22id%22%3A%22vs3Qc%22%7D"></card><span data-lake-id="uafcd0d81" id="uafcd0d81">设为略大于 1，从而适度放大新加入噪声的标准差，可以在一定程度上抵消细节损失</span></li><li fid="u9896d520" data-lake-id="u11b8f61f" id="u11b8f61f"><span data-lake-id="u9e9eb130" id="u9e9eb130">这一现象表明，假设中的非保守性很可能主要体现为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta(x%3B%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F902692a2e69f415041382046efacabb5.svg%22%2C%22id%22%3A%22PTd0b%22%7D"></card><span data-lake-id="u462cb029" id="u462cb029">存在</span><strong><span data-lake-id="u621fc5eb" id="u621fc5eb">去噪过度</span></strong><span data-lake-id="u09ee3aeb" id="u09ee3aeb">的倾向；而这种现象极有可能源于任何基于</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22L_2%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F12ea5d8dd1e9b2b63ca602dd183dde08.svg%22%2C%22id%22%3A%22qVthg%22%7D"></card><span data-lake-id="uf3764fcc" id="uf3764fcc">损失训练的去噪器都容易出现的</span><strong><span data-lake-id="u0b808120" id="u0b808120">向均值回归</span></strong><span data-lake-id="u351818f0" id="u351818f0">问题</span></li></ul><h2 data-lake-id="Z8Obz" id="Z8Obz" style="text-align: center"><span data-lake-id="uc2342378" id="uc2342378">🦔</span><span data-lake-id="u1c610f8c" id="u1c610f8c"> 𝑷𝒓𝒆𝒄𝒐𝒏𝒅𝒊𝒕𝒊𝒐𝒏𝒊𝒏𝒈 𝒂𝒏𝒅 𝒕𝒓𝒂𝒊𝒏𝒊𝒏𝒈</span></h2><p data-lake-id="u8e70d2c5" id="u8e70d2c5"><span data-lake-id="u176e9a37" id="u176e9a37">在监督学习训练神经网络时，已有许多被广泛认可的良好实践。例如，通常建议将输入与输出信号的幅值保持在相对稳定的范围内，如单位方差，并避免不同样本之间梯度幅值出现过大波动。若直接训练神经网络去建模</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F558270b7f0a90c3c286b860273d106a0.svg%22%2C%22id%22%3A%22KGr1Y%22%7D"></card><span data-lake-id="u4369302e" id="u4369302e">，显然并不理想。原因在于，输入</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22x%3Dy%2Bn%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F235828ebb4f0ab8beee01cbd9f37d3cd.svg%22%2C%22id%22%3A%22U73Dr%22%7D"></card><span data-lake-id="ud7e50be3" id="ud7e50be3">由干净信号</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22y%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fbf98c0ddcbe9c1e535f767c78c3aa813.svg%22%2C%22id%22%3A%22a3GYj%22%7D"></card><span data-lake-id="uc3ef5136" id="uc3ef5136">与噪声</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22n%5C%5Csim%5C%5Cmathcal%20N(0%2C%5C%5Csigma%5E2I)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fe91c8cfcde111fb26cfd5764f4d5c2d2.svg%22%2C%22id%22%3A%22yX8pV%22%7D"></card><span data-lake-id="u9eeed52d" id="u9eeed52d">共同构成，其幅值会随着噪声水平</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22RY10w%22%7D"></card><span data-lake-id="u72a50061" id="u72a50061">的变化而发生巨大改变。正因如此，现有方法通常并不直接将</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F3dd6d3deb6c2d585ea87ea1840df81c3.svg%22%2C%22id%22%3A%22UylaD%22%7D"></card><span data-lake-id="u79b77aa4" id="u79b77aa4">表示为神经网络本身，而是转而训练另一个网络</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22F_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F178c3f2a55cee7eeaa0a2462583c326e.svg%22%2C%22id%22%3A%22nZ2M8%22%7D"></card><span data-lake-id="u3a7d0e6c" id="u3a7d0e6c">，再由</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22F_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F178c3f2a55cee7eeaa0a2462583c326e.svg%22%2C%22id%22%3A%22Acwmi%22%7D"></card><span data-lake-id="u810e12c6" id="u810e12c6">构造出</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F3dd6d3deb6c2d585ea87ea1840df81c3.svg%22%2C%22id%22%3A%22j7GMV%22%7D"></card></p><p data-lake-id="u6fd9aba3" id="u6fd9aba3"><span data-lake-id="u65bb9cb4" id="u65bb9cb4">已有方法通过引入依赖于</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22vAP36%22%7D"></card><span data-lake-id="u9602433c" id="u9602433c">的归一化因子来处理输入缩放问题，并尝试通过训练</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22F_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F178c3f2a55cee7eeaa0a2462583c326e.svg%22%2C%22id%22%3A%22W1aN2%22%7D"></card><span data-lake-id="u3b354539" id="u3b354539">去预测经缩放后具有单位方差的噪声</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22n%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdf378375e7693bdcf9535661c023c02e.svg%22%2C%22id%22%3A%22MGUj4%22%7D"></card><span data-lake-id="u0ad9d8ab" id="u0ad9d8ab">来实现输出预条件化，随后再利用</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta(x%3B%5C%5Csigma)%3Dx-%5C%5Csigma%20F_%5C%5Ctheta(%5C%5Ccdot)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6a99e0e1a1210a7a57ad5dea3da81871.svg%22%2C%22id%22%3A%22JipR2%22%7D"></card><span data-lake-id="ue8c10d84" id="ue8c10d84">恢复信号。然而，这种做法存在一个缺点：</span></p><ul list="uaf72aef1"><li fid="u42989c94" data-lake-id="u7099bec8" id="u7099bec8"><span data-lake-id="uda2b42c7" id="uda2b42c7">当</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22g5syY%22%7D"></card><span data-lake-id="ucfa041d6" id="ucfa041d6">较大时，网络必须极为精细地调整其输出，才能恰好抵消已有噪声</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22n%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdf378375e7693bdcf9535661c023c02e.svg%22%2C%22id%22%3A%22wahHl%22%7D"></card><span data-lake-id="u10d8ca99" id="u10d8ca99">，并使输出保持在正确尺度上；需要注意的是，网络产生的任何误差都会被</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22obi8T%22%7D"></card><span data-lake-id="uffcec317" id="uffcec317">放大。在这种情形下，直接预测期望输出</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22D(x%3B%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F8fcf8181157050ce3cd05a2fbc9f1bd0.svg%22%2C%22id%22%3A%22kgx6w%22%7D"></card><span data-lake-id="ucfdcf278" id="ucfdcf278">似乎会更容易</span></li></ul><p data-lake-id="ue2db4d5e" id="ue2db4d5e"><span data-lake-id="u568f150f" id="u568f150f">延续以往参数化方法中自适应混合信号与噪声的思想，提出利用一个依赖于</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22C2Jyu%22%7D"></card><span data-lake-id="u040ee034" id="u040ee034">的 skip connection 对神经网络进行预条件化，使其既可以估计</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22y%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fbf98c0ddcbe9c1e535f767c78c3aa813.svg%22%2C%22id%22%3A%22qthUV%22%7D"></card><span data-lake-id="ue5f9eeae" id="ue5f9eeae">，也可以估计 </span><card type="inline" name="math" value="data:%7B%22code%22%3A%22n%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fdf378375e7693bdcf9535661c023c02e.svg%22%2C%22id%22%3A%22ny9Er%22%7D"></card><span data-lake-id="uec0f0d1c" id="uec0f0d1c">，或者估计二者之间的某种中间形式</span></p><p data-lake-id="u19ca86c6" id="u19ca86c6" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22D_%5C%5Ctheta(x%3B%5C%5Csigma)%3Dc_%7B%5C%5Ctext%7Bskip%7D%7D(%5C%5Csigma)x%2Bc_%7B%5C%5Ctext%7Bout%7D%7D(%5C%5Csigma)%5C%5C%2C%20F_%5C%5Ctheta%5C%5C!%5C%5Cbig(c_%7B%5C%5Ctext%7Bin%7D%7D(%5C%5Csigma)x%3B%5C%5C%2Cc_%7B%5C%5Ctext%7Bnoise%7D%7D(%5C%5Csigma)%5C%5Cbig)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F8152ff8803da1159219df4cbeea3e967.svg%22%2C%22id%22%3A%22RVjAo%22%7D"></card></p><p data-lake-id="u4892e7d0" id="u4892e7d0"><span data-lake-id="u3e257169" id="u3e257169">其中</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22F_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F178c3f2a55cee7eeaa0a2462583c326e.svg%22%2C%22id%22%3A%22t85PQ%22%7D"></card><span data-lake-id="u7e6e86de" id="u7e6e86de">是待训练的神经网络，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22c_%7B%5C%5Ctext%7Bskip%7D%7D(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fd1b3b09d758c9306b13e1a02453394b9.svg%22%2C%22id%22%3A%22khAiA%22%7D"></card><span data-lake-id="uf3b8e6a5" id="uf3b8e6a5">用于调节 skip connection，</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22c_%7B%5C%5Ctext%7Bin%7D%7D(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F234570a8046644b5dfb453d9d620f7bb.svg%22%2C%22id%22%3A%22vbz8S%22%7D"></card><span data-lake-id="ucaa4bcab" id="ucaa4bcab">与</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22c_%7B%5C%5Ctext%7Bout%7D%7D(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F52e97c2cce2b3b7cc1c5f609f1a7f06e.svg%22%2C%22id%22%3A%22uaiIT%22%7D"></card><span data-lake-id="u4fa675b5" id="u4fa675b5">分别控制输入与输出的幅值缩放，而</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22c_%7B%5C%5Ctext%7Bnoise%7D%7D(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Fa575295721aa5c669decbc63dbd2873e.svg%22%2C%22id%22%3A%22Bjq1u%22%7D"></card><span data-lake-id="u24f6fe13" id="u24f6fe13">则负责将噪声水平</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22X7xis%22%7D"></card><span data-lake-id="ud300b175" id="ud300b175">映射为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22F_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F178c3f2a55cee7eeaa0a2462583c326e.svg%22%2C%22id%22%3A%22SC1LT%22%7D"></card><span data-lake-id="u753b0077" id="u753b0077">的条件输入。整体训练损失如下</span></p><p data-lake-id="ue3c6a1b3" id="ue3c6a1b3" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cboxed%7B%20%5C%5Cmathbb%7BE%7D_%7B%5C%5Csigma%2C%20%5C%5Cboldsymbol%7By%7D%2C%20%5C%5Cboldsymbol%7Bn%7D%7D%20%5C%5Cleft%5B%20%5C%5Clambda(%5C%5Csigma)%20%5C%5C%7C%20D(%5C%5Cboldsymbol%7By%7D%20%2B%20%5C%5Cboldsymbol%7Bn%7D%3B%20%5C%5Csigma)%20-%20%5C%5Cboldsymbol%7By%7D%20%5C%5C%7C_2%5E2%20%5C%5Cright%5D%2C%20%5C%5Ctext%7B%20where%20%7D%20%5C%5Csigma%20%5C%5Csim%20p_%7B%5C%5Ctext%7Btrain%7D%7D%2C%20%5C%5Cboldsymbol%7By%7D%20%5C%5Csim%20p_%7B%5C%5Ctext%7Bdata%7D%7D%2C%20%5C%5Ctext%7B%20and%20%7D%20%5C%5Cboldsymbol%7Bn%7D%20%5C%5Csim%20%5C%5Cmathcal%7BN%7D(%5C%5Cmathbf%7B0%7D%2C%20%5C%5Csigma%5E2%20%5C%5Cmathbf%7BI%7D)%20%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F5500d5322a2b8e7b91bc3dc8e243a316.svg%22%2C%22id%22%3A%22NsuCA%22%7D"></card></p><p data-lake-id="uc8bc91dc" id="uc8bc91dc"><span data-lake-id="ue5720dd9" id="ue5720dd9">给定噪声水平</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22q6hRT%22%7D"></card><span data-lake-id="ube043f40" id="ube043f40">被采样到的概率由</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22p_%7B%5C%5Ctext%7Btrain%7D%7D(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9c187910beff9420c951178fbdfd35f3.svg%22%2C%22id%22%3A%22fPgel%22%7D"></card><span data-lake-id="ub7e6633e" id="ub7e6633e">决定，相应的损失权重由</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Clambda(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F85796c9caf45cfd787690a300c39e260.svg%22%2C%22id%22%3A%22rkmMH%22%7D"></card><span data-lake-id="u4b3124d8" id="u4b3124d8">决定。进一步将该损失改写为关于原始网络输出</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22F_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F178c3f2a55cee7eeaa0a2462583c326e.svg%22%2C%22id%22%3A%22s1u0s%22%7D"></card><span data-lake-id="u423f51b0" id="u423f51b0">的形式</span></p><p data-lake-id="uf29ec7cf" id="uf29ec7cf" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cboxed%7B%20%5C%5Cmathbb%7BE%7D_%7B%5C%5Csigma%2C%20%5C%5Cboldsymbol%7By%7D%2C%20%5C%5Cboldsymbol%7Bn%7D%7D%20%5C%5Cleft%5B%20%5C%5Cunderbrace%7B%5C%5Clambda(%5C%5Csigma)%20c_%7B%5C%5Ctext%7Bout%7D%7D(%5C%5Csigma)%5E2%7D_%7B%5C%5Ctext%7Beffective%20weight%7D%7D%20%5C%5Cbigg%5C%5C%7C%20%5C%5Cunderbrace%7BF_%5C%5Ctheta(c_%7B%5C%5Ctext%7Bin%7D%7D(%5C%5Csigma)%20%5C%5Ccdot%20(%5C%5Cboldsymbol%7By%7D%20%2B%20%5C%5Cboldsymbol%7Bn%7D)%3B%20c_%7B%5C%5Ctext%7Bnoise%7D%7D(%5C%5Csigma))%7D_%7B%5C%5Ctext%7Bnetwork%20output%7D%7D%20-%20%5C%5Cunderbrace%7B%5C%5Cfrac%7B1%7D%7Bc_%7B%5C%5Ctext%7Bout%7D%7D(%5C%5Csigma)%7D%20(%5C%5Cboldsymbol%7By%7D%20-%20c_%7B%5C%5Ctext%7Bskip%7D%7D(%5C%5Csigma)%20%5C%5Ccdot%20(%5C%5Cboldsymbol%7By%7D%20%2B%20%5C%5Cboldsymbol%7Bn%7D))%7D_%7B%5C%5Ctext%7Beffective%20training%20target%7D%7D%20%5C%5Cbigg%5C%5C%7C_2%5E2%20%5C%5Cright%5D%20%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F0d7b70699e8cfb1e045433c820989267.svg%22%2C%22id%22%3A%22qdeA5%22%7D"></card></p><p data-lake-id="u67e50801" id="u67e50801"><span data-lake-id="u91db0661" id="u91db0661">损失加权与噪声采样：在预条件化形式下训练</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22F_%5C%5Ctheta%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F178c3f2a55cee7eeaa0a2462583c326e.svg%22%2C%22id%22%3A%22yPHta%22%7D"></card><span data-lake-id="u64ecaa67" id="u64ecaa67">时，每个样本实际承担的损失权重为</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Clambda(%5C%5Csigma)c_%7B%5C%5Ctext%7Bout%7D%7D(%5C%5Csigma)%5E2%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Feb28594512ee67467e54ea61d94cabac.svg%22%2C%22id%22%3A%22E56s6%22%7D"></card><span data-lake-id="u20fc7642" id="u20fc7642">。为平衡这一有效损失权重，作者取</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Clambda(%5C%5Csigma)%20%3D%201%20%2F%20c_%7B%5C%5Ctext%7Bout%7D%7D(%5C%5Csigma)%5E2%20.%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6a88422b79f1afcd3b2b44a06f698886.svg%22%2C%22id%22%3A%22K69Uw%22%7D"></card><span data-lake-id="ub9c48a9b" id="ub9c48a9b">这一选择也使得整个</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22ICcdO%22%7D"></card><span data-lake-id="u868495fd" id="u868495fd">范围内初始训练损失趋于均衡。最后，还需要确定</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22p_%7B%5C%5Ctext%7Btrain%7D%7D(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9c187910beff9420c951178fbdfd35f3.svg%22%2C%22id%22%3A%22OF9n4%22%7D"></card><span data-lake-id="u0fa7f405" id="u0fa7f405">，即训练过程中噪声水平的采样方式。作者通过考察训练结束后不同</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Csigma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F788df1ba344b3092def7590d1be6b4d4.svg%22%2C%22id%22%3A%22KEv6z%22%7D"></card><span data-lake-id="uddd61bf2" id="uddd61bf2">下的损失发现，显著的损失下降主要出现在中等噪声水平；在极低噪声水平下，噪声成分极其微弱，既难以辨别，也缺乏实际意义；而在高噪声水平下，训练目标与趋近于数据集平均值的正确答案始终存在明显偏差。因此，作者采用一个简单的</span><strong><span data-lake-id="u784ba707" id="u784ba707">对数正态分布</span></strong><span data-lake-id="u912a6893" id="u912a6893">来定义</span><card type="inline" name="math" value="data:%7B%22code%22%3A%22p_%7B%5C%5Ctext%7Btrain%7D%7D(%5C%5Csigma)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F9c187910beff9420c951178fbdfd35f3.svg%22%2C%22id%22%3A%22LlabU%22%7D"></card><span data-lake-id="u0c4b4de3" id="u0c4b4de3">，从而将训练资源集中于真正重要的噪声区间</span></p><p data-lake-id="u9c9e0b3e" id="u9c9e0b3e" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F38583525%2F1775995804921-905dd684-dfef-4dbc-a9d7-c4fbff16bf81.png%22%2C%22taskId%22%3A%22ua5db1d89-918b-42cc-9d56-580fdbaa459%22%2C%22clientId%22%3A%22ud5036ae0-c0cd-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A725.8182373046875%2C%22height%22%3A432%2C%22linkTarget%22%3A%22_blank%22%2C%22na