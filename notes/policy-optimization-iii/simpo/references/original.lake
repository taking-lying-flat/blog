O%22%2C%22x%22%3A11%2C%22y%22%3A568%2C%22width%22%3A67%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22%E5%85%83REF(YAUSR%22%2C%22x%22%3A303%2C%22y%22%3A519%2C%22width%22%3A104%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22OBJECTIVE%22%2C%22x%22%3A172%2C%22y%22%3A10%2C%22width%22%3A93%2C%22height%22%3A20%7D%2C%7B%22text%22%3A%22RRHF%5B91%5D%22%2C%22x%22%3A12%2C%22y%22%3A54%2C%22width%22%3A106%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22MAX(0%2C%22%2C%22x%22%3A169%2C%22y%22%3A55%2C%22width%22%3A84%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%22IPO%5B6%5D%22%2C%22x%22%3A11%2C%22y%22%3A229%2C%22width%22%3A76%2C%22height%22%3A24%7D%2C%7B%22text%22%3A%22CPO%5B88%5D%22%2C%22x%22%3A11%2C%22y%22%3A276%2C%22width%22%3A91%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%221%E4%B8%80PE(912)%22%2C%22x%22%3A635%2C%22y%22%3A419%2C%22width%22%3A98%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%221OOE92%22%2C%22x%22%3A435%2C%22y%22%3A503%2C%22width%22%3A125%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22REF(GL)%22%2C%22x%22%3A483%2C%22y%22%3A521%2C%22width%22%3A79%2C%22height%22%3A14%7D%2C%7B%22text%22%3A%22METHO%22%2C%22x%22%3A17%2C%22y%22%3A11%2C%22width%22%3A66%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22WPSMRER(YAUA)ETE%22%2C%22x%22%3A177%2C%22y%22%3A337%2C%22width%22%3A292%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%221OGTE(3-%22%2C%22x%22%3A484%2C%22y%22%3A570%2C%22width%22%3A169%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%225B1-P8(YU0)%22%2C%22x%22%3A350%2C%22y%22%3A419%2C%22width%22%3A238%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22PE(G%E4%BC%81)%22%2C%22x%22%3A627%2C%22y%22%3A402%2C%22width%22%3A100%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%225RE(GU)%22%2C%22x%22%3A265%2C%22y%22%3A188%2C%22width%22%3A141%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22%E4%B8%801OG0%22%2C%22x%22%3A171%2C%22y%22%3A506%2C%22width%22%3A87%2C%22height%22%3A22%7D%2C%7B%22text%22%3A%22%E4%B8%80%E5%8D%96%22%2C%22x%22%3A446%2C%22y%22%3A227%2C%22width%22%3A76%2C%22height%22%3A34%7D%2C%7B%22text%22%3A%22(AY%22%2C%22x%22%3A587%2C%22y%22%3A508%2C%22width%22%3A63%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22QG9)%22%2C%22x%22%3A679%2C%22y%22%3A506%2C%22width%22%3A66%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%2210G%22%2C%22x%22%3A458%2C%22y%22%3A406%2C%22width%22%3A230%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%221T%22%2C%22x%22%3A267%2C%22y%22%3A65%2C%22width%22%3A53%2C%22height%22%3A22%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23eeeeee%22%2C%22id%22%3A%22uecd2cdb1%22%7D"></card></p><p data-lake-id="u11a07c09" id="u11a07c09"><strong><span data-lake-id="u3d26db4b" id="u3d26db4b">目标奖励间隔：在 Bradley–Terry 目标中引入目标奖励间隔项</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cgamma%3E0%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F8feaa5628f7ccd6f410a7a1bf16ce038.svg%22%2C%22id%22%3A%22u3lAn%22%7D"></card><strong><span data-lake-id="u2fee2151" id="u2fee2151">，以确保偏好回答的奖励</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22r(x%2Cy_w)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F6d3fb8e941efc857415f81c9dfc40fa5.svg%22%2C%22id%22%3A%22l1WZI%22%7D"></card><strong><span data-lake-id="uad7697d6" id="uad7697d6">至少比非偏好回答的奖励</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22r(x%2Cy_l)%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ff4ac8ff4e4aa2da6b44ea0fce8b6804d.svg%22%2C%22id%22%3A%22lWue6%22%7D"></card><strong><span data-lake-id="u77dfb5cf" id="u77dfb5cf">高出</span></strong><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cgamma%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F4aa418d6f0b6fbada90489b4374752e5.svg%22%2C%22id%22%3A%22w1gV6%22%7D"></card></p><p data-lake-id="ua3cbb41e" id="ua3cbb41e" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22p(y_w%5C%5Csucc%20y_l%5C%5Cmid%20x)%3D%5C%5Csigma%5C%5Cleft(r(x%2Cy_w)-r(x%2Cy_l)-%5C%5Cgamma%5C%5Cright).%5Cn%5C%5Ctag%7B5%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2Ffe5a7b57e836f48cebc202f0f5cd18cf.svg%22%2C%22id%22%3A%22m1aAb%22%7D"></card></p><ul list="uc79c9124"><li fid="u2fa7fd4b" data-lake-id="u58c700ae" id="u58c700ae"><span data-lake-id="ub84c5022" id="ub84c5022">两个类别之间的间隔会影响分类器的泛化能力。在采用随机模型初始化的标准训练设置中，增大目标间隔通常能够改善泛化性能</span></li><li fid="u2fa7fd4b" data-lake-id="u98934017" id="u98934017"><span data-lake-id="u9ac804a4" id="u9ac804a4">在偏好优化中，这两个类别分别对应同一输入下的偏好回答和非偏好回答。随着目标间隔增大，生成质量最初会有所提升，但当间隔过大时，生成质量反而会下降</span></li></ul><p data-lake-id="u3f3c1f22" id="u3f3c1f22"><strong><span data-lake-id="ucf322879" id="ucf322879">SimPO 采用一种与生成指标直接保持一致的隐式奖励形式，从而无需参考模型。此外，SimPO 还引入目标奖励间隔，以帮助区分偏好回答与非偏好回答</span></strong></p><p data-lake-id="u52177d1b" id="u52177d1b" style="text-align: center"><card type="inline" name="math" value="data:%7B%22code%22%3A%22%5C%5Cmathcal%7BL%7D_%7B%5C%5Cmathrm%7BSimPO%7D%7D(%5C%5Cpi_%5C%5Ctheta)%3D-%5C%5Cmathbb%7BE%7D_%7B(x%2Cy_w%2Cy_l)%5C%5Csim%5C%5Cmathcal%7BD%7D%7D%5C%5Cleft%5B%5C%5Clog%5C%5Csigma%5C%5Cleft(%5C%5Cfrac%7B%5C%5Cbeta%7D%7B%7Cy_w%7C%7D%5C%5Clog%5C%5Cpi_%5C%5Ctheta(y_w%5C%5Cmid%20x)-%5C%5Cfrac%7B%5C%5Cbeta%7D%7B%7Cy_l%7C%7D%5C%5Clog%5C%5Cpi_%5C%5Ctheta(y_l%5C%5Cmid%20x)-%5C%5Cgamma%5C%5Cright)%5C%5Cright%5D.%5Cn%5C%5Ctag%7B6%7D%22%2C%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F__latex%2F743db728c880a215fa50c482e8837b84.svg%22%2C%22id%22%3A%22VdLg9%22%7D"></card></p><p data-lake-id="u727e1e17" id="u727e1e17" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F38583525%2F1755432972764-1f2978f5-9e2a-4c19-afaf-961266d9701b.png%22%2C%22taskId%22%3A%22ua0a0f430-8f66-470a-8223-081714d6755%22%2C%22clientId%22%3A%22u4236845b-cb6b-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A816.7272727272727%2C%22height%22%3A488%2C%22linkTarget%22%3A%22_blank%22%2C%22name%