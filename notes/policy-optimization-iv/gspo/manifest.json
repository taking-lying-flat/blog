      "value": {
        "code": "\\begin{aligned}\n\\nabla_\\theta\\mathcal{J}_{\\text{GSPO-token}}(\\theta)&=\\nabla_\\theta\\mathbb{E}_{x\\sim\\mathcal{D},\\,\\{y_i\\}_{i=1}^{G}\\sim\\pi_{\\theta_{\\mathrm{old}}}(\\cdot\\mid x)}\\left[\\frac{1}{G}\\sum_{i=1}^{G}\\frac{1}{|y_i|}\\sum_{t=1}^{|y_i|}s_{i,t}(\\theta)\\hat{A}_{i,t}\\right] &\\qquad\\text{(15)}\\\\\n&=\\mathbb{E}_{x\\sim\\mathcal{D},\\,\\{y_i\\}_{i=1}^{G}\\sim\\pi_{\\theta_{\\mathrm{old}}}(\\cdot\\mid x)}\\left[\\frac{1}{G}\\sum_{i=1}^{G}s_i(\\theta)\\cdot\\frac{1}{|y_i|}\\sum_{t=1}^{|y_i|}\\hat{A}_{i,t}\\frac{\\nabla_\\theta\\pi_\\theta(y_{i,t}\\mid x,y_{i,<t})}{\\pi_\\theta(y_{i,t}\\mid x,y_{i,<t})}\\right] &\\qquad\\text{(16)}\\\\\n&=\\mathbb{E}_{x\\sim\\mathcal{D},\\,\\{y_i\\}_{i=1}^{G}\\sim\\pi_{\\theta_{\\mathrm{old}}}(\\cdot\\mid x)}\\left[\\frac{1}{G}\\sum_{i=1}^{G}\\left(\\frac{\\pi_\\theta(y_i\\mid x)}{\\pi_{\\theta_{\\mathrm{old}}}(y_i\\mid x)}\\right)^{\\frac{1}{|y_i|}}\\cdot\\frac{1}{|y_i|}\\sum_{t=1}^{|y_i|}\\hat{A}_{i,t}\\nabla_\\theta\\log\\pi_\\theta(y_{i,t}\\mid x,y_{i,<t})\\right]. &\\\\[-0.3em]\n&&\\text{(17)}\n\\end{aligned}",
