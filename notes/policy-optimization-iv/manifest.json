      },
      "value": {
        "code": "\\begin{aligned}\n\\mathcal{J}_{\\mathrm{PPO}}(\\theta)&=\\mathbb{E}_{(q,a)\\sim\\mathcal{D},\\,o_{\\leq t}\\sim\\pi_{\\theta_{\\mathrm{old}}}(\\cdot\\mid q)}\\\\\n&\\left[\\min\\left(\\frac{\\pi_\\theta(o_t\\mid q,o_{<t})}{\\pi_{\\theta_{\\mathrm{old}}}(o_t\\mid q,o_{<t})}\\hat{A}_t,\\;\\operatorname{clip}\\left(\\frac{\\pi_\\theta(o_t\\mid q,o_{<t})}{\\pi_{\\theta_{\\mathrm{old}}}(o_t\\mid q,o_{<t})},1-\\varepsilon,1+\\varepsilon\\right)\\hat{A}_t\\right)\\right],\n\\end{aligned}\n\\tag{1}",
        "src": "https://cdn.nlark.com/yuque/__latex/1ba3c9a72579ca7e29aec3b71fc4bf61.svg",
        "id": "K6OXI"
