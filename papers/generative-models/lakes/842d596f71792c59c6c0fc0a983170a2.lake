"><card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-120%22%2C%22code%22%3A%22%5B1-r(x_0%2Cc)%5D%5C%5Cpi_%7B0%5C%5Cmid%20t%7D%5E%7B%5C%5Cmathrm%7Bold%7D%7D(x_0%5C%5Cmid%20x_t%2Cc)%5Cn%3D%5B1-%5C%5Calpha(x_t)%5D%5C%5Cpi_%7B0%5C%5Cmid%20t%7D%5E-(x_0%5C%5Cmid%20x_t%2Cc).%5C%5Ctag%7BA.15%7D%5Cn%22%7D"></card></div>
