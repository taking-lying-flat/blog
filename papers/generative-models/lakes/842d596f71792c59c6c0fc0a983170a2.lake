<div id="nft-equation-a16" class="equation" tabindex="0" role="math" aria-label="\begin{aligned}
\mathcal L(\theta)
&amp;=\mathbb E_{c,t,\,\pi_t^{\mathrm{old}}(x_t\mid c)}
\Bigl\{\alpha(x_t)\mathbb E_{\pi_{0\mid t}^+(x_0\mid x_t,c)}\|v_\theta^+(x_t,c,t)-v\|_2^2+[1-\alpha(x_t)]\mathbb E_{\pi_{0\mid t}^-(x_0\mid x_t,c)}\|v_\theta^-(x_t,c,t)-v\|_2^2\Bigr\}\\[5pt]
&amp;=\mathbb E_{c,t,\,\pi_t^{\mathrm{old}}(x_t\mid c)}
\Bigl\{\alpha(x_t)\bigl\|v_\theta^+(x_t,c,t)-\mathbb E_{\pi_{0\mid t}^+(x_0\mid x_t,c)}[v]\bigr\|_2^2+[1-\alpha(x_t)]\bigl\|v_\theta^-(x_t,c,t)-\mathbb E_{\pi_{0\mid t}^-(x_0\mid x_t,c)}[v]\bigr\|_2^2\Bigr\}+C_1\\[5pt]
&amp;=\mathbb E_{c,t,\,\pi_t^{\mathrm{old}}(x_t\mid c)}
\Bigl\{\alpha(x_t)\|v_\theta^+(x_t,c,t)-v^+(x_t,c,t)\|_2^2+[1-\alpha(x_t)]\|v_\theta^-(x_t,c,t)-v^-(x_t,c,t)\|_2^2\Bigr\}+C_1.
\end{aligned}\tag{A.16}
"><card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-121%22%2C%22code%22%3A%22%5C%5Cbegin%7Baligned%7D%5Cn%5C%5Cmathcal%20L(%5C%5Ctheta)%5Cn%26%3D%5C%5Cmathbb%20E_%7Bc%2Ct%2C%5C%5C%2C%5C%5Cpi_t%5E%7B%5C%5Cmathrm%7Bold%7D%7D(x_t%5C%5Cmid%20c)%7D%5Cn%5C%5CBigl%5C%5C%7B%5C%5Calpha(x_t)%5C%5Cmathbb%20E_%7B%5C%5Cpi_%7B0%5C%5Cmid%20t%7D%5E%2B(x_0%5C%5Cmid%20x_t%2Cc)%7D%5C%5C%7Cv_%5C%5Ctheta%5E%2B(x_t%2Cc%2Ct)-v%5C%5C%7C_2%5E2%2B%5B1-%5C%5Calpha(x_t)%5D%5C%5Cmathbb%20E_%7B%5C%5Cpi_%7B0%5C%5Cmid%20t%7D%5E-(x_0%5C%5Cmid%20x_t%2Cc)%7D%5C%5C%7Cv_%5C%5Ctheta%5E-(x_t%2Cc%2Ct)-v%5C%5C%7C_2%5E2%5C%5CBigr%5C%5C%7D%5C%5C%5C%5C%5B5pt%5D%5Cn%26%3D%5C%5Cmathbb%20E_%7Bc%2Ct%2C%5C%5C%2C%5C%5Cpi_t%5E%7B%5C%5Cmathrm%7Bold%7D%7D(x_t%5C%5Cmid%20c)%7D%5Cn%5C%5CBigl%5C%5C%7B%5C%5Calpha(x_t)%5C%5Cbigl%5C%5C%7Cv_%5C%5Ctheta%5E%2B(x_t%2Cc%2Ct)-%5C%5Cmathbb%20E_%7B%5C%5Cpi_%7B0%5C%5Cmid%20t%7D%5E%2B(x_0%5C%5Cmid%20x_t%2Cc)%7D%5Bv%5D%5C%5Cbigr%5C%5C%7C_2%5E2%2B%5B1-%5C%5Calpha(x_t)%5D%5C%5Cbigl%5C%5C%7Cv_%5C%5Ctheta%5E-(x_t%2Cc%2Ct)-%5C%5Cmathbb%20E_%7B%5C%5Cpi_%7B0%5C%5Cmid%20t%7D%5E-(x_0%5C%5Cmid%20x_t%2Cc)%7D%5Bv%5D%5C%5Cbigr%5C%5C%7C_2%5E2%5C%5CBigr%5C%5C%7D%2BC_1%5C%5C%5C%5C%5B5pt%5D%5Cn%26%3D%5C%5Cmathbb%20E_%7Bc%2Ct%2C%5C%5C%2C%5C%5Cpi_t%5E%7B%5C%5Cmathrm%7Bold%7D%7D(x_t%5C%5Cmid%20c)%7D%5Cn%5C%5CBigl%5C%5C%7B%5C%5Calpha(x_t)%5C%5C%7Cv_%5C%5Ctheta%5E%2B(x_t%2Cc%2Ct)-v%5E%2B(x_t%2Cc%2Ct)%5C%5C%7C_2%5E2%2B%5B1-%5C%5Calpha(x_t)%5D%5C%5C%7Cv_%5C%5Ctheta%5E-(x_t%2Cc%2Ct)-v%5E-(x_t%2Cc%2Ct)%5C%5C%7C_2%5E2%5C%5CBigr%5C%5C%7D%2BC_1.%5Cn%5C%5Cend%7Baligned%7D%5C%5Ctag%7BA.16%7D%5Cn%22%7D"></card></div>
