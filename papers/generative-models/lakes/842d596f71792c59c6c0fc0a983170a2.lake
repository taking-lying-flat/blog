ld%7D%7D%2B%5C%5Cfrac2%5C%5Cbeta%5C%5CDelta%5C%5Cright)%5C%5Cright%5C%5C%7C_2%5E2%2BC_2.%5Cn%5C%5Cend%7Baligned%7D%5C%5Ctag%7BA.18%7D%5Cn%22%7D"></card></div>
