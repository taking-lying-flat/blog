<div class="equation" tabindex="0" role="math" aria-label="\begin{aligned}
v_\theta^+(x_t,c,t)-v^+(x_t,c,t)
&amp;=(1-\beta)v^{\mathrm{old}}(x_t,c,t)+\beta v_\theta(x_t,c,t)-v^+(x_t,c,t)=\beta\left[v_\theta-v^{\mathrm{old}}-\frac1\beta\frac{\Delta}{\alpha(x_t)}\right],\\[8pt]
v_\theta^-(x_t,c,t)-v^-(x_t,c,t)
&amp;=(1+\beta)v^{\mathrm{old}}(x_t,c,t)-\beta v_\theta(x_t,c,t)-v^-(x_t,c,t)=-\beta\left[v_\theta-v^{\mathrm{old}}-\frac1\beta\frac{\Delta}{1-\alpha(x_t)}\right].
\end{aligned}\tag{A.17}
"><card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-125%22%2C%22code%22%3A%22%5C%5Cbegin%7Baligned%7D%5Cnv_%5C%5Ctheta%5E%2B%28x_t%2Cc%2Ct%29-v%5E%2B%28x_t%2Cc%2Ct%29%5Cn%26%3D%281-%5C%5Cbeta%29v%5E%7B%5C%5Cmathrm%7Bold%7D%7D%28x_t%2Cc%2Ct%29%2B%5C%5Cbeta%20v_%5C%5Ctheta%28x_t%2Cc%2Ct%29-v%5E%2B%28x_t%2Cc%2Ct%29%3D%5C%5Cbeta%5C%5Cleft%5Bv_%5C%5Ctheta-v%5E%7B%5C%5Cmathrm%7Bold%7D%7D-%5C%5Cfrac1%5C%5Cbeta%5C%5Cfrac%7B%5C%5CDelta%7D%7B%5C%5Calpha%28x_t%29%7D%5C%5Cright%5D%2C%5C%5C%5C%5C%5B8pt%5D%5Cnv_%5C%5Ctheta%5E-%28x_t%2Cc%2Ct%29-v%5E-%28x_t%2Cc%2Ct%29%5Cn%26%3D%281%2B%5C%5Cbeta%29v%5E%7B%5C%5Cmathrm%7Bold%7D%7D%28x_t%2Cc%2Ct%29-%5C%5Cbeta%20v_%5C%5Ctheta%28x_t%2Cc%2Ct%29-v%5E-%28x_t%2Cc%2Ct%29%3D-%5C%5Cbeta%5C%5Cleft%5Bv_%5C%5Ctheta-v%5E%7B%5C%5Cmathrm%7Bold%7D%7D-%5C%5Cfrac1%5C%5Cbeta%5C%5Cfrac%7B%5C%5CDelta%7D%7B1-%5C%5Calpha%28x_t%29%7D%5C%5Cright%5D.%5Cn%5C%5Cend%7Baligned%7D%5C%5Ctag%7BA.17%7D%5Cn%22%7D"></card></div>
<ul>
<li>设<card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-126%22%2C%22code%22%3A%220%3C%5C%5Calpha(x_t)%3C1%22%7D"></card>，省略<card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-127%22%2C%22code%22%3A%22v_%5C%5Ctheta%22%7D"></card>、<card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-128%22%2C%22code%22%3A%22v%5E%7B%5C%5Cmathrm%7Bold%7D%7D%22%7D"></card>与<card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-129%22%2C%22code%22%3A%22%5C%5CDelta%22%7D"></card>共同的输入<card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-130%22%2C%22code%22%3A%22(x_t%2Cc%2Ct)%22%7D"></card>。将两项误差代回<card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-131%22%2C%22code%22%3A%22%5C%5Cmathcal%20L(%5C%5Ctheta)%22%7D"></card>，提取<card type="inline" name="math" value="data:%7B%22id%22%3A%22generated-genai-132%22%2C%22code%22%3A%22%5C%5Cbeta%5E2%22%7D"></card>，合并两个加权平方项</li>
</ul>
<div id="nft-equation-a18" class="equation" tabindex="0" role="math" aria-label="\begin{aligned}
\mathcal L(\theta)
&amp;=\mathbb E_{c,t,\,\pi_t^{\mathrm{old}}(x_t\mid c)}
\Biggl\{\alpha(x_t)\beta^2\left\|v_\theta-v^{\mathrm{old}}-\frac{\Delta}{\beta\alpha(x_t)}\right\|_2^2+[1-\alpha(x_t)]\beta^2\left\|v_\theta-v^{\mathrm{old}}-\frac{\Delta}{\beta[1-\alpha(x_t)]}\right\|_2^2\Biggr\}+C_1\\[5pt]
&amp;=\beta^2\mathbb E_{c,t,\,\pi_t^{\mathrm{old}}(x_t\mid c)}
\Biggl\{\alpha(x_t)\left\|v_\theta-\left(v^{\mathrm{old}}+\frac{\Delta}{\beta\alpha(x_t)}\right)\right\|_2^2+[1-\alpha(x_t)]\left\|v_\theta-\left(v^{\mathrm{old}}+\frac{\Delta}{\beta[1-\alpha(x_t)]}\right)\right\|_2^2\Biggr\}+C_1\\[5pt]
&amp;=\beta^2\mathbb E_{c,t,\,\pi_t^{\mathrm{old}}(x_t\mid c)}
\left\|v_\theta-\alpha(x_t)\left(v^{\mathrm{old}}+\frac{\Delta}{\beta\alpha(x_t)}\right)-[1-\alpha(x_t)]\left(v^{\mathrm{old}}+\frac{\Delta}{\beta[1-\alpha(x_t)]}\right)\right\|_2^2+C_2\\[5pt]
&amp;=\beta^2\mathbb E_{c,t,\,\pi_t^{\mathrm{old}}(x_t\mid c)}
\left\|v_\theta-\left(v^{\mathrm{old}}+\frac2\beta\Delta\right)\right\|_2^2+C_2.
\end{aligned}\tag{A.18}
